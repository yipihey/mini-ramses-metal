module gpu_utils
  use amr_parameters, only: dp, twotondim, ndim
  use oct_commons, only: oct
  use cudafor
  implicit none

  integer, parameter :: nthreads_y = 16

  integer, parameter :: nsubgrid = 1
  integer, parameter :: nsubgridsq = nsubgrid**2
  integer, parameter :: nsubgridtondim = nsubgrid**ndim
  integer, parameter :: nsubgridp2 = nsubgrid+2
  integer, parameter :: nsubgridp2sq = nsubgridp2**2
  integer, parameter :: subgridsize = nsubgridp2**ndim

  logical :: gpu_debug = .false.

  !> @brief
  !> Contains a 6 by 6 by 6 subgrid of primitive variables. Intended to act as a subgrid
  !> where the inner 2 by 2 by 2 cells are "real" and the outer 2 cells are ghost/halo cells.
  !> Can either be used on it's own or allocated in shared memory. Note that it is zero
  !> indexed to make 1D to 3D indexing easier.
  !> Under MHD the cell-centred magnetic field is NOT stored: every consumer
  !> recomputes it as 0.5*(bf_low + bf_high) from the shared face-B buffer
  !> (bitwise equal to the CPU ctoprim cell-centring because the two stored
  !> copies of each face are maintained bitwise identical -- the face-B
  !> redundancy invariant). Under MHD `refined` is also stored byte-wide and
  !> only on the consumed [1, 2*nsubgrid+2]^3 lattice (zero_fine_fluxes /
  !> zero_fine_emf read nothing outside it) -- both are shared-memory
  !> occupancy savings for the MHD integrator kernel.
  type, public :: subgrid_6x6x6cell_primitive
     ! P0 bank-conflict fix: leading (stride-1) dimension padded +1 (6->7 at
     ! nsubgrid=1). gcd(7,32)=1 makes the j/k strides span all 32 shared banks,
     ! and the 252-real per-field slab stride no longer aliases density..pressure
     ! (was 216 == 0 mod 32). Index slot i=2*nsubgrid+4 is padding, never read.
     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: density
     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_x
     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_y
     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_z
     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: pressure
#ifdef MHD
     logical(kind=1), dimension(1:2*nsubgrid+2, 1:2*nsubgrid+2, 1:2*nsubgrid+2) :: refined
#else
     logical      , dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: refined
#endif
  end type subgrid_6x6x6cell_primitive

  !> @brief
  !> Contains a 6 by 6 by 6 subgrid of conserved variables. Intended to act as a subgrid
  !> where the inner 2 by 2 by 2 cells are "real" and the outer 2 cells are ghost/halo cells.
  !> Can either but used on it's own or allocated in shared memory. Note that it is zero
  !> indexed to make 1D to 3D indexing easier
  type, public :: subgrid_6x6x6cell_conserved
     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: density
     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: momentum_x
     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: momentum_y
     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: momentum_z
     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: energy
  end type subgrid_6x6x6cell_conserved

contains
  ! ==========================================================================
  !> @brief
  !> Checks for any CUDA errors. Includes a `cudaDeviceSynchronize` which is
  !> where it gets the error code. This synchronization, and error checking
  !> in its entirety, can be disabled by compiling with the
  !> DISABLE_GPU_ERROR_CHECKING flag.
  !>
  !> @param[in] file_name : The name of the file that the check is in, intended
  !> to be used by simply passing the __FILE__ macro
  !> @param[in] line_number: The line number in the file that the check is at,
  !> intended to be used by simply passing the __LINE__ macro
  subroutine GPU_Error_Check(file_name, line_number)
#ifndef DISABLE_GPU_ERROR_CHECKING
    implicit none
    character(len=*), intent(in) :: file_name
    integer, intent(in) :: line_number
    integer :: code

    if (gpu_debug) then

       ! Sync and get code
       code = cudaDeviceSynchronize()

       ! Check the code
       if (code /= cudaSuccess) then
          print *, "GPU_Error_Check: Failed in File: ", file_name, "At Line:", line_number, "With code: ", cudaGetErrorString(code)
          error stop code
       end if

    endif
#endif
  end subroutine GPU_Error_Check
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the cell index within an oct.
  !>
  !> @param[in] i : The i index of the cell, must be 0 or 1
  !> @param[in] j : The j index of the cell, must be 0 or 1
  !> @param[in] k : The k index of the cell, must be 0 or 1
  !>
  !> @return
  !> The index of the cell within the oct
  attributes(host, device) function oct2cell_idx(i, j, k) result(idx)
    integer, intent(in) :: i, j, k
    integer :: idx
    idx = 1 + i + 2*j + 4*k
  end function oct2cell_idx
  ! ==========================================================================
end module gpu_utils

