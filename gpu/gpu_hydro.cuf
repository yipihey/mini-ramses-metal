  !> @brief
  !> Anisotropic edge-EMF primitive family (CPU h%emfx/h%emfy/h%emfz).
  type, public :: subgrid_2x3x3edge_primitive   ! edges parallel to x (emfx)
     real(kind=dp), dimension(0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: edge_e
  end type subgrid_2x3x3edge_primitive
  type, public :: subgrid_3x2x3edge_primitive   ! edges parallel to y (emfy)
     real(kind=dp), dimension(0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: edge_e
  end type subgrid_3x2x3edge_primitive
  type, public :: subgrid_3x3x2edge_primitive   ! edges parallel to z (emfz)
     real(kind=dp), dimension(0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: edge_e
  end type subgrid_3x3x2edge_primitive

  !> @brief
  !> Anisotropic edge corner-state family (CPU h%qRT/h%qRB/h%qLT/h%qLB)
  type, public :: subgrid_2x3x3edge_corner   ! edges parallel to x (feed emfx)
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: density
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: velocity_y
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: velocity_z
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: pressure
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: Bx
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: By
     real(kind=dp), dimension(1:4, 0:2*nsubgrid-1, 0:2*nsubgrid, 0:2*nsubgrid) :: Bz
  end type subgrid_2x3x3edge_corner
  type, public :: subgrid_3x2x3edge_corner   ! edges parallel to y (feed emfy)
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: density
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: velocity_x
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: velocity_z
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: pressure
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: Bx
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: By
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid-1, 0:2*nsubgrid) :: Bz
  end type subgrid_3x2x3edge_corner
  type, public :: subgrid_3x3x2edge_corner   ! edges parallel to z (feed emfz)
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: density
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: velocity_x
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: velocity_y
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: pressure
     real(kind=dp), dimension(1:4, 0:2*nsubgrid, 0:2*nsubgrid, 0:2*nsubgrid-1) :: Bx
