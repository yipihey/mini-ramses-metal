  type, public :: subgrid_edge_e_t
     real(kind=dp), dimension(1:2*nsubgrid+2, 1:2*nsubgrid+3, 1:2*nsubgrid+3) :: Ex
     real(kind=dp), dimension(1:2*nsubgrid+3, 1:2*nsubgrid+2, 1:2*nsubgrid+3) :: Ey
