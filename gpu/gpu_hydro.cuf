contains

  include 'gpu_reduce.cuf'

  ! ==========================================================================
  !> @brief
  !> Compute the magnitude squared of a vector. Returns x^2 + y^2 + z^2.
  !> Parentheses are used to guarantee associativity of transverse terms.
  !>
  !> @param[in] x : The x component of the vector
  !> @param[in] y : The y component of the vector
  !> @param[in] z : The z component of the vector
  attributes(device) function magnitude_squared(x, y, z)
    real(kind=dp), value :: x, y, z
    real(kind=dp) :: magnitude_squared
    magnitude_squared = x**2 + (y**2 + z**2)
    return
  end function magnitude_squared
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the pressure from conserved variables
  !>
  !> @param[in] conserved : The conserved variables
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> The pressure
  attributes(device) function compute_pressure(conserved, gamma) result(pressure)
    type(conserved_t), intent(in) :: conserved
    real(kind=dp), value :: gamma
    real(kind=dp) :: pressure, momentum_squared

    momentum_squared = magnitude_squared(conserved%momentum_x, conserved%momentum_y, conserved%momentum_z)
    pressure = (gamma - 1.0_dp)*(conserved%energy - 0.5_dp*momentum_squared/conserved%density)
    return
  end function compute_pressure
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the energy in a cell from primitive variables
  !>
  !> @param[in] primitive : The primitive variables in the cell
  !>  @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> The energy in the cell
  attributes(device) function compute_energy(primitive, gamma) result(energy)
    type(primitive_t), intent(in) :: primitive
    real(kind=dp), value :: gamma
    real(kind=dp) :: energy, velocity_squared

    velocity_squared = magnitude_squared(primitive%velocity_x, primitive%velocity_y, primitive%velocity_z)
    energy = (primitive%pressure/(gamma - 1.0_dp)) + 0.5_dp*primitive%density*velocity_squared
    return
  end function compute_energy
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the sound speed in a cell from the primitive variables
  !>
  !> @param[in] primitive : The primitive variables in a cell
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> The sound speed in a cell
  attributes(device) function sound_speed(primitive, gamma)
    type(primitive_t), intent(in) :: primitive
    real(kind=dp), value :: gamma
    real(kind=dp) :: sound_speed

    sound_speed = sqrt(gamma*primitive%pressure/primitive%density)
    return
  end function sound_speed
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Computes the minmod slope
  !>
  !> @param[in] left : The value to the "left" side of the cell
  !> @param[in] middle : The value in the cell
  !> @param[in] right : The value to the "left" side of the cell
  !> @return
  !> The minmod slope in the cell
  attributes(device) function slope_minmod(left, middle, right)
    real(kind=dp), value :: left, middle, right
    real(kind=dp) :: slope_left, slope_right
    real(kind=dp) :: slope_minmod

    slope_left = middle - left
    slope_right = right - middle

    if (slope_left*slope_right <= 0.0_dp) then
       slope_minmod = 0.0_dp
    else if (slope_left > 0_dp) then
       slope_minmod = min(slope_left, slope_right)
    else
       slope_minmod = max(slope_left, slope_right)
    end if
  end function slope_minmod
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Computes the moncen slope
  !>
  !> @param[in] left : The value to the "left" side of the cell
  !> @param[in] middle : The value in the cell
  !> @param[in] right : The value to the "left" side of the cell
  !> @return
  !> The moncen slope in the cell with minmod or 1st order as options
  attributes(device) function slope_moncen(left, middle, right, slope)
    real(kind=dp), value :: left, middle, right
    integer, value :: slope

    real(kind=dp) :: slope_left, slope_right, slope_central
    real(kind=dp) :: slope_minmod, slope_moncen, factor

    slope_left = middle - left
    slope_right = right - middle
    slope_central = 0.5 * (slope_left + slope_right)

    ! Slope type factor, 0: 1st order, 1: minmod, 2: moncen
    factor = real(slope, kind=dp)

    if (slope_left*slope_right <= 0.0_dp) then
       slope_moncen = 0.0_dp
    else if (slope_left > 0.0_dp) then
       slope_minmod = min(slope_left, slope_right)
       slope_moncen = min(factor * slope_minmod, slope_central)
    else
       slope_minmod = max(slope_left, slope_right)
       slope_moncen = max(factor * slope_minmod, slope_central)
    end if
  end function slope_moncen
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the limited TVD slopes of cell (i,j,k) in all three directions
  !> (v4.1). Dedicated device function factored out of the trace: trace_3d calls
  !> it once per cell instead of inlining the per-cell slope_moncen block. The
  !> returned slopes carry the half*dq convention (the 0.5 factor is applied
  !> here), exactly as the former inline block stored them.
  !>
  !> @param[in] local_subgrid : The subgrid of primitive variables
  !> @param[in] i, j, k : The cell indices within the subgrid
  !> @param[in] slope : The slope limiter id (0: 1st order, 1: minmod, 2: moncen)
  !> @param[out] slopes_x, slopes_y, slopes_z : The limited half*dq slopes
  attributes(device) subroutine compute_tvd_slopes(local_subgrid, i, j, k, slope, &
       & slopes_x, slopes_y, slopes_z)
    type(subgrid_6x6x6cell_primitive), intent(in) :: local_subgrid
    integer, value :: i, j, k, slope
    type(primitive_t), intent(out) :: slopes_x, slopes_y, slopes_z
    type(primitive_t) :: cell

    ! Cell centered (middle) values
    cell%density    = local_subgrid%density   (i, j, k)
    cell%velocity_x = local_subgrid%velocity_x(i, j, k)
    cell%velocity_y = local_subgrid%velocity_y(i, j, k)
    cell%velocity_z = local_subgrid%velocity_z(i, j, k)
    cell%pressure   = local_subgrid%pressure  (i, j, k)

    slopes_x%density    = 0.5_dp * slope_moncen(local_subgrid%density   (i - 1, j, k), cell%density,    local_subgrid%density   (i + 1, j, k), slope)
    slopes_x%velocity_x = 0.5_dp * slope_moncen(local_subgrid%velocity_x(i - 1, j, k), cell%velocity_x, local_subgrid%velocity_x(i + 1, j, k), slope)
    slopes_x%velocity_y = 0.5_dp * slope_moncen(local_subgrid%velocity_y(i - 1, j, k), cell%velocity_y, local_subgrid%velocity_y(i + 1, j, k), slope)
    slopes_x%velocity_z = 0.5_dp * slope_moncen(local_subgrid%velocity_z(i - 1, j, k), cell%velocity_z, local_subgrid%velocity_z(i + 1, j, k), slope)
    slopes_x%pressure   = 0.5_dp * slope_moncen(local_subgrid%pressure  (i - 1, j, k), cell%pressure,   local_subgrid%pressure  (i + 1, j, k), slope)

    slopes_y%density    = 0.5_dp * slope_moncen(local_subgrid%density   (i, j - 1, k), cell%density,    local_subgrid%density(   i, j + 1, k), slope)
    slopes_y%velocity_x = 0.5_dp * slope_moncen(local_subgrid%velocity_x(i, j - 1, k), cell%velocity_x, local_subgrid%velocity_x(i, j + 1, k), slope)
    slopes_y%velocity_y = 0.5_dp * slope_moncen(local_subgrid%velocity_y(i, j - 1, k), cell%velocity_y, local_subgrid%velocity_y(i, j + 1, k), slope)
    slopes_y%velocity_z = 0.5_dp * slope_moncen(local_subgrid%velocity_z(i, j - 1, k), cell%velocity_z, local_subgrid%velocity_z(i, j + 1, k), slope)
    slopes_y%pressure   = 0.5_dp * slope_moncen(local_subgrid%pressure  (i, j - 1, k), cell%pressure,   local_subgrid%pressure(  i, j + 1, k), slope)

    slopes_z%density    = 0.5_dp * slope_moncen(local_subgrid%density   (i, j, k - 1), cell%density,    local_subgrid%density   (i, j, k + 1), slope)
    slopes_z%velocity_x = 0.5_dp * slope_moncen(local_subgrid%velocity_x(i, j, k - 1), cell%velocity_x, local_subgrid%velocity_x(i, j, k + 1), slope)
    slopes_z%velocity_y = 0.5_dp * slope_moncen(local_subgrid%velocity_y(i, j, k - 1), cell%velocity_y, local_subgrid%velocity_y(i, j, k + 1), slope)
    slopes_z%velocity_z = 0.5_dp * slope_moncen(local_subgrid%velocity_z(i, j, k - 1), cell%velocity_z, local_subgrid%velocity_z(i, j, k + 1), slope)
    slopes_z%pressure   = 0.5_dp * slope_moncen(local_subgrid%pressure  (i, j, k - 1), cell%pressure,   local_subgrid%pressure  (i, j, k + 1), slope)

  end subroutine compute_tvd_slopes
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Convert from conserved to primitive variables
  !>
  !>
  !> @param[in] conserved : The conserved variables
  !> @param[in] gamma : The adiabatic index
  !> @return
  !> A primitive_t object with the primitive variables in a cell
  attributes(device) function conserved_2_primitive(conserved, gamma) result(primitive)
    type(conserved_t), intent(in) :: conserved
    real(kind=dp), value :: gamma
    type(primitive_t) :: primitive

    primitive%density    = conserved%density
    primitive%velocity_x = conserved%momentum_x / conserved%density
    primitive%velocity_y = conserved%momentum_y / conserved%density
    primitive%velocity_z = conserved%momentum_z / conserved%density
    primitive%pressure   = compute_pressure(conserved, gamma)
    return
  end function conserved_2_primitive
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Convert from primitive to conserved variables
  !>
  !>
  !> @param[in] primitive : The primitive variables
  !> @param[in] gamma : The adiabatic index
  !> @return
  !> A conserved_t object with the conserved variables in a cell
  attributes(device) function primitive_2_conserved(primitive, gamma) result(conserved)
    type(primitive_t), intent(in) :: primitive
    real(kind=dp), value :: gamma
    type(conserved_t) :: conserved

    conserved%density    = primitive%density
    conserved%momentum_x = primitive%velocity_x * primitive%density
    conserved%momentum_y = primitive%velocity_y * primitive%density
    conserved%momentum_z = primitive%velocity_z * primitive%density
    conserved%energy     = compute_energy(primitive, gamma)
    return
  end function primitive_2_conserved
  ! ==========================================================================

#ifdef MHD
  ! ==========================================================================
  ! MHD device helpers (Stage B1). Small attributes(device) functions mirroring
  ! the conserved<->primitive math of CPU ctoprim (umuscl.f90:1720). Currently
  ! unused; wired into the MHD integrator in later stages.
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute B^2 = Bx^2 + By^2 + Bz^2 from the cell-centred magnetic field.
  !> Parentheses guarantee associativity of the transverse terms, matching the
  !> existing magnitude_squared helper.
  !>
  !> @param[in] Bx : The x component of the (cell-centred) magnetic field
  !> @param[in] By : The y component of the (cell-centred) magnetic field
  !> @param[in] Bz : The z component of the (cell-centred) magnetic field
  !>
  !> @return
  !> The magnitude squared of the magnetic field
  attributes(device) function compute_bsquared(Bx, By, Bz) result(bsquared)
    real(kind=dp), value :: Bx, By, Bz
    real(kind=dp) :: bsquared
    bsquared = Bx**2 + (By**2 + Bz**2)
    return
  end function compute_bsquared
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Compute the magnetic energy density emag = 0.5*(Bx^2 + By^2 + Bz^2) from the
  !> cell-centred magnetic field (CPU ctoprim, umuscl.f90:1830-1833).
  !>
  !> @param[in] Bx : The x component of the (cell-centred) magnetic field
  !> @param[in] By : The y component of the (cell-centred) magnetic field
  !> @param[in] Bz : The z component of the (cell-centred) magnetic field
  !>
  !> @return
  !> The magnetic energy density
  attributes(device) function compute_emag(Bx, By, Bz) result(emag)
    real(kind=dp), value :: Bx, By, Bz
    real(kind=dp) :: emag
    emag = 0.5_dp * compute_bsquared(Bx, By, Bz)
    return
  end function compute_emag
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Convert conserved variables to primitive variables for MHD. Mirrors the
  !> hydro conserved_2_primitive but additionally (a) cell-centres the magnetic
  !> field as 0.5*(B_left + B_right) along each of the 3 axes and (b) subtracts
  !> the magnetic energy from the total energy before forming the gas pressure.
  !> See CPU ctoprim (umuscl.f90:1804-1845): the input energy is the TOTAL energy
  !> so both kinetic and magnetic energy are removed to get the internal energy.
  !> Floors match CPU ctoprim: density is floored before forming velocity/kinetic
  !> energy, then internal energy is floored before gas pressure is formed.
  !>
  !> @param[in] conserved : The hydro conserved variables (density, momentum, total energy)
  !> @param[in] bxl, bxr  : The low/high x-face magnetic field of the cell
  !> @param[in] byl, byr  : The low/high y-face magnetic field of the cell
  !> @param[in] bzl, bzr  : The low/high z-face magnetic field of the cell
  !> @param[in] gamma     : The adiabatic index
  !> @param[in] smallr    : Density floor
  !> @param[in] smallc    : Sound-speed floor
  !>
  !> @return
  !> A primitive_mhd_t with cell-centred B and gas pressure
  attributes(device) function mhd_conserved_2_primitive(conserved, bxl, bxr, byl, byr, bzl, bzr, gamma, smallr, smallc) result(primitive)
    type(conserved_t), intent(in) :: conserved
    real(kind=dp), value :: bxl, bxr, byl, byr, bzl, bzr
    real(kind=dp), value :: gamma, smallr, smallc
    type(primitive_mhd_t) :: primitive
    real(kind=dp) :: momentum_squared, emag, eint, smalle

    primitive%density    = max(conserved%density, smallr)
    primitive%velocity_x = conserved%momentum_x / primitive%density
    primitive%velocity_y = conserved%momentum_y / primitive%density
    primitive%velocity_z = conserved%momentum_z / primitive%density

    ! Cell-centred magnetic field: average of the two opposing faces per axis
    primitive%Bx = 0.5_dp * (bxl + bxr)
    primitive%By = 0.5_dp * (byl + byr)
    primitive%Bz = 0.5_dp * (bzl + bzr)

    ! Gas pressure from total energy minus kinetic and magnetic energy
    momentum_squared = magnitude_squared(conserved%momentum_x, conserved%momentum_y, conserved%momentum_z)
    emag = compute_emag(primitive%Bx, primitive%By, primitive%Bz)
    smalle = smallc**2/gamma/(gamma - 1.0_dp)
    eint = max(conserved%energy - 0.5_dp*momentum_squared/primitive%density - emag, smalle*primitive%density)
    primitive%pressure = (gamma - 1.0_dp) * eint
    return
  end function mhd_conserved_2_primitive
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Convert primitive variables to conserved variables for MHD. Mirrors the
  !> hydro primitive_2_conserved but adds the magnetic energy into the total
  !> energy and passes the cell-centred magnetic field through unchanged. Note
  !> this is the inverse of mhd_conserved_2_primitive only for the cell-centred
  !> field; the face-centred field is advanced separately by constrained transport.
  !>
  !> @param[in] primitive : The primitive MHD variables (cell-centred B)
  !> @param[in] gamma     : The adiabatic index
  !>
  !> @return
  !> A conserved_mhd_t with total energy (incl. magnetic) and cell-centred B
  attributes(device) function mhd_primitive_2_conserved(primitive, gamma) result(conserved)
    type(primitive_mhd_t), intent(in) :: primitive
    real(kind=dp), value :: gamma
    type(conserved_mhd_t) :: conserved
    real(kind=dp) :: velocity_squared, emag

    conserved%density    = primitive%density
    conserved%momentum_x = primitive%velocity_x * primitive%density
    conserved%momentum_y = primitive%velocity_y * primitive%density
    conserved%momentum_z = primitive%velocity_z * primitive%density

    velocity_squared = magnitude_squared(primitive%velocity_x, primitive%velocity_y, primitive%velocity_z)
    emag = compute_emag(primitive%Bx, primitive%By, primitive%Bz)
    conserved%energy = (primitive%pressure/(gamma - 1.0_dp)) + 0.5_dp*primitive%density*velocity_squared + emag

    conserved%Bx = primitive%Bx
    conserved%By = primitive%By
    conserved%Bz = primitive%Bz
    return
  end function mhd_primitive_2_conserved
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> GPU implementation of the 1D HLL MHD Riemann solver. This is a direct port
  !> of CPU riemann_hll_mhd (godunov_utils.f90), with x as the normal direction;
  !> callers rotate interface states for y/z faces in the MHD Riemann driver.
  !>
  !> @param[in] left  : The state on the left side of the interface
  !> @param[in] right : The state on the right side of the interface
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> flux : The conserved_mhd_t of the HLL MHD fluxes
  attributes(device) function hll_mhd_fluxes(left, right, gamma, smallr, smallc) result(flux)
    type(primitive_mhd_t), intent(in) :: left, right
    real(kind=dp), value :: gamma, smallr, smallc
    type(conserved_mhd_t) :: flux
    type(primitive_mhd_t) :: left_state, right_state
    type(conserved_mhd_t) :: left_state_c, right_state_c, left_fluxes, right_fluxes
    real(kind=dp) :: smallp
    real(kind=dp) :: bx_mean
    real(kind=dp) :: rl, rr, pl, pr, ul, ur, vl, vr, wl, wr
    real(kind=dp) :: blx, bly, blz, brx, bry, brz
    real(kind=dp) :: emagl, emagr, ptotl, ptotr, vdotbl, vdotbr
    real(kind=dp) :: b2l, b2r, c2l, c2r, d2l, d2r, cfleft, cfright
    real(kind=dp) :: speed_l, speed_r

    smallp = smallc**2 / gamma

    left_state = left
    right_state = right

    ! Enforce continuity of the normal magnetic field across the interface.
    bx_mean = 0.5_dp * (left_state%Bx + right_state%Bx)
    left_state%Bx = bx_mean
    right_state%Bx = bx_mean

    left_state%density = max(left_state%density, smallr)
    right_state%density = max(right_state%density, smallr)
    left_state%pressure = max(left_state%pressure, smallp * left_state%density)
    right_state%pressure = max(right_state%pressure, smallp * right_state%density)

    rl = left_state%density
    rr = right_state%density
    ul = left_state%velocity_x
    ur = right_state%velocity_x
    vl = left_state%velocity_y
    vr = right_state%velocity_y
    wl = left_state%velocity_z
    wr = right_state%velocity_z
    pl = left_state%pressure
    pr = right_state%pressure
    blx = left_state%Bx
    brx = right_state%Bx
    bly = left_state%By
    bry = right_state%By
    blz = left_state%Bz
    brz = right_state%Bz

    left_state_c = mhd_primitive_2_conserved(left_state, gamma)
    right_state_c = mhd_primitive_2_conserved(right_state, gamma)

    emagl = compute_emag(blx, bly, blz)
    emagr = compute_emag(brx, bry, brz)
    ptotl = pl + emagl
    ptotr = pr + emagr
    vdotbl = blx * ul + bly * vl + blz * wl
    vdotbr = brx * ur + bry * vr + brz * wr

    ! Compute the left and right physical MHD fluxes (CPU find_mhd_flux).
    left_fluxes%density = rl * ul
    left_fluxes%momentum_x = rl * ul * ul + ptotl - blx * blx
    left_fluxes%momentum_y = rl * ul * vl - blx * bly
    left_fluxes%momentum_z = rl * ul * wl - blx * blz
    left_fluxes%energy = (left_state_c%energy + ptotl) * ul - blx * vdotbl
    left_fluxes%Bx = 0.0_dp
    left_fluxes%By = bly * ul - blx * vl
    left_fluxes%Bz = blz * ul - blx * wl

    right_fluxes%density = rr * ur
    right_fluxes%momentum_x = rr * ur * ur + ptotr - brx * brx
    right_fluxes%momentum_y = rr * ur * vr - brx * bry
    right_fluxes%momentum_z = rr * ur * wr - brx * brz
    right_fluxes%energy = (right_state_c%energy + ptotr) * ur - brx * vdotbr
    right_fluxes%Bx = 0.0_dp
    right_fluxes%By = bry * ur - brx * vr
    right_fluxes%Bz = brz * ur - brx * wr

    ! Fast magnetosonic speeds (CPU find_speed_fast).
    b2l = compute_bsquared(blx, bly, blz)
    c2l = gamma * pl / rl
    d2l = 0.5_dp * (b2l / rl + c2l)
    cfleft = sqrt(d2l + sqrt(d2l**2 - c2l * blx * blx / rl))

    b2r = compute_bsquared(brx, bry, brz)
    c2r = gamma * pr / rr
    d2r = 0.5_dp * (b2r / rr + c2r)
    cfright = sqrt(d2r + sqrt(d2r**2 - c2r * brx * brx / rr))

    speed_l = min(min(ul, ur) - max(cfleft, cfright), 0.0_dp)
    speed_r = max(max(ul, ur) + max(cfleft, cfright), 0.0_dp)

    ! HLL flux, matching CPU fgdnv = (SR*fleft-SL*fright+SR*SL*(uright-uleft))/(SR-SL).
    flux%density = hll_flux(speed_l, speed_r, left_fluxes%density, right_fluxes%density, &
         & left_state_c%density, right_state_c%density)
    flux%momentum_x = hll_flux(speed_l, speed_r, left_fluxes%momentum_x, right_fluxes%momentum_x, &
         & left_state_c%momentum_x, right_state_c%momentum_x)
    flux%momentum_y = hll_flux(speed_l, speed_r, left_fluxes%momentum_y, right_fluxes%momentum_y, &
         & left_state_c%momentum_y, right_state_c%momentum_y)
    flux%momentum_z = hll_flux(speed_l, speed_r, left_fluxes%momentum_z, right_fluxes%momentum_z, &
         & left_state_c%momentum_z, right_state_c%momentum_z)
    flux%energy = hll_flux(speed_l, speed_r, left_fluxes%energy, right_fluxes%energy, &
         & left_state_c%energy, right_state_c%energy)
    flux%Bx = hll_flux(speed_l, speed_r, left_fluxes%Bx, right_fluxes%Bx, &
         & left_state_c%Bx, right_state_c%Bx)
    flux%By = hll_flux(speed_l, speed_r, left_fluxes%By, right_fluxes%By, &
         & left_state_c%By, right_state_c%By)
    flux%Bz = hll_flux(speed_l, speed_r, left_fluxes%Bz, right_fluxes%Bz, &
         & left_state_c%Bz, right_state_c%Bz)

    return
  end function hll_mhd_fluxes
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> GPU implementation of the HLLD MHD Riemann solver (Miyoshi & Kusano 2005,
  !> JCP 208, 315). Direct port of CPU riemann_hlld (godunov_utils.f90:967-1249),
  !> x as the normal direction (callers rotate y/z). Returns the conserved_mhd_t
  !> Godunov flux with the SAME field mapping as hll_mhd_fluxes (Bx flux = 0, By/Bz
  !> are the transverse-B fluxes), so it is a drop-in alternative in the dispatcher.
  !> The two-state-per-side structure (acoustic star + Alfven double-star) resolves
  !> the rotational/Alfven waves the single HLL average smears. Floors match
  !> hll_mhd_fluxes (smallr, smallp); the Alfven-degeneracy guard
  !> abs(estar)<1e-4*A^2 is the CPU one. The fast speed reuses find_speed_fast's
  !> formula with the continuity-enforced normal field A.
  !>
  !> @param[in] left  : The state on the left side of the interface
  !> @param[in] right : The state on the right side of the interface
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> flux : The conserved_mhd_t of the HLLD MHD fluxes
  attributes(device) function hlld_mhd_fluxes(left, right, gamma, smallr, smallc) result(flux)
    type(primitive_mhd_t), intent(in) :: left, right
    real(kind=dp), value :: gamma, smallr, smallc
    type(conserved_mhd_t) :: flux
    type(primitive_mhd_t) :: ls, rs
    real(kind=dp) :: smallp, entho, A, sgnm
    real(kind=dp) :: rl, ul, vl, wl, Pl, Bl, Cl, ekinl, emagl, etotl, Ptotl, vdotBl
    real(kind=dp) :: rr, ur, vr, wr, Pr, Br, Cr, ekinr, emagr, etotr, Ptotr, vdotBr
    real(kind=dp) :: b2l, c2l, d2l, cfastl, b2r, c2r, d2r, cfastr, SL, SR, rcl, rcr, ustar, Ptotstar
    real(kind=dp) :: rstarl, estar, el, vstarl, Bstarl, wstarl, Cstarl, vdotBstarl, etotstarl, sqrrstarl, calfvenl, SAL
    real(kind=dp) :: rstarr, er, vstarr, Bstarr, wstarr, Cstarr, vdotBstarr, etotstarr, sqrrstarr, calfvenr, SAR
    real(kind=dp) :: vstarstar, wstarstar, Bstarstar, Cstarstar, vdotBstarstar, etotstarstarl, etotstarstarr
    real(kind=dp) :: ro, uo, vo, wo, Bo, Co, Ptoto, etoto, vdotBo

    smallp = smallc**2 / gamma
    entho = 1.0_dp / (gamma - 1.0_dp)

    ! Floor the states (GPU convention, matches hll_mhd_fluxes; no-op for the
    ! already trace-floored inputs).
    ls = left; rs = right
    ls%density  = max(ls%density,  smallr);  rs%density  = max(rs%density,  smallr)
    ls%pressure = max(ls%pressure, smallp*ls%density)
    rs%pressure = max(rs%pressure, smallp*rs%density)

    ! Enforce continuity of the normal magnetic field (CPU :1006-1008).
    A = 0.5_dp*(ls%Bx + rs%Bx)
    sgnm = sign(1.0_dp, A)

    ! Left variables (CPU :1011-1025). %By/%Bz are the transverse B (Bl,Cl).
    rl = ls%density; ul = ls%velocity_x; vl = ls%velocity_y; wl = ls%velocity_z
    Pl = ls%pressure; Bl = ls%By; Cl = ls%Bz
    ekinl = 0.5_dp*(ul*ul + vl*vl + wl*wl)*rl
    emagl = 0.5_dp*(A*A + Bl*Bl + Cl*Cl)
    etotl = Pl*entho + ekinl + emagl
    Ptotl = Pl + emagl
    vdotBl = ul*A + vl*Bl + wl*Cl

    ! Right variables (CPU :1028-1042).
    rr = rs%density; ur = rs%velocity_x; vr = rs%velocity_y; wr = rs%velocity_z
    Pr = rs%pressure; Br = rs%By; Cr = rs%Bz
    ekinr = 0.5_dp*(ur*ur + vr*vr + wr*wr)*rr
    emagr = 0.5_dp*(A*A + Br*Br + Cr*Cr)
    etotr = Pr*entho + ekinr + emagr
    Ptotr = Pr + emagr
    vdotBr = ur*A + vr*Br + wr*Cr

    ! Fast magnetosonic speeds (find_speed_fast) using the continuity-enforced A.
    b2l = A*A + Bl*Bl + Cl*Cl; c2l = gamma*Pl/rl; d2l = 0.5_dp*(b2l/rl + c2l)
    cfastl = sqrt(d2l + sqrt(d2l**2 - c2l*A*A/rl))
    b2r = A*A + Br*Br + Cr*Cr; c2r = gamma*Pr/rr; d2r = 0.5_dp*(b2r/rr + c2r)
    cfastr = sqrt(d2r + sqrt(d2r**2 - c2r*A*A/rr))

    ! HLL wave speeds, Lagrangian sound speeds, acoustic star state (CPU :1049-1060).
    SL = min(ul, ur) - max(cfastl, cfastr)
    SR = max(ul, ur) + max(cfastl, cfastr)
    rcl = rl*(ul - SL); rcr = rr*(SR - ur)
    ustar    = (rcr*ur    + rcl*ul    + (Ptotl - Ptotr))      /(rcr + rcl)
    Ptotstar = (rcr*Ptotl + rcl*Ptotr + rcl*rcr*(ul - ur))    /(rcr + rcl)

    ! Left star region (CPU :1063-1087).
    rstarl = rl*(SL - ul)/(SL - ustar)
    estar  = rl*(SL - ul)*(SL - ustar) - A*A
    el     = rl*(SL - ul)*(SL - ul   ) - A*A
    if (abs(estar) < 1e-4_dp*A*A) then
       vstarl = vl; Bstarl = Bl; wstarl = wl; Cstarl = Cl
    else
       vstarl = vl - A*Bl*(ustar - ul)/estar
       Bstarl = Bl*el/estar
       wstarl = wl - A*Cl*(ustar - ul)/estar
       Cstarl = Cl*el/estar
    endif
    vdotBstarl = ustar*A + vstarl*Bstarl + wstarl*Cstarl
    etotstarl = ((SL - ul)*etotl - Ptotl*ul + Ptotstar*ustar + A*(vdotBl - vdotBstarl))/(SL - ustar)
    sqrrstarl = sqrt(rstarl); calfvenl = abs(A)/sqrrstarl; SAL = ustar - calfvenl

    ! Right star region (CPU :1090-1114).
    rstarr = rr*(SR - ur)/(SR - ustar)
    estar  = rr*(SR - ur)*(SR - ustar) - A*A
    er     = rr*(SR - ur)*(SR - ur   ) - A*A
    if (abs(estar) < 1e-4_dp*A*A) then
       vstarr = vr; Bstarr = Br; wstarr = wr; Cstarr = Cr
    else
       vstarr = vr - A*Br*(ustar - ur)/estar
       Bstarr = Br*er/estar
       wstarr = wr - A*Cr*(ustar - ur)/estar
       Cstarr = Cr*er/estar
    endif
    vdotBstarr = ustar*A + vstarr*Bstarr + wstarr*Cstarr
    etotstarr = ((SR - ur)*etotr - Ptotr*ur + Ptotstar*ustar + A*(vdotBr - vdotBstarr))/(SR - ustar)
    sqrrstarr = sqrt(rstarr); calfvenr = abs(A)/sqrrstarr; SAR = ustar + calfvenr

    ! Double star region (CPU :1117-1123).
    vstarstar = (sqrrstarl*vstarl + sqrrstarr*vstarr + sgnm*(Bstarr - Bstarl))/(sqrrstarl + sqrrstarr)
    wstarstar = (sqrrstarl*wstarl + sqrrstarr*wstarr + sgnm*(Cstarr - Cstarl))/(sqrrstarl + sqrrstarr)
    Bstarstar = (sqrrstarl*Bstarr + sqrrstarr*Bstarl + sgnm*sqrrstarl*sqrrstarr*(vstarr - vstarl))/(sqrrstarl + sqrrstarr)
    Cstarstar = (sqrrstarl*Cstarr + sqrrstarr*Cstarl + sgnm*sqrrstarl*sqrrstarr*(wstarr - wstarl))/(sqrrstarl + sqrrstarr)
    vdotBstarstar = ustar*A + vstarstar*Bstarstar + wstarstar*Cstarstar
    etotstarstarl = etotstarl - sgnm*sqrrstarl*(vdotBstarl - vdotBstarstar)
    etotstarstarr = etotstarr + sgnm*sqrrstarr*(vdotBstarr - vdotBstarstar)

    ! Sample the solution at x/t = 0 (CPU :1126-1222).
    if (SL > 0.0_dp) then
       ro = rl; uo = ul; vo = vl; wo = wl; Bo = Bl; Co = Cl; Ptoto = Ptotl; etoto = etotl; vdotBo = vdotBl
    else if (SAL > 0.0_dp) then
       ro = rstarl; uo = ustar; vo = vstarl; wo = wstarl; Bo = Bstarl; Co = Cstarl
       Ptoto = Ptotstar; etoto = etotstarl; vdotBo = vdotBstarl
    else if (ustar > 0.0_dp) then
       ro = rstarl; uo = ustar; vo = vstarstar; wo = wstarstar; Bo = Bstarstar; Co = Cstarstar
       Ptoto = Ptotstar; etoto = etotstarstarl; vdotBo = vdotBstarstar
    else if (SAR > 0.0_dp) then
       ro = rstarr; uo = ustar; vo = vstarstar; wo = wstarstar; Bo = Bstarstar; Co = Cstarstar
       Ptoto = Ptotstar; etoto = etotstarstarr; vdotBo = vdotBstarstar
    else if (SR > 0.0_dp) then
       ro = rstarr; uo = ustar; vo = vstarr; wo = wstarr; Bo = Bstarr; Co = Cstarr
       Ptoto = Ptotstar; etoto = etotstarr; vdotBo = vdotBstarr
    else
       ro = rr; uo = ur; vo = vr; wo = wr; Bo = Br; Co = Cr; Ptoto = Ptotr; etoto = etotr; vdotBo = vdotBr
    endif

    ! Godunov flux (CPU :1225-1232). Bx flux is zero (constrained transport).
    flux%density    = ro*uo
    flux%momentum_x = ro*uo*uo + Ptoto - A*A
    flux%momentum_y = ro*uo*vo - A*Bo
    flux%momentum_z = ro*uo*wo - A*Co
    flux%energy     = (etoto + Ptoto)*uo - A*vdotBo
    flux%Bx = 0.0_dp
    flux%By = Bo*uo - A*vo
    flux%Bz = Co*uo - A*wo

    return
  end function hlld_mhd_fluxes
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Dispatch GPU MHD Riemann solvers on the `riemann` integer id. HLL (B4) and
  !> HLLD (Miyoshi & Kusano) are implemented; other ids fall back to HLL with a
  !> TODO (llf/roe/upwind not yet ported).
  !>
  !> @param[in] left  : The state on the left side of the interface
  !> @param[in] right : The state on the right side of the interface
  !> @param[in] gamma : The adiabatic index
  !> @param[in] riemann : Solver id
  !>
  !> @return
  !> flux : The conserved_mhd_t of the fluxes
  attributes(device) function riemann_mhd_fluxes(left, right, gamma, smallr, smallc, riemann) result(flux)
    type(primitive_mhd_t), intent(in) :: left, right
    real(kind=dp), value :: gamma, smallr, smallc
    integer, value :: riemann
    type(conserved_mhd_t) :: flux

    if (riemann .eq. solver_hlld) then
       flux = hlld_mhd_fluxes(left, right, gamma, smallr, smallc)
    else if (riemann .eq. solver_hll) then
       flux = hll_mhd_fluxes(left, right, gamma, smallr, smallc)
    else
       ! TODO: add solver_llf / solver_roe / solver_upwind here.
       flux = hll_mhd_fluxes(left, right, gamma, smallr, smallc)   ! fall back to HLL
    endif

    return
  end function riemann_mhd_fluxes
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> GPU implementation of the 2D HLL edge EMF solver. This is a direct port of
  !> CPU riemann2d_hll_fast (godunov_utils.f90), using the four edge corner states
  !> qLL/qLR/qRL/qRR and returning the unscaled electric field.
  !>
  !> @param[in] qLL   : Left-bottom corner state
  !> @param[in] qLR   : Left-top corner state
  !> @param[in] qRL   : Right-bottom corner state
  !> @param[in] qRR   : Right-top corner state
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> E : The unscaled edge EMF
  attributes(device) function riemann2d_hll_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc) result(E)
    type(primitive_mhd_t), intent(in) :: qLL, qLR, qRL, qRR
    real(kind=dp), value :: gamma, smallr, smallc
    real(kind=dp) :: E
    type(primitive_mhd_t) :: stateLL, stateLR, stateRL, stateRR
    real(kind=dp) :: smallp
    real(kind=dp) :: ELL, ERL, ELR, ERR, SL, SR, SB, ST
    real(kind=dp) :: cLLx, cRLx, cLRx, cRRx, cLLy, cRLy, cLRy, cRRy
    real(kind=dp) :: uLL, uRL, uLR, uRR, vLL, vRL, vLR, vRR
    real(kind=dp) :: b2LL, b2LR, b2RL, b2RR
    real(kind=dp) :: c2LL, c2LR, c2RL, c2RR
    real(kind=dp) :: d2LL, d2LR, d2RL, d2RR

    smallp = smallc**2 / gamma

    stateLL = qLL
    stateLR = qLR
    stateRL = qRL
    stateRR = qRR

    stateLL%density = max(stateLL%density, smallr)
    stateLR%density = max(stateLR%density, smallr)
    stateRL%density = max(stateRL%density, smallr)
    stateRR%density = max(stateRR%density, smallr)
    stateLL%pressure = max(stateLL%pressure, smallp * stateLL%density)
    stateLR%pressure = max(stateLR%pressure, smallp * stateLR%density)
    stateRL%pressure = max(stateRL%pressure, smallp * stateRL%density)
    stateRR%pressure = max(stateRR%pressure, smallp * stateRR%density)

    ! vx*by - vy*bx at the four edge centers.
    ELL = stateLL%velocity_x * stateLL%By - stateLL%velocity_y * stateLL%Bx
    ERL = stateRL%velocity_x * stateRL%By - stateRL%velocity_y * stateRL%Bx
    ELR = stateLR%velocity_x * stateLR%By - stateLR%velocity_y * stateLR%Bx
    ERR = stateRR%velocity_x * stateRR%By - stateRR%velocity_y * stateRR%Bx

    ! Compute 4 fast magnetosonic velocities relative to x direction.
    uLL = stateLL%velocity_x
    uLR = stateLR%velocity_x
    uRL = stateRL%velocity_x
    uRR = stateRR%velocity_x

    b2LL = compute_bsquared(stateLL%Bx, stateLL%By, stateLL%Bz)
    c2LL = gamma * stateLL%pressure / stateLL%density
    d2LL = 0.5_dp * (b2LL / stateLL%density + c2LL)
    cLLx = sqrt(d2LL + sqrt(d2LL**2 - c2LL * stateLL%Bx * stateLL%Bx / stateLL%density))

    b2LR = compute_bsquared(stateLR%Bx, stateLR%By, stateLR%Bz)
    c2LR = gamma * stateLR%pressure / stateLR%density
    d2LR = 0.5_dp * (b2LR / stateLR%density + c2LR)
    cLRx = sqrt(d2LR + sqrt(d2LR**2 - c2LR * stateLR%Bx * stateLR%Bx / stateLR%density))

    b2RL = compute_bsquared(stateRL%Bx, stateRL%By, stateRL%Bz)
    c2RL = gamma * stateRL%pressure / stateRL%density
    d2RL = 0.5_dp * (b2RL / stateRL%density + c2RL)
    cRLx = sqrt(d2RL + sqrt(d2RL**2 - c2RL * stateRL%Bx * stateRL%Bx / stateRL%density))

    b2RR = compute_bsquared(stateRR%Bx, stateRR%By, stateRR%Bz)
    c2RR = gamma * stateRR%pressure / stateRR%density
    d2RR = 0.5_dp * (b2RR / stateRR%density + c2RR)
    cRRx = sqrt(d2RR + sqrt(d2RR**2 - c2RR * stateRR%Bx * stateRR%Bx / stateRR%density))

    ! Compute 4 fast magnetosonic velocities relative to y direction.
    vLL = stateLL%velocity_y
    vLR = stateLR%velocity_y
    vRL = stateRL%velocity_y
    vRR = stateRR%velocity_y

    cLLy = sqrt(d2LL + sqrt(d2LL**2 - c2LL * stateLL%By * stateLL%By / stateLL%density))
    cLRy = sqrt(d2LR + sqrt(d2LR**2 - c2LR * stateLR%By * stateLR%By / stateLR%density))
    cRLy = sqrt(d2RL + sqrt(d2RL**2 - c2RL * stateRL%By * stateRL%By / stateRL%density))
    cRRy = sqrt(d2RR + sqrt(d2RR**2 - c2RR * stateRR%By * stateRR%By / stateRR%density))

    SL = min(min(uLL, uLR, uRL, uRR) - max(cLLx, cLRx, cRLx, cRRx), 0.0_dp)
    SR = max(max(uLL, uLR, uRL, uRR) + max(cLLx, cLRx, cRLx, cRRx), 0.0_dp)
    SB = min(min(vLL, vLR, vRL, vRR) - max(cLLy, cLRy, cRLy, cRRy), 0.0_dp)
    ST = max(max(vLL, vLR, vRL, vRR) + max(cLLy, cLRy, cRLy, cRRy), 0.0_dp)

    E = (SL * SB * ERR - SL * ST * ERL - SR * SB * ELR + SR * ST * ELL) / (SR - SL) / (ST - SB) &
         & - ST * SB / (ST - SB) * (stateRR%Bx - stateLL%Bx) &
         & + SR * SL / (SR - SL) * (stateRR%By - stateLL%By)

    return
  end function riemann2d_hll_emf
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> GPU implementation of the 2D HLLD edge EMF solver. This ports CPU
  !> riemann2d_hlld (godunov_utils.f90) for the already-rotated edge frame used
  !> by cmp_mag_flx: velocity_x/Bx and velocity_y/By are the two directions in
  !> the edge-normal plane, velocity_z/Bz is the edge-parallel component.
  !>
  !> @param[in] qLL   : Left-bottom corner state
  !> @param[in] qLR   : Left-top corner state
  !> @param[in] qRL   : Right-bottom corner state
  !> @param[in] qRR   : Right-top corner state
  !> @param[in] gamma : The adiabatic index
  !> @param[in] smallr: Density floor
  !> @param[in] smallc: Sound-speed floor
  !>
  !> @return
  !> E : The unscaled edge EMF
  attributes(device) function riemann2d_hlld_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
       & switch_llf_dmin, switch_llf_pmin) result(E)
    type(primitive_mhd_t), intent(in) :: qLL, qLR, qRL, qRR
    real(kind=dp), value :: gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin
    real(kind=dp) :: E
    type(primitive_mhd_t) :: stateLL, stateLR, stateRL, stateRR
    real(kind=dp) :: smallp
    real(kind=dp) :: ELL, ERL, ELR, ERR, SL, SR, SB, ST, SAL, SAR, SAT, SAB
    real(kind=dp) :: cfastLLx, cfastRLx, cfastLRx, cfastRRx
    real(kind=dp) :: cfastLLy, cfastRLy, cfastLRy, cfastRRy
    real(kind=dp) :: calfvenR, calfvenL, calfvenT, calfvenB
    real(kind=dp) :: rLL, rLR, rRL, rRR, pLL, pLR, pRL, pRR
    real(kind=dp) :: uLL, uLR, uRL, uRR, vLL, vLR, vRL, vRR
    real(kind=dp) :: ALL, ALR, ARL, ARR, BLL, BLR, BRL, BRR, CLL, CLR, CRL, CRR
    real(kind=dp) :: PtotLL, PtotLR, PtotRL, PtotRR
    real(kind=dp) :: rcLLx, rcLRx, rcRLx, rcRRx, rcLLy, rcLRy, rcRLy, rcRRy
    real(kind=dp) :: ustar, vstar
    real(kind=dp) :: rstarLLx, rstarLRx, rstarRLx, rstarRRx
    real(kind=dp) :: rstarLLy, rstarLRy, rstarRLy, rstarRRy
    real(kind=dp) :: rstarLL, rstarLR, rstarRL, rstarRR
    real(kind=dp) :: AstarLL, AstarLR, AstarRL, AstarRR
    real(kind=dp) :: BstarLL, BstarLR, BstarRL, BstarRR
    real(kind=dp) :: EstarLLx, EstarLRx, EstarRLx, EstarRRx
    real(kind=dp) :: EstarLLy, EstarLRy, EstarRLy, EstarRRy
    real(kind=dp) :: EstarLL, EstarLR, EstarRL, EstarRR
    real(kind=dp) :: AstarT, AstarB, BstarR, BstarL
    real(kind=dp) :: b2LL, b2LR, b2RL, b2RR
    real(kind=dp) :: c2LL, c2LR, c2RL, c2RR
    real(kind=dp) :: d2LL, d2LR, d2RL, d2RR
    real(kind=dp) :: rmin, pmin, Smax
    logical :: switch_to_llf

    smallp = smallc**2 / gamma

    stateLL = qLL
    stateLR = qLR
    stateRL = qRL
    stateRR = qRR

    stateLL%density = max(stateLL%density, smallr)
    stateLR%density = max(stateLR%density, smallr)
    stateRL%density = max(stateRL%density, smallr)
    stateRR%density = max(stateRR%density, smallr)
    stateLL%pressure = max(stateLL%pressure, smallp * stateLL%density)
    stateLR%pressure = max(stateLR%pressure, smallp * stateLR%density)
    stateRL%pressure = max(stateRL%pressure, smallp * stateRL%density)
    stateRR%pressure = max(stateRR%pressure, smallp * stateRR%density)

    rLL = stateLL%density; pLL = stateLL%pressure
    uLL = stateLL%velocity_x; vLL = stateLL%velocity_y
    ALL = stateLL%Bx; BLL = stateLL%By; CLL = stateLL%Bz
    rLR = stateLR%density; pLR = stateLR%pressure
    uLR = stateLR%velocity_x; vLR = stateLR%velocity_y
    ALR = stateLR%Bx; BLR = stateLR%By; CLR = stateLR%Bz
    rRL = stateRL%density; pRL = stateRL%pressure
    uRL = stateRL%velocity_x; vRL = stateRL%velocity_y
    ARL = stateRL%Bx; BRL = stateRL%By; CRL = stateRL%Bz
    rRR = stateRR%density; pRR = stateRR%pressure
    uRR = stateRR%velocity_x; vRR = stateRR%velocity_y
    ARR = stateRR%Bx; BRR = stateRR%By; CRR = stateRR%Bz

    b2LL = compute_bsquared(ALL, BLL, CLL); c2LL = gamma*pLL/rLL
    d2LL = 0.5_dp*(b2LL/rLL + c2LL)
    cfastLLx = sqrt(d2LL + sqrt(d2LL**2 - c2LL*ALL*ALL/rLL))
    cfastLLy = sqrt(d2LL + sqrt(d2LL**2 - c2LL*BLL*BLL/rLL))
    b2LR = compute_bsquared(ALR, BLR, CLR); c2LR = gamma*pLR/rLR
    d2LR = 0.5_dp*(b2LR/rLR + c2LR)
    cfastLRx = sqrt(d2LR + sqrt(d2LR**2 - c2LR*ALR*ALR/rLR))
    cfastLRy = sqrt(d2LR + sqrt(d2LR**2 - c2LR*BLR*BLR/rLR))
    b2RL = compute_bsquared(ARL, BRL, CRL); c2RL = gamma*pRL/rRL
    d2RL = 0.5_dp*(b2RL/rRL + c2RL)
    cfastRLx = sqrt(d2RL + sqrt(d2RL**2 - c2RL*ARL*ARL/rRL))
    cfastRLy = sqrt(d2RL + sqrt(d2RL**2 - c2RL*BRL*BRL/rRL))
    b2RR = compute_bsquared(ARR, BRR, CRR); c2RR = gamma*pRR/rRR
    d2RR = 0.5_dp*(b2RR/rRR + c2RR)
    cfastRRx = sqrt(d2RR + sqrt(d2RR**2 - c2RR*ARR*ARR/rRR))
    cfastRRy = sqrt(d2RR + sqrt(d2RR**2 - c2RR*BRR*BRR/rRR))

    SL = min(uLL, uLR, uRL, uRR) - max(cfastLLx, cfastLRx, cfastRLx, cfastRRx)
    SR = max(uLL, uLR, uRL, uRR) + max(cfastLLx, cfastLRx, cfastRLx, cfastRRx)
    SB = min(vLL, vLR, vRL, vRR) - max(cfastLLy, cfastLRy, cfastRLy, cfastRRy)
    ST = max(vLL, vLR, vRL, vRR) + max(cfastLLy, cfastLRy, cfastRLy, cfastRRy)

    ELL = uLL*BLL - vLL*ALL
    ELR = uLR*BLR - vLR*ALR
    ERL = uRL*BRL - vRL*ARL
    ERR = uRR*BRR - vRR*ARR

    switch_to_llf = .false.
    rmin = min(rLL, rLR, rRL, rRR)
    pmin = min(pLL, pLR, pRL, pRR)
    if (switch_llf_dmin > 0.0_dp) switch_to_llf = rmin < switch_llf_dmin
    if (switch_llf_pmin > 0.0_dp) switch_to_llf = pmin < switch_llf_pmin
    if (switch_to_llf) then
       Smax = max(abs(SR), abs(ST), abs(SL), abs(SB))
       E = 0.25_dp*(ERR + ERL + ELR + ELL) &
            & + 0.5_dp*Smax*(stateRR%Bx - stateLL%Bx) &
            & - 0.5_dp*Smax*(stateRR%By - stateLL%By)
       return
    endif

    PtotLL = pLL + 0.5_dp*(ALL*ALL + BLL*BLL + CLL*CLL)
    PtotLR = pLR + 0.5_dp*(ALR*ALR + BLR*BLR + CLR*CLR)
    PtotRL = pRL + 0.5_dp*(ARL*ARL + BRL*BRL + CRL*CRL)
    PtotRR = pRR + 0.5_dp*(ARR*ARR + BRR*BRR + CRR*CRR)

    rcLLx = rLL*(uLL - SL); rcRLx = rRL*(SR - uRL)
    rcLRx = rLR*(uLR - SL); rcRRx = rRR*(SR - uRR)
    rcLLy = rLL*(vLL - SB); rcLRy = rLR*(ST - vLR)
    rcRLy = rRL*(vRL - SB); rcRRy = rRR*(ST - vRR)

    ustar = (rcLLx*uLL + rcLRx*uLR + rcRLx*uRL + rcRRx*uRR &
         & + (PtotLL - PtotRL + PtotLR - PtotRR))/(rcLLx + rcLRx + rcRLx + rcRRx)
    vstar = (rcLLy*vLL + rcLRy*vLR + rcRLy*vRL + rcRRy*vRR &
         & + (PtotLL - PtotLR + PtotRL - PtotRR))/(rcLLy + rcLRy + rcRLy + rcRRy)

    rstarLLx = rLL*(SL - uLL)/(SL - ustar); BstarLL = BLL*(SL - uLL)/(SL - ustar)
    rstarLLy = rLL*(SB - vLL)/(SB - vstar); AstarLL = ALL*(SB - vLL)/(SB - vstar)
    rstarLL  = rLL*(SL - uLL)/(SL - ustar)*(SB - vLL)/(SB - vstar)
    EstarLLx = ustar*BstarLL - vLL*ALL
    EstarLLy = uLL*BLL - vstar*AstarLL
    EstarLL  = ustar*BstarLL - vstar*AstarLL

    rstarLRx = rLR*(SL - uLR)/(SL - ustar); BstarLR = BLR*(SL - uLR)/(SL - ustar)
    rstarLRy = rLR*(ST - vLR)/(ST - vstar); AstarLR = ALR*(ST - vLR)/(ST - vstar)
    rstarLR  = rLR*(SL - uLR)/(SL - ustar)*(ST - vLR)/(ST - vstar)
    EstarLRx = ustar*BstarLR - vLR*ALR
    EstarLRy = uLR*BLR - vstar*AstarLR
    EstarLR  = ustar*BstarLR - vstar*AstarLR

    rstarRLx = rRL*(SR - uRL)/(SR - ustar); BstarRL = BRL*(SR - uRL)/(SR - ustar)
    rstarRLy = rRL*(SB - vRL)/(SB - vstar); AstarRL = ARL*(SB - vRL)/(SB - vstar)
    rstarRL  = rRL*(SR - uRL)/(SR - ustar)*(SB - vRL)/(SB - vstar)
    EstarRLx = ustar*BstarRL - vRL*ARL
    EstarRLy = uRL*BRL - vstar*AstarRL
    EstarRL  = ustar*BstarRL - vstar*AstarRL

    rstarRRx = rRR*(SR - uRR)/(SR - ustar); BstarRR = BRR*(SR - uRR)/(SR - ustar)
    rstarRRy = rRR*(ST - vRR)/(ST - vstar); AstarRR = ARR*(ST - vRR)/(ST - vstar)
    rstarRR  = rRR*(SR - uRR)/(SR - ustar)*(ST - vRR)/(ST - vstar)
    EstarRRx = ustar*BstarRR - vRR*ARR
    EstarRRy = uRR*BRR - vstar*AstarRR
    EstarRR  = ustar*BstarRR - vstar*AstarRR

    calfvenL = max(abs(ALR)/sqrt(rstarLRx), abs(AstarLR)/sqrt(rstarLR), &
         &         abs(ALL)/sqrt(rstarLLx), abs(AstarLL)/sqrt(rstarLL), smallc)
    calfvenR = max(abs(ARR)/sqrt(rstarRRx), abs(AstarRR)/sqrt(rstarRR), &
         &         abs(ARL)/sqrt(rstarRLx), abs(AstarRL)/sqrt(rstarRL), smallc)
    calfvenB = max(abs(BLL)/sqrt(rstarLLy), abs(BstarLL)/sqrt(rstarLL), &
         &         abs(BRL)/sqrt(rstarRLy), abs(BstarRL)/sqrt(rstarRL), smallc)
    calfvenT = max(abs(BLR)/sqrt(rstarLRy), abs(BstarLR)/sqrt(rstarLR), &
         &         abs(BRR)/sqrt(rstarRRy), abs(BstarRR)/sqrt(rstarRR), smallc)
    SAL = min(ustar - calfvenL, 0.0_dp); SAR = max(ustar + calfvenR, 0.0_dp)
    SAB = min(vstar - calfvenB, 0.0_dp); SAT = max(vstar + calfvenT, 0.0_dp)
    AstarT = (SAR*AstarRR - SAL*AstarLR)/(SAR - SAL)
    AstarB = (SAR*AstarRL - SAL*AstarLL)/(SAR - SAL)
    BstarR = (SAT*BstarRR - SAB*BstarRL)/(SAT - SAB)
    BstarL = (SAT*BstarLR - SAB*BstarLL)/(SAT - SAB)

    if (SB > 0.0_dp) then
       if (SL > 0.0_dp) then
          E = ELL
       else if (SR < 0.0_dp) then
          E = ERL
       else
          E = (SAR*EstarLLx - SAL*EstarRLx + SAR*SAL*(BRL - BLL))/(SAR - SAL)
       endif
    else if (ST < 0.0_dp) then
       if (SL > 0.0_dp) then
          E = ELR
       else if (SR < 0.0_dp) then
          E = ERR
       else
          E = (SAR*EstarLRx - SAL*EstarRRx + SAR*SAL*(BRR - BLR))/(SAR - SAL)
       endif
    else if (SL > 0.0_dp) then
       E = (SAT*EstarLLy - SAB*EstarLRy - SAT*SAB*(ALR - ALL))/(SAT - SAB)
    else if (SR < 0.0_dp) then
       E = (SAT*EstarRLy - SAB*EstarRRy - SAT*SAB*(ARR - ARL))/(SAT - SAB)
    else
       E = (SAL*SAB*EstarRR - SAL*SAT*EstarRL - SAR*SAB*EstarLR + SAR*SAT*EstarLL) &
            & /(SAR - SAL)/(SAT - SAB) &
            & - SAT*SAB/(SAT - SAB)*(AstarT - AstarB) &
            & + SAR*SAL/(SAR - SAL)*(BstarR - BstarL)
    endif

    return
  end function riemann2d_hlld_emf
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Dispatch GPU 2D MHD EMF solvers. HLLF and HLLD are implemented; other solver
  !> ids intentionally fall back to 2D HLL until their ports are added.
  !>
  !> @param[in] qLL       : Left-bottom corner state
  !> @param[in] qLR       : Left-top corner state
  !> @param[in] qRL       : Right-bottom corner state
  !> @param[in] qRR       : Right-top corner state
  !> @param[in] gamma     : The adiabatic index
  !> @param[in] riemann2d : 2D solver id
  !>
  !> @return
  !> E : The unscaled edge EMF
  attributes(device) function riemann2d_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
       & switch_llf_dmin, switch_llf_pmin, riemann2d) result(E)
    type(primitive_mhd_t), intent(in) :: qLL, qLR, qRL, qRR
    real(kind=dp), value :: gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin
    integer, value :: riemann2d
    real(kind=dp) :: E

    if (riemann2d .eq. solver2d_hlld) then
       E = riemann2d_hlld_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
            & switch_llf_dmin, switch_llf_pmin)
    else if (riemann2d .eq. solver2d_hllf) then
       E = riemann2d_hll_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc)
    else
       ! TODO: add solver2d_hlla / simple here.
       E = riemann2d_hll_emf(qLL, qLR, qRL, qRR, gamma, smallr, smallc)   ! fall back to 2D HLL
    endif

    return
  end function riemann2d_emf
  ! ==========================================================================
#endif

  ! ==========================================================================
  !> @brief
  !> Convert a zero based 1D index into zero based 3D indices
  !>
  !> @param[in] index : The 1D index to convert
  !> @param[in] nx : The size of the grid in the X direction
  !> @param[in] ny : The size of the grid in the Y direction
  !> @param[out] xid : The x component of the 3D index
  !> @param[out] yid : The y component of the 3D index
  !> @param[out] zid : The z component of the 3D index
  attributes(device) subroutine index_1Dto3D(index, nx, ny, xid, yid, zid)
    integer, value :: index, nx, ny
    integer, intent(out) :: xid, yid, zid
    zid = index/(nx*ny)
    yid = (index - zid*nx*ny)/nx
    xid = index - zid*nx*ny - yid*nx
  end subroutine index_1Dto3D
  ! ==========================================================================

  ! ==========================================================================
  !> @brief
  !> Convert a zero based 1D index into zero based 2D indices
  !>
  !> @param[in] index : The 1D index to convert
  !> @param[in] nx : The size of the grid in the X direction
  !> @param[out] xid : The x component of the 2D index
  !> @param[out] yid : The y component of the 2D index
  attributes(device) subroutine index_1Dto2D(index, nx, xid, yid)
    integer, value :: index, nx
    integer, intent(out) :: xid, yid
    yid = index/nx
    xid = index - yid*nx
  end subroutine index_1Dto2D
  ! ==========================================================================

  ! =========================================================================
  !> @brief
  !> Convert a subgrid of conserved variables to primitive variables in shared memory
  !>
  !> @param[in] head_idx : The head index of the octs at the current AMR level
  !> @param[in] block_idx : The CUDA block index of the calling thread
  !> @param[in] thread_idx : The index of calling thread within its block
  !> @param[in] gamma : The adiabatic index
  !> @param[out] local_subgrid : The local subgrid in shared memory to write the primitive variables to
  !>
  attributes(device) subroutine subgrid_conserved_2_primitive(grid, uold, f, constant_gravity, nbor, &
       & head_idx, block_idx, thread_idx, gamma, dt, local_subgrid)
    type(oct), device :: grid(*)
    real(kind=8), device :: constant_gravity(3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), value :: head_idx
    integer(kind=4), value :: block_idx, thread_idx
    real(kind=dp), value :: gamma
    real(kind=dp), value :: dt
    type(subgrid_6x6x6cell_primitive), intent(inout) :: local_subgrid

    type(conserved_t) :: conserved ! object to hold the conserved variables
    type(primitive_t) :: primitive ! object to hold the primitive variables
    integer :: work_idx, ind_nbor
    integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: cell_idx, source_idx, subgrid_idx
    integer :: work_size

    work_size = 2*nsubgrid+4

    do work_idx = thread_idx, work_size**3 - 1, blockDim%x

       ! Compute the subgrid_indices index, i.e. determine the oct to load
       call index_1Dto3D(work_idx/8, work_size/2, work_size/2, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx)

       ! Get subgrid index
       subgrid_idx = head_idx + block_idx

       ! Get neighbour index
       ind_nbor = work_idx/8 + 1
       source_idx = nbor(ind_nbor, subgrid_idx)

       ! Now that we have the index to the oct we need to figure out which cell within it to load 
       cell_idx = mod(work_idx, 8) + 1

       ! Lastly, we need to figure out where in the subgrid the cell we will load goes
       call index_1Dto3D(cell_idx - 1, 2, 2, i, j, k)
       i = i + 2*i_subgrid_idx
       j = j + 2*j_subgrid_idx
       k = k + 2*k_subgrid_idx

       ! Load the cell
       conserved%density    = uold(cell_idx, 1, source_idx)
       conserved%momentum_x = uold(cell_idx, 2, source_idx)
       conserved%momentum_y = uold(cell_idx, 3, source_idx)
       conserved%momentum_z = uold(cell_idx, 4, source_idx)
       conserved%energy     = uold(cell_idx, 5, source_idx)

       ! Convert to primitive variables
       primitive = conserved_2_primitive(conserved, gamma)

       ! Gravity predictor step
#ifdef GRAV
       primitive%velocity_x = primitive%velocity_x + f(cell_idx, 1, source_idx) * 0.5_dp * dt
       primitive%velocity_y = primitive%velocity_y + f(cell_idx, 2, source_idx) * 0.5_dp * dt
       primitive%velocity_z = primitive%velocity_z + f(cell_idx, 3, source_idx) * 0.5_dp * dt
#else
       primitive%velocity_x = primitive%velocity_x + constant_gravity(1) * 0.5_dp * dt
       primitive%velocity_y = primitive%velocity_y + constant_gravity(2) * 0.5_dp * dt
       primitive%velocity_z = primitive%velocity_z + constant_gravity(3) * 0.5_dp * dt
#endif

       ! Write primitives cells to shared memory
       local_subgrid%density   (i, j, k) = primitive%density
       local_subgrid%velocity_x(i, j, k) = primitive%velocity_x
       local_subgrid%velocity_y(i, j, k) = primitive%velocity_y
       local_subgrid%velocity_z(i, j, k) = primitive%velocity_z
       local_subgrid%pressure  (i, j, k) = primitive%pressure

       ! Store refinement map
       local_subgrid%refined   (i, j, k) = grid(source_idx)%refined(cell_idx)

    end do

    call syncthreads()

  end subroutine subgrid_conserved_2_primitive
  ! =========================================================================

  ! =========================================================================
  !> @brief
  !> Compute the interface states with tracing
  !>
  !> @param[in] local_subgrid : The subgrid of primitive variables to solve
  !> @param[in] thread_idx : The index of the current thread
  !> @param[in] gamma : The adiabatic index
  !> @param[in] dtdx : dt / dx
  !> @param[in] left_interfaces_x : The left side interfaces normal to x
  !> @param[in] left_interfaces_y : The left side interfaces normal to y
  !> @param[in] left_interfaces_z : The left side interfaces normal to z
  !> @param[in] right_interfaces_x : The right side interfaces normal to x
  !> @param[in] right_interfaces_y : The right side interfaces normal to y
  !> @param[in] right_interfaces_z : The right side interfaces normal to z
  !>
  attributes(device) subroutine trace_3d(local_subgrid, thread_idx, &
       & left_interfaces_x, right_interfaces_x,left_interfaces_y, right_interfaces_y, &
       & left_interfaces_z, right_interfaces_z, gamma, dtdx, slope)
    type(subgrid_6x6x6cell_primitive), intent(inout) :: local_subgrid ! The subgrid that this block is working on in shared memory
    integer, value :: thread_idx
    real(kind=dp), value :: gamma, dtdx
    integer, value :: slope

    type(subgrid_3x2x2cell_primitive) :: left_interfaces_x, right_interfaces_x
    type(subgrid_2x3x2cell_primitive) :: left_interfaces_y, right_interfaces_y
    type(subgrid_2x2x3cell_primitive) :: left_interfaces_z, right_interfaces_z
    type(primitive_t) :: cell ! The cell centered primitive variables and (eventually) predicted states
    type(primitive_t) :: slopes_x, slopes_y, slopes_z ! The limited slopes in the x, y, and z directions
    type(primitive_t) :: source_term ! The sources terms

    real(kind=dp), parameter :: smallr = 1d-10
    real(kind=dp), parameter :: smallc_squared = (1d-10)**2
    real(kind=dp), parameter :: smallp = smallr * smallc_squared
    integer :: work_idx   ! Loop index for unit of work
    integer :: i, j, k    ! Cell indices
    integer :: work_size

    ! Compute the size of the section of the subgrid to operate on
    work_size = 2*nsubgrid+2

    ! Note that we're now excluding the outermost shell of cells since this
    ! stencil operation requires 1 ghost cell. This also requires the
    ! transformation from the basic 3D indexing as shown below to shift the indices from going from 0-5 to 1-6
    do work_idx = thread_idx, work_size**3 - 1, blockDim%x
       ! Compute the 3D indices, note the tranformation so that we're indexing 1-6 and not 0-5
       call index_1Dto3D(work_idx, work_size, work_size, i, j, k)
       i = i + 1; j = j + 1; k = k + 1

       ! Cell centered values
       cell%density    = local_subgrid%density   (i, j, k)
       cell%velocity_x = local_subgrid%velocity_x(i, j, k)
       cell%velocity_y = local_subgrid%velocity_y(i, j, k)
       cell%velocity_z = local_subgrid%velocity_z(i, j, k)
       cell%pressure   = local_subgrid%pressure  (i, j, k)

       ! Compute the TVD Slopes (dedicated device function, v4.1; half*dq)
       call compute_tvd_slopes(local_subgrid, i, j, k, slope, slopes_x, slopes_y, slopes_z)

       ! Source terms
       source_term%density    = -cell%velocity_x * slopes_x%density    &
                                -cell%velocity_y * slopes_y%density    &
                                -cell%velocity_z * slopes_z%density    &
                                - (slopes_x%velocity_x + slopes_y%velocity_y + slopes_z%velocity_z) * cell%density
       source_term%velocity_x = -cell%velocity_x * slopes_x%velocity_x &
                                -cell%velocity_y * slopes_y%velocity_x &
                                -cell%velocity_z * slopes_z%velocity_x &
                                - (slopes_x%pressure) / cell%density
       source_term%velocity_y = -cell%velocity_x * slopes_x%velocity_y &
                                -cell%velocity_y * slopes_y%velocity_y &
                                -cell%velocity_z * slopes_z%velocity_y &
                                - (slopes_y%pressure) / cell%density
       source_term%velocity_z = -cell%velocity_x * slopes_x%velocity_z &
                                -cell%velocity_y * slopes_y%velocity_z &
                                -cell%velocity_z * slopes_z%velocity_z &
                                - (slopes_z%pressure) / cell%density
       source_term%pressure   = -cell%velocity_x * slopes_x%pressure   &
                                -cell%velocity_y * slopes_y%pressure   &
                                -cell%velocity_z * slopes_z%pressure   &
                                - (slopes_x%velocity_x + slopes_y%velocity_y + slopes_z%velocity_z) * gamma * cell%pressure

       ! Cell-centered predicted states
       cell%density    = cell%density    + dtdx * source_term%density
       cell%velocity_x = cell%velocity_x + dtdx * source_term%velocity_x
       cell%velocity_y = cell%velocity_y + dtdx * source_term%velocity_y
       cell%velocity_z = cell%velocity_z + dtdx * source_term%velocity_z
       cell%pressure   = cell%pressure   + dtdx * source_term%pressure

       ! Compute and write out the interface states

       ! The right state at i-1/2
       if (i > 1 .and. (j > 1 .and. j < work_size) .and. (k > 1 .and. k < work_size)) then
          right_interfaces_x%density   (i-2, j-2, k-2) = cell%density    - slopes_x%density
          right_interfaces_x%velocity_x(i-2, j-2, k-2) = cell%velocity_x - slopes_x%velocity_x
          right_interfaces_x%velocity_y(i-2, j-2, k-2) = cell%velocity_y - slopes_x%velocity_y
          right_interfaces_x%velocity_z(i-2, j-2, k-2) = cell%velocity_z - slopes_x%velocity_z
          right_interfaces_x%pressure  (i-2, j-2, k-2) = cell%pressure   - slopes_x%pressure
          ! Fallback to first order
          if (right_interfaces_x%density (i-2, j-2, k-2) < smallr) right_interfaces_x%density (i-2, j-2, k-2) = local_subgrid%density (i, j, k)
          if (right_interfaces_x%pressure(i-2, j-2, k-2) < smallp) right_interfaces_x%pressure(i-2, j-2, k-2) = local_subgrid%pressure(i, j, k)
       end if

       ! The left state at i+1/2
       if (i < work_size .and. (j > 1 .and. j < work_size) .and. (k > 1 .and. k < work_size)) then
          left_interfaces_x%density   (i-1, j-2, k-2) = cell%density    + slopes_x%density
          left_interfaces_x%velocity_x(i-1, j-2, k-2) = cell%velocity_x + slopes_x%velocity_x
          left_interfaces_x%velocity_y(i-1, j-2, k-2) = cell%velocity_y + slopes_x%velocity_y
          left_interfaces_x%velocity_z(i-1, j-2, k-2) = cell%velocity_z + slopes_x%velocity_z
          left_interfaces_x%pressure  (i-1, j-2, k-2) = cell%pressure   + slopes_x%pressure
          ! Fallback to first order
          if (left_interfaces_x%density (i-1, j-2, k-2) < smallr) left_interfaces_x%density (i-1, j-2, k-2) = local_subgrid%density (i, j, k)
          if (left_interfaces_x%pressure(i-1, j-2, k-2) < smallp) left_interfaces_x%pressure(i-1, j-2, k-2) = local_subgrid%pressure(i, j, k)
       end if

       ! The right state at j-1/2
       if ((i > 1 .and. i < work_size) .and. j > 1 .and. (k > 1 .and. k < work_size)) then
          right_interfaces_y%density   (i-2, j-2, k-2) = cell%density    - slopes_y%density
          right_interfaces_y%velocity_x(i-2, j-2, k-2) = cell%velocity_x - slopes_y%velocity_x
          right_interfaces_y%velocity_y(i-2, j-2, k-2) = cell%velocity_y - slopes_y%velocity_y
          right_interfaces_y%velocity_z(i-2, j-2, k-2) = cell%velocity_z - slopes_y%velocity_z
          right_interfaces_y%pressure  (i-2, j-2, k-2) = cell%pressure   - slopes_y%pressure
          ! Fallback to first order
          if (right_interfaces_y%density (i-2, j-2, k-2) < smallr) right_interfaces_y%density (i-2, j-2, k-2) = local_subgrid%density (i, j, k)
          if (right_interfaces_y%pressure(i-2, j-2, k-2) < smallp) right_interfaces_y%pressure(i-2, j-2, k-2) = local_subgrid%pressure(i, j, k)
       end if

       ! The left state at j+1/2
       if ((i > 1 .and. i < work_size) .and. j < work_size .and. (k > 1 .and. k < work_size)) then
          left_interfaces_y%density   (i-2, j-1, k-2) = cell%density    + slopes_y%density
          left_interfaces_y%velocity_x(i-2, j-1, k-2) = cell%velocity_x + slopes_y%velocity_x
          left_interfaces_y%velocity_y(i-2, j-1, k-2) = cell%velocity_y + slopes_y%velocity_y
          left_interfaces_y%velocity_z(i-2, j-1, k-2) = cell%velocity_z + slopes_y%velocity_z
          left_interfaces_y%pressure  (i-2, j-1, k-2) = cell%pressure   + slopes_y%pressure
          ! Fallback to first order
          if (left_interfaces_y%density (i-2, j-1, k-2) < smallr) left_interfaces_y%density (i-2, j-1, k-2) = local_subgrid%density (i, j, k)
          if (left_interfaces_y%pressure(i-2, j-1, k-2) < smallp) left_interfaces_y%pressure(i-2, j-1, k-2) = local_subgrid%pressure(i, j, k)
       end if

       ! The right state at k-1/2
       if ((i > 1 .and. i < work_size) .and. (j > 1 .and. j < work_size) .and. k > 1) then
          right_interfaces_z%density   (i-2, j-2, k-2) = cell%density    - slopes_z%density
          right_interfaces_z%velocity_x(i-2, j-2, k-2) = cell%velocity_x - slopes_z%velocity_x
          right_interfaces_z%velocity_y(i-2, j-2, k-2) = cell%velocity_y - slopes_z%velocity_y
          right_interfaces_z%velocity_z(i-2, j-2, k-2) = cell%velocity_z - slopes_z%velocity_z
          right_interfaces_z%pressure  (i-2, j-2, k-2) = cell%pressure   - slopes_z%pressure
          ! Fallback to first order
          if (right_interfaces_z%density (i-2, j-2, k-2) < smallr) right_interfaces_z%density (i-2, j-2, k-2) = local_subgrid%density (i, j, k)
          if (right_interfaces_z%pressure(i-2, j-2, k-2) < smallp) right_interfaces_z%pressure(i-2, j-2, k-2) = local_subgrid%pressure(i, j, k)
       end if

       ! The left state at k+1/2
       if ((i > 1 .and. i < work_size) .and. (j > 1 .and. j < work_size) .and. k < work_size) then
          left_interfaces_z%density   (i-2, j-2, k-1) = cell%density    + slopes_z%density
          left_interfaces_z%velocity_x(i-2, j-2, k-1) = cell%velocity_x + slopes_z%velocity_x
          left_interfaces_z%velocity_y(i-2, j-2, k-1) = cell%velocity_y + slopes_z%velocity_y
          left_interfaces_z%velocity_z(i-2, j-2, k-1) = cell%velocity_z + slopes_z%velocity_z
          left_interfaces_z%pressure  (i-2, j-2, k-1) = cell%pressure   + slopes_z%pressure
          ! Fallback to first order
          if (left_interfaces_z%density (i-2, j-2, k-1) < smallr) left_interfaces_z%density (i-2, j-2, k-1) = local_subgrid%density (i, j, k)
          if (left_interfaces_z%pressure(i-2, j-2, k-1) < smallp) left_interfaces_z%pressure(i-2, j-2, k-1) = local_subgrid%pressure(i, j, k)
       end if
    end do

    call syncthreads()
   
  end subroutine trace_3d
  ! =========================================================================

  ! =========================================================================
  !> @brief
  !> Compute the HLL flux for a specific field. Note that this only computes 
  !> the HLL flux itself from intermediate values. The full HLL Riemann Solver 
  !> is in the `hll_fluxes` function which calls this function.
  !>
  !> @param[in] speed_l : The sound speed from the left interface
  !> @param[in] speed_r : The sound speed from the right interface
  !> @param[in] left_flux : The left HLL flux
  !> @param[in] right_flux : The right HLL flux
  !> @param[in] left_c : The left conserved variables
  !> @param[in] right_c : The right conserved variable
  !>
  !> @return
  !> flux : The HLL flux for this field
  attributes(device) function hll_flux(speed_l, speed_r, left_flux, right_flux, left_c, right_c) result(flux)
    real(kind=dp), value :: speed_l, speed_r,  left_flux, right_flux, left_c, right_c
    real(kind=dp) :: flux
    flux = (speed_r * left_flux - speed_l*right_flux + speed_r * speed_l * (right_c-left_c)) / (speed_r-speed_l)
  end function hll_flux
  ! =========================================================================
  ! =========================================================================
  !> @brief
  !> GPU implementation of the HLL Riemann Solver.
  !>
  !> @param[in] left_state_p : The state on the left side of the interface in primitive variables
  !> @param[in] right_state_p : The state on the right side of the interface in primitive variables
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> flux : The conserved_t of the HLL fluxes 
  attributes(device) function hll_fluxes(left_state_p, right_state_p, gamma, llf) result(flux)
    type(primitive_t), intent(inout) :: left_state_p, right_state_p
    real(kind=dp), value :: gamma
    logical, value :: llf
    type(conserved_t) :: flux
    ! Both `smallr` and `smallc`/`smallp` are usually defined in amr_commons. I'm redefining them here so that they will be evaluated at compile time
    real(kind=dp), parameter :: smallr = 1d-10
    real(kind=dp), parameter :: smallc_squared = (1d-10)**2
    type(conserved_t) :: left_state_c, right_state_c, left_fluxes, right_fluxes
    real(kind=dp) :: smallp
    real(kind=dp) :: sound_speed_l, sound_speed_r, speed_l, speed_r, speed_max

    ! Compute the sound speeds
    sound_speed_l = sound_speed(left_state_p, gamma)
    sound_speed_r = sound_speed(right_state_p, gamma)

    ! Compute the wave speeds
    if (llf) then
       speed_max = max(abs(left_state_p%velocity_x)+sound_speed_l,abs(right_state_p%velocity_x)+sound_speed_r)
       speed_l = -speed_max
       speed_r = speed_max
    else
       speed_l = min(min(left_state_p%velocity_x, right_state_p%velocity_x) - max(sound_speed_l, sound_speed_r), 0.0_dp)
       speed_r = max(max(left_state_p%velocity_x, right_state_p%velocity_x) + max(sound_speed_l, sound_speed_r), 0.0_dp)
    endif

    ! Convert to conserved variables
    left_state_c = primitive_2_conserved(left_state_p, gamma)
    right_state_c = primitive_2_conserved(right_state_p, gamma)

    ! Compute the left and right fluxes
    left_fluxes%density    = left_state_c%momentum_x
    left_fluxes%momentum_x = left_state_p%pressure + left_state_p%velocity_x * left_state_c%momentum_x
    left_fluxes%momentum_y = left_state_p%velocity_x * left_state_c%momentum_y
    left_fluxes%momentum_z = left_state_p%velocity_x * left_state_c%momentum_z
    left_fluxes%energy     = left_state_p%velocity_x * (left_state_p%pressure + left_state_c%energy)

    right_fluxes%density    = right_state_c%momentum_x
    right_fluxes%momentum_x = right_state_p%pressure + right_state_p%velocity_x * right_state_c%momentum_x
    right_fluxes%momentum_y = right_state_p%velocity_x * right_state_c%momentum_y
    right_fluxes%momentum_z = right_state_p%velocity_x * right_state_c%momentum_z
    right_fluxes%energy     = right_state_p%velocity_x * (right_state_p%pressure + right_state_c%energy)

    ! Compute the HLL fluxes
    flux%density    = hll_flux(speed_l, speed_r, left_fluxes%density,    right_fluxes%density,    left_state_c%density,    right_state_c%density)
    flux%momentum_x = hll_flux(speed_l, speed_r, left_fluxes%momentum_x, right_fluxes%momentum_x, left_state_c%momentum_x, right_state_c%momentum_x)
    flux%momentum_y = hll_flux(speed_l, speed_r, left_fluxes%momentum_y, right_fluxes%momentum_y, left_state_c%momentum_y, right_state_c%momentum_y)
    flux%momentum_z = hll_flux(speed_l, speed_r, left_fluxes%momentum_z, right_fluxes%momentum_z, left_state_c%momentum_z, right_state_c%momentum_z)
    flux%energy     = hll_flux(speed_l, speed_r, left_fluxes%energy,     right_fluxes%energy,     left_state_c%energy,     right_state_c%energy)

  end function hll_fluxes
  ! =========================================================================

  ! =========================================================================
  !> @brief
  !> GPU implementation of the HLLC Riemann Solver.
  !>
  !> @param[in] left_state_p : The state on the left side of the interface in primitive variables
  !> @param[in] right_state_p : The state on the right side of the interface in primitive variables
  !> @param[in] gamma : The adiabatic index
  !>
  !> @return
  !> flux : The conserved_t of the HLLC fluxes
  attributes(device) function hllc_fluxes(left_state_p, right_state_p, gamma) result(flux)
    type(primitive_t), intent(inout) :: left_state_p, right_state_p
    real(kind=dp), value :: gamma
    type(conserved_t) :: flux
    ! Both `smallr` and `smallc`/`smallp` are usually defined in amr_commons. 
    ! Redefining them here so that they will be evaluated at compile time
    real(kind=dp), parameter :: smallr = 1d-10
    real(kind=dp), parameter :: smallc_squared = (1d-10)**2
    real(kind=dp) :: smallp, entho
    real(kind=dp) :: rl, rr, pl, pr, ul, ur, vl, vr, wl, wr
    real(kind=dp) :: el, er, ekinl, ekinr, etotl, etotr
    real(kind=dp) :: sound_speed_l, sound_speed_r, speed_l, speed_r
    real(kind=dp) :: rcl, rcr, ustar, pstar
    real(kind=dp) :: rstarl, rstarr, etotstarl, etotstarr
    real(kind=dp) :: ro, uo, vo, wo, po, etoto

    ! Verify that the density and pressure are reasonable and positive
    smallp = smallc_squared / gamma
    left_state_p%density   = max(left_state_p%density,   smallr)
    right_state_p%density  = max(right_state_p%density,  smallr)
    left_state_p%pressure  = max(left_state_p%pressure,  smallp * left_state_p%density)
    right_state_p%pressure = max(right_state_p%pressure, smallp * right_state_p%density)

    rl = left_state_p%density
    rr = right_state_p%density
    ul = left_state_p%velocity_x
    ur = right_state_p%velocity_x
    vl = left_state_p%velocity_y
    vr = right_state_p%velocity_y
    wl = left_state_p%velocity_z
    wr = right_state_p%velocity_z
    pl = left_state_p%pressure
    pr = right_state_p%pressure

    entho = 1.0_dp / (gamma - 1.0_dp)
    el = pl * entho
    er = pr * entho
    ekinl = 0.5_dp * rl * magnitude_squared(ul, vl, wl)
    ekinr = 0.5_dp * rr * magnitude_squared(ur, vr, wr)
    etotl = el + ekinl
    etotr = er + ekinr

    ! Compute the sound speeds
    sound_speed_l = sound_speed(left_state_p, gamma)
    sound_speed_r = sound_speed(right_state_p, gamma)

    ! Compute the wave speeds
    speed_l = min(ul, ur) - max(sound_speed_l, sound_speed_r)
    speed_r = max(ul, ur) + max(sound_speed_l, sound_speed_r)

    rcl = rl * (ul - speed_l)
    rcr = rr * (speed_r - ur)

    ustar = (rcr * ur + rcl * ul + (pl - pr)) / (rcr + rcl)
    pstar = (rcr * pl + rcl * pr + rcl * rcr * (ul - ur)) / (rcr + rcl)

    rstarl = rl * (speed_l - ul) / (speed_l - ustar)
    rstarr = rr * (speed_r - ur) / (speed_r - ustar)
    etotstarl = ((speed_l - ul) * etotl - pl * ul + pstar * ustar) / (speed_l - ustar)
    etotstarr = ((speed_r - ur) * etotr - pr * ur + pstar * ustar) / (speed_r - ustar)

    ! Sample the solution at x/t=0
    if (speed_l > 0.0_dp) then
       ro = rl
       uo = ul
       vo = vl
       wo = wl
       po = pl
       etoto = etotl
    else if (ustar > 0.0_dp) then
       ro = rstarl
       uo = ustar
       vo = vl
       wo = wl
       po = pstar
       etoto = etotstarl
    else if (speed_r > 0.0_dp) then
       ro = rstarr
       uo = ustar
       vo = vr
       wo = wr
       po = pstar
       etoto = etotstarr
    else
       ro = rr
       uo = ur
       vo = vr
       wo = wr
       po = pr
       etoto = etotr
    endif

    ! Compute the Godunov flux
    flux%density    = ro * uo
    flux%momentum_x = ro * uo * uo + po
    flux%momentum_y = ro * uo * vo
    flux%momentum_z = ro * uo * wo
    flux%energy     = (etoto + po) * uo

  end function hllc_fluxes
  ! =========================================================================

  ! =========================================================================
  !> @brief
  !> Dispatch GPU hydro Riemann solvers (LLF, HLL, HLLC).
  !>
  !> @param[in] left_state_p : The state on the left side of the interface in primitive variables
  !> @param[in] right_state_p : The state on the right side of the interface in primitive variables
  !> @param[in] gamma : The adiabatic index
  !> @param[in] riemann : Solver id
  !>
  !> @return
  !> flux : The conserved_t of the fluxes
  attributes(device) function riemann_fluxes(left_state_p, right_state_p, gamma, riemann) result(flux)
    type(primitive_t), intent(inout) :: left_state_p, right_state_p
    real(kind=dp), value :: gamma
    integer, value :: riemann
    type(conserved_t) :: flux

    if(riemann .eq. solver_llf)then
       flux = hll_fluxes(left_state_p, right_state_p, gamma, .true.)
    else if (riemann .eq. solver_hll) then
       flux = hll_fluxes(left_state_p, right_state_p, gamma, .false.)
    else if (riemann .eq. solver_hllc) then
       flux = hllc_fluxes(left_state_p, right_state_p, gamma)
    else
       ! Unsupported: LLF
       flux = hll_fluxes(left_state_p, right_state_p, gamma, .true.)
    endif

  end function riemann_fluxes
  ! =========================================================================

  ! =========================================================================
  !> @brief
  !> Driver for the Riemann solvers. This subroutine handles arranging the interface states and reading/writing data from shared memory
  !>
  !> @param[in,out] left_interfaces_x : The left interfaces at the i+1/2 interfaces. The fluxes along the X interfaces are returned in this array
  !> @param[in] right_interfaces_x : The right interfaces at the i-1/2 interfaces.
  !> @param[in,out] left_interfaces_y : The left interfaces at the j+1/2 interfaces. The fluxes along the Y interfaces are returned in this array
  !> @param[in] right_interfaces_y : The right interfaces at the j-1/2 interfaces.
  !> @param[in,out] left_interfaces_z : The left interfaces at the k+1/2 interfaces. The fluxes along the Z interfaces are returned in this array
  !> @param[in] right_interfaces_z : The right interfaces at the k-1/2 interfaces.
  !> @param[in] gamma : The adiabatic index
  !> @param[in] thread_idx : The index of this thread
  !>
  attributes(device) subroutine riemann_driver(left_interfaces_x, right_interfaces_x, left_interfaces_y, &
       & right_interfaces_y, left_interfaces_z, right_interfaces_z, thread_idx, &
       & gamma, riemann)
    type(subgrid_3x2x2cell_primitive), intent(inout) :: left_interfaces_x, right_interfaces_x
    type(subgrid_2x3x2cell_primitive), intent(inout) :: left_interfaces_y, right_interfaces_y
    type(subgrid_2x2x3cell_primitive), intent(inout) :: left_interfaces_z, right_interfaces_z
    real(kind=dp), value :: gamma
    integer, value :: riemann
    integer, value :: thread_idx
    integer :: work_idx, interface_array_size, i, j, k
    type(primitive_t) :: left_interface, right_interface
    type(conserved_t) :: flux

    interface_array_size = (2*nsubgrid+1) * (2*nsubgrid)**2

    do work_idx = thread_idx, interface_array_size * 3 - 1, blockDim%x
       if (work_idx < interface_array_size) then ! Compute fluxes across the x interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid, i, j, k)

          ! Gather the interface states
          left_interface%density    = left_interfaces_x%density(i,j,k)
          left_interface%velocity_x = left_interfaces_x%velocity_x(i,j,k)
          left_interface%velocity_y = left_interfaces_x%velocity_y(i,j,k)
          left_interface%velocity_z = left_interfaces_x%velocity_z(i,j,k)
          left_interface%pressure   = left_interfaces_x%pressure(i,j,k)

          right_interface%density    = right_interfaces_x%density(i,j,k)
          right_interface%velocity_x = right_interfaces_x%velocity_x(i,j,k)
          right_interface%velocity_y = right_interfaces_x%velocity_y(i,j,k)
          right_interface%velocity_z = right_interfaces_x%velocity_z(i,j,k)
          right_interface%pressure   = right_interfaces_x%pressure(i,j,k)

          ! Call the Riemann Solver
          flux = riemann_fluxes(left_interface, right_interface, gamma, riemann)

          ! Unpack the fluxes into the interface state arrays
          left_interfaces_x%density   (i,j,k) = flux%density
          left_interfaces_x%velocity_x(i,j,k) = flux%momentum_x
          left_interfaces_x%velocity_y(i,j,k) = flux%momentum_y
          left_interfaces_x%velocity_z(i,j,k) = flux%momentum_z
          left_interfaces_x%pressure  (i,j,k) = flux%energy

       else if (work_idx < 2 * interface_array_size) then ! Compute fluxes across the y interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx - interface_array_size, 2*nsubgrid, 2*nsubgrid+1, i, j, k)

          ! Gather the interface states
          left_interface%density    = left_interfaces_y%density(i,j,k)
          left_interface%velocity_x = left_interfaces_y%velocity_y(i,j,k)
          left_interface%velocity_y = left_interfaces_y%velocity_z(i,j,k)
          left_interface%velocity_z = left_interfaces_y%velocity_x(i,j,k)
          left_interface%pressure   = left_interfaces_y%pressure(i,j,k)

          right_interface%density    = right_interfaces_y%density(i,j,k)
          right_interface%velocity_x = right_interfaces_y%velocity_y(i,j,k)
          right_interface%velocity_y = right_interfaces_y%velocity_z(i,j,k)
          right_interface%velocity_z = right_interfaces_y%velocity_x(i,j,k)
          right_interface%pressure   = right_interfaces_y%pressure(i,j,k)

          ! Call the Riemann Solver
          flux = riemann_fluxes(left_interface, right_interface, gamma, riemann)

          ! Unpack the fluxes into the interface state arrays
          left_interfaces_y%density   (i,j,k) = flux%density
          left_interfaces_y%velocity_x(i,j,k) = flux%momentum_z
          left_interfaces_y%velocity_y(i,j,k) = flux%momentum_x
          left_interfaces_y%velocity_z(i,j,k) = flux%momentum_y
          left_interfaces_y%pressure  (i,j,k) = flux%energy
       else ! Compute fluxes across the z interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx - 2*interface_array_size, 2*nsubgrid, 2*nsubgrid, i, j, k)

          ! Gather the interface states
          left_interface%density    = left_interfaces_z%density(i,j,k)
          left_interface%velocity_x = left_interfaces_z%velocity_z(i,j,k)
          left_interface%velocity_y = left_interfaces_z%velocity_x(i,j,k)
          left_interface%velocity_z = left_interfaces_z%velocity_y(i,j,k)
          left_interface%pressure   = left_interfaces_z%pressure(i,j,k)

          right_interface%density    = right_interfaces_z%density(i,j,k)
          right_interface%velocity_x = right_interfaces_z%velocity_z(i,j,k)
          right_interface%velocity_y = right_interfaces_z%velocity_x(i,j,k)
          right_interface%velocity_z = right_interfaces_z%velocity_y(i,j,k)
          right_interface%pressure   = right_interfaces_z%pressure(i,j,k)

          ! Call the Riemann Solver
          flux = riemann_fluxes(left_interface, right_interface, gamma, riemann)

          ! Unpack the fluxes into the interface state arrays
          left_interfaces_z%density   (i,j,k) = flux%density
          left_interfaces_z%velocity_x(i,j,k) = flux%momentum_y
          left_interfaces_z%velocity_y(i,j,k) = flux%momentum_z
          left_interfaces_z%velocity_z(i,j,k) = flux%momentum_x
          left_interfaces_z%pressure  (i,j,k) = flux%energy
       end if
    end do

    call syncthreads()

  end subroutine riemann_driver
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine zero_fine_fluxes(local_subgrid, fluxes_x, fluxes_y, fluxes_z, thread_idx)
    type(subgrid_6x6x6cell_primitive), intent(in)    :: local_subgrid
    type(subgrid_3x2x2cell_primitive), intent(inout) :: fluxes_x
    type(subgrid_2x3x2cell_primitive), intent(inout) :: fluxes_y
    type(subgrid_2x2x3cell_primitive), intent(inout) :: fluxes_z
    integer, value :: thread_idx

    integer :: work_idx, interface_array_size
    integer :: i, j, k

    interface_array_size = (2*nsubgrid+1) * (2*nsubgrid)**2

    do work_idx = thread_idx, interface_array_size * 3 - 1, blockDim%x

       if (work_idx < interface_array_size) then ! Zero fluxes across the x interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid, i, j, k)

          if (local_subgrid%refined(i+1,j+2,k+2) .or. local_subgrid%refined(i+2,j+2,k+2))then
             fluxes_x%density   (i, j, k) = 0_dp
             fluxes_x%velocity_x(i, j, k) = 0_dp
             fluxes_x%velocity_y(i, j, k) = 0_dp
             fluxes_x%velocity_z(i, j, k) = 0_dp
             fluxes_x%pressure  (i, j, k) = 0_dp
          endif

       else if (work_idx < 2 * interface_array_size) then ! Zero fluxes across the y interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx - interface_array_size, 2*nsubgrid, 2*nsubgrid+1, i, j, k)

          if (local_subgrid%refined(i+2,j+1,k+2) .or. local_subgrid%refined(i+2,j+2,k+2))then
             fluxes_y%density   (i, j, k) = 0_dp
             fluxes_y%velocity_x(i, j, k) = 0_dp
             fluxes_y%velocity_y(i, j, k) = 0_dp
             fluxes_y%velocity_z(i, j, k) = 0_dp
             fluxes_y%pressure  (i, j, k) = 0_dp
          endif

       else ! Zero fluxes across the z interfaces
          ! Compute the indices in the interface state arrays
          call index_1Dto3D(work_idx - 2 * interface_array_size, 2*nsubgrid, 2*nsubgrid, i, j, k)

          if (local_subgrid%refined(i+2,j+2,k+1) .or. local_subgrid%refined(i+2,j+2,k+2))then
             fluxes_z%density   (i, j, k) = 0_dp
             fluxes_z%velocity_x(i, j, k) = 0_dp
             fluxes_z%velocity_y(i, j, k) = 0_dp
             fluxes_z%velocity_z(i, j, k) = 0_dp
             fluxes_z%pressure  (i, j, k) = 0_dp
          endif

       end if
    end do

    call syncthreads()

  end subroutine zero_fine_fluxes
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine conservative_update(unew, nbor, fluxes_x, fluxes_y, fluxes_z, &
       & head_idx, block_idx, thread_idx, dtdx)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    type(subgrid_3x2x2cell_primitive), intent(in) :: fluxes_x
    type(subgrid_2x3x2cell_primitive), intent(in) :: fluxes_y
    type(subgrid_2x2x3cell_primitive), intent(in) :: fluxes_z
    integer(kind=4), value :: head_idx
    integer, value :: block_idx, thread_idx
    real(kind=dp), value :: dtdx

    integer :: work_size
    integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: work_idx, subgrid_idx, oct_idx, cell_idx, ind_nbor
    type(conserved_t) :: update_term

    ! Compute the size of the section of the subgrid to operate on
    work_size = 2*nsubgrid

    ! Note that we're now excluding the ghost cells since this operation doesn't need them.
    do work_idx = thread_idx, work_size**3 - 1, blockDim%x

       ! Compute the subgrid index
       subgrid_idx = head_idx + block_idx

       ! Compute the subgrid_indices index, i.e. determine the oct to load
       call index_1Dto3D(work_idx/8, work_size/2, work_size/2, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = k_subgrid_idx + 1

       ! Compute the oct index
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       oct_idx = nbor(ind_nbor, subgrid_idx)

       ! Compute the cell index
       cell_idx = mod(work_idx, 8) + 1

       ! Compute the flux indices
       call index_1Dto3D(cell_idx - 1, 2, 2, i, j, k)
       i = i + 2*(i_subgrid_idx - 1)
       j = j + 2*(j_subgrid_idx - 1)
       k = k + 2*(k_subgrid_idx - 1)

       ! Gather the fluxes, computing the update term as we go. Note that the flux 
       ! variables names are the primitive names but the actual variables are the 
       ! conserved variables, this is because we're reuseing the interface state 
       ! array to store this fluxes. 

       ! X component
       update_term%density    = (fluxes_x%density   (i, j, k) - fluxes_x%density   (i+1, j, k)) * dtdx
       update_term%momentum_x = (fluxes_x%velocity_x(i, j, k) - fluxes_x%velocity_x(i+1, j, k)) * dtdx
       update_term%momentum_y = (fluxes_x%velocity_y(i, j, k) - fluxes_x%velocity_y(i+1, j, k)) * dtdx
       update_term%momentum_z = (fluxes_x%velocity_z(i, j, k) - fluxes_x%velocity_z(i+1, j, k)) * dtdx
       update_term%energy     = (fluxes_x%pressure  (i, j, k) - fluxes_x%pressure  (i+1, j, k)) * dtdx

       ! Y component
       update_term%density    = (fluxes_y%density   (i, j, k) - fluxes_y%density   (i, j+1, k)) * dtdx + update_term%density
       update_term%momentum_x = (fluxes_y%velocity_x(i, j, k) - fluxes_y%velocity_x(i, j+1, k)) * dtdx + update_term%momentum_x
       update_term%momentum_y = (fluxes_y%velocity_y(i, j, k) - fluxes_y%velocity_y(i, j+1, k)) * dtdx + update_term%momentum_y
       update_term%momentum_z = (fluxes_y%velocity_z(i, j, k) - fluxes_y%velocity_z(i, j+1, k)) * dtdx + update_term%momentum_z
       update_term%energy     = (fluxes_y%pressure  (i, j, k) - fluxes_y%pressure  (i, j+1, k)) * dtdx + update_term%energy

       ! Z component
       update_term%density    = (fluxes_z%density   (i, j, k) - fluxes_z%density   (i, j, k+1)) * dtdx + update_term%density
       update_term%momentum_x = (fluxes_z%velocity_x(i, j, k) - fluxes_z%velocity_x(i, j, k+1)) * dtdx + update_term%momentum_x
       update_term%momentum_y = (fluxes_z%velocity_y(i, j, k) - fluxes_z%velocity_y(i, j, k+1)) * dtdx + update_term%momentum_y
       update_term%momentum_z = (fluxes_z%velocity_z(i, j, k) - fluxes_z%velocity_z(i, j, k+1)) * dtdx + update_term%momentum_z
       update_term%energy     = (fluxes_z%pressure  (i, j, k) - fluxes_z%pressure  (i, j, k+1)) * dtdx + update_term%energy

       ! Conservative update. Note that in this code dt/dx = dt/dy = dt/dz in all cases
       unew(cell_idx, 1, oct_idx) = unew(cell_idx, 1, oct_idx) + update_term%density
       unew(cell_idx, 2, oct_idx) = unew(cell_idx, 2, oct_idx) + update_term%momentum_x
       unew(cell_idx, 3, oct_idx) = unew(cell_idx, 3, oct_idx) + update_term%momentum_y
       unew(cell_idx, 4, oct_idx) = unew(cell_idx, 4, oct_idx) + update_term%momentum_z
       unew(cell_idx, 5, oct_idx) = unew(cell_idx, 5, oct_idx) + update_term%energy

    end do

  end subroutine conservative_update
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine coarse_cell_update(grid, unew, father, nbor, fluxes_x, fluxes_y, fluxes_z, &
       & head_idx, block_idx, thread_idx, ngridmax, dtdx)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, device :: nbor(1:subgridsize,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    type(subgrid_3x2x2cell_primitive), intent(in) :: fluxes_x
    type(subgrid_2x3x2cell_primitive), intent(in) :: fluxes_y
    type(subgrid_2x2x3cell_primitive), intent(in) :: fluxes_z
    integer, value :: head_idx
    integer, value :: block_idx
    integer, value :: thread_idx
    integer, value :: ngridmax
    real(kind=dp), value :: dtdx
    real(kind=dp), parameter :: inv_twotondim = 1.0_dp / real(twotondim, kind=dp)

    integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: subgrid_idx, cell_idx, source_idx, father_idx, work_idx
    integer :: interface_array_size, info, ind_nbor
    type(conserved_t) :: flux
    real(kind=dp) :: coarse_flux_scale

    interface_array_size = nsubgrid**(ndim-1)
    coarse_flux_scale = dtdx * inv_twotondim

    ! Compute the oct index
    subgrid_idx = head_idx + block_idx

    !============
    ! X direction
    !============

    if (thread_idx < interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx
       call index_1Dto2D(work_idx, nsubgrid, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = 0
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = k_subgrid_idx + 1

       ! Compute left coarse X flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do j = 2*j_subgrid_idx - 2, 2*j_subgrid_idx - 1
          do k = 2*k_subgrid_idx - 2, 2*k_subgrid_idx - 1
             flux%density    = flux%density    - fluxes_x%density   (0, j, k) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x - fluxes_x%velocity_x(0, j, k) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y - fluxes_x%velocity_y(0, j, k) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z - fluxes_x%velocity_z(0, j, k) * coarse_flux_scale
             flux%energy     = flux%energy     - fluxes_x%pressure  (0, j, k) * coarse_flux_scale
          end do
       end do

       ! Update left coarse X cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    else if (thread_idx < 2 * interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx - interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = nsubgrid + 1
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = k_subgrid_idx + 1

       ! Compute right coarse X flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do j = 2*j_subgrid_idx - 2, 2*j_subgrid_idx - 1
          do k = 2*k_subgrid_idx - 2, 2*k_subgrid_idx - 1
             flux%density    = flux%density    + fluxes_x%density   (2*nsubgrid, j, k) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x + fluxes_x%velocity_x(2*nsubgrid, j, k) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y + fluxes_x%velocity_y(2*nsubgrid, j, k) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z + fluxes_x%velocity_z(2*nsubgrid, j, k) * coarse_flux_scale
             flux%energy     = flux%energy     + fluxes_x%pressure  (2*nsubgrid, j, k) * coarse_flux_scale
          end do
       end do

       ! Update right coarse X cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    !============
    ! Y direction
    !============

    else if (thread_idx < 3 * interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx - 2 * interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = 0
       k_subgrid_idx = k_subgrid_idx + 1

       ! Compute left coarse Y flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do i = 2*i_subgrid_idx - 2, 2*i_subgrid_idx - 1
          do k = 2*k_subgrid_idx - 2, 2*k_subgrid_idx - 1
             flux%density    = flux%density    - fluxes_y%density   (i, 0, k) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x - fluxes_y%velocity_x(i, 0, k) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y - fluxes_y%velocity_y(i, 0, k) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z - fluxes_y%velocity_z(i, 0, k) * coarse_flux_scale
             flux%energy     = flux%energy     - fluxes_y%pressure  (i, 0, k) * coarse_flux_scale
          end do
       end do
    
       ! Update left coarse Y cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    else if (thread_idx < 4 * interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx - 3 * interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = nsubgrid + 1
       k_subgrid_idx = k_subgrid_idx + 1

       ! Compute right coarse Y flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do i = 2*i_subgrid_idx - 2, 2*i_subgrid_idx - 1
          do k = 2*k_subgrid_idx - 2, 2*k_subgrid_idx - 1
             flux%density    = flux%density    + fluxes_y%density   (i, 2*nsubgrid, k) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x + fluxes_y%velocity_x(i, 2*nsubgrid, k) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y + fluxes_y%velocity_y(i, 2*nsubgrid, k) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z + fluxes_y%velocity_z(i, 2*nsubgrid, k) * coarse_flux_scale
             flux%energy     = flux%energy     + fluxes_y%pressure  (i, 2*nsubgrid, k) * coarse_flux_scale
          end do
       end do

       ! Update right coarse Y cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    !============
    ! Z direction
    !============

    else if (thread_idx < 5 * interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx - 4 * interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, j_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = 0

       ! Compute left coarse Z flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do i = 2*i_subgrid_idx - 2, 2*i_subgrid_idx - 1
          do j = 2*j_subgrid_idx - 2, 2*j_subgrid_idx - 1
             flux%density    = flux%density    - fluxes_z%density   (i, j, 0) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x - fluxes_z%velocity_x(i, j, 0) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y - fluxes_z%velocity_y(i, j, 0) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z - fluxes_z%velocity_z(i, j, 0) * coarse_flux_scale
             flux%energy     = flux%energy     - fluxes_z%pressure  (i, j, 0) * coarse_flux_scale
          end do
       end do
    
       ! Update left coarse Z cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    else if (thread_idx < 6 * interface_array_size) then

       ! Compute the subgrid indices in the interface
       work_idx = thread_idx - 5 * interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, j_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = nsubgrid + 1

       ! Compute right coarse Z flux
       flux%density    = 0_dp
       flux%momentum_x = 0_dp
       flux%momentum_y = 0_dp
       flux%momentum_z = 0_dp
       flux%energy     = 0_dp
       do i = 2*i_subgrid_idx - 2, 2*i_subgrid_idx - 1
          do j = 2*j_subgrid_idx - 2, 2*j_subgrid_idx - 1
             flux%density    = flux%density    + fluxes_z%density   (i, j, 2*nsubgrid) * coarse_flux_scale
             flux%momentum_x = flux%momentum_x + fluxes_z%velocity_x(i, j, 2*nsubgrid) * coarse_flux_scale
             flux%momentum_y = flux%momentum_y + fluxes_z%velocity_y(i, j, 2*nsubgrid) * coarse_flux_scale
             flux%momentum_z = flux%momentum_z + fluxes_z%velocity_z(i, j, 2*nsubgrid) * coarse_flux_scale
             flux%energy     = flux%energy     + fluxes_z%pressure  (i, j, 2*nsubgrid) * coarse_flux_scale
          end do
       end do

       ! Update right coarse Z cell if necessary
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx, 1, father_idx), flux%density)
          info = atomicadd(unew(cell_idx, 2, father_idx), flux%momentum_x)
          info = atomicadd(unew(cell_idx, 3, father_idx), flux%momentum_y)
          info = atomicadd(unew(cell_idx, 4, father_idx), flux%momentum_z)
          info = atomicadd(unew(cell_idx, 5, father_idx), flux%energy)
       endif

    end if

  end subroutine coarse_cell_update
  ! =========================================================================

#ifdef MHD
  ! #########################################################################
  ! ##  CUBE ("rock") MHD INTEGRATOR DEVICE ROUTINES (Stages B2-C6)        ##
  ! ##                                                                     ##
  ! ##  These are the MHD analogs of the hydro pipeline helpers above. Each##
  ! ##  loops over the whole 6^3 shared subgrid (NOT a z-plane ring); they ##
  ! ##  re-host the adversarially-verified plane-sweep physics from history##
  ! ##  (git show 6e6a715b:gpu/gpu_hydro.cuf -- mhd_ctoprim_fill/load_bfield##
  ! ##  /mhd_face_b_slopes/mhd_edge_emf/mhd_trace_predict) and the CPU      ##
  ! ##  originals in hydro/umuscl.f90 + hydro/godunov_fine.f90. Only the    ##
  ! ##  iteration structure changed: z-ring slot (slot,ic/im/ip) -> whole- ##
  ! ##  subgrid index k-1/k/k+1; the math/signs/floors are unchanged.       ##
  ! ##  EVERY working buffer lives in shared memory (B1 budget): the four   ##
  ! ##  corner states are stored only on the consumed oct-edge lattice (the ##
  ! ##  subgrid_*edge_corner family) and the face-B transverse slopes (dbf) ##
  ! ##  are recomputed inline from the shared bf (face_b_tvd_slope). The    ##
  ! ##  kernel therefore needs NO global scratch (the former per-block      ##
  ! ##  mhd_corner_scratch/mhd_dbf_scratch arrays scaled with the level's   ##
  ! ##  oct count -- ~174 KB/oct -- and are gone).                          ##
  ! #########################################################################

  ! =========================================================================
  !> @brief (Stage B2) Whole-subgrid MHD conserved->primitive + face-B fill.
  !> The MHD analog of subgrid_conserved_2_primitive: fills the 6^3 shared MHD
  !> primitive subgrid (local_mhd: rho,vx,vy,vz,P,Bx,By,Bz + refined), the passive
  !> scalar subgrid (scalar_sub, 1:nvar-5) and the face-centred B buffer (bf).
  !> Re-hosts mhd_ctoprim_fill + load_bfield (6e6a715b) / CPU ctoprim
  !> (umuscl.f90:1762-1879). The cube fill loop is copied verbatim from
  !> subgrid_conserved_2_primitive; the per-cell MHD body is the re-host.
  !>   * bf: the low-d face of cell (i,j,k) on axis d = 0.5*(bold(self,d) +
  !>     bold(low-d-neighbour, d+3)) -> single-valued at every face (divB).
  !>   * cell-centred B = 0.5*(bold(self,d)+bold(self,d+3)) per axis.
  !>   * pressure formed AFTER subtracting emag = 0.5*(Bx^2+By^2+Bz^2).
  !>   * passive scalars q(ie+n)=uold(5+n)/rho.
  attributes(device) subroutine subgrid_conserved_2_primitive_mhd(grid, uold, bold, f, &
       & constant_gravity, nbor, head_idx, block_idx, thread_idx, gamma, smallr, smallc, dt, local_mhd, scalar_sub, bf)
    type(oct), device :: grid(*)
    real(kind=8), device :: constant_gravity(3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), value :: head_idx, block_idx, thread_idx
    real(kind=dp), value :: gamma, smallr, smallc, dt
    type(subgrid_6x6x6cell_primitive_mhd), intent(inout) :: local_mhd
    real(kind=dp) :: scalar_sub(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3, 1:nvar-5)
    type(subgrid_face_b_t), intent(inout) :: bf

    integer :: work_idx, ind_nbor, ind_nbor_xm, ind_nbor_ym, ind_nbor_zm
    integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: cell_idx, source_idx, subgrid_idx, work_size, n
    real(kind=dp) :: invD, Ekin, emag, eint, smalle, Bxc, Byc, Bzc, rho
    real(kind=dp) :: b0(1:6)

    work_size = 2*nsubgrid+4

    do work_idx = thread_idx, work_size**3 - 1, blockDim%x

       ! Same subgrid traversal as subgrid_conserved_2_primitive: (i_subgrid_idx,
       ! j_subgrid_idx, k_subgrid_idx) is the oct, cell_idx the cell within it,
       ! (i,j,k) the destination cell in the 6^3 subgrid.
       call index_1Dto3D(work_idx/8, work_size/2, work_size/2, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx)
       subgrid_idx = head_idx + block_idx
       ind_nbor = work_idx/8 + 1
       source_idx = nbor(ind_nbor, subgrid_idx)
       cell_idx = mod(work_idx, 8) + 1
       call index_1Dto3D(cell_idx - 1, 2, 2, i, j, k)
       i = i + 2*i_subgrid_idx
       j = j + 2*j_subgrid_idx
       k = k + 2*k_subgrid_idx

       ! This cell's six raw face-B (bold comps 1-3 = low x/y/z, 4-6 = high x/y/z).
       b0(1) = bold(cell_idx, 1, source_idx)
       b0(2) = bold(cell_idx, 2, source_idx)
       b0(3) = bold(cell_idx, 3, source_idx)
       b0(4) = bold(cell_idx, 4, source_idx)
       b0(5) = bold(cell_idx, 5, source_idx)
       b0(6) = bold(cell_idx, 6, source_idx)

       ! Face-continuous low faces (CPU ctoprim:1768/1781/1794): a cell's low-d face
       ! = 0.5*(self_low_d + low-d-neighbour_high_d), keeping B single-valued at each
       ! face (divB). The low-d neighbour cell index = hhh(cell_idx,dir) and its oct
       ! offset = iii(cell_idx,dir) (dir 1=-x, 3=-y, 5=-z): offset 0 -> same oct,
       ! -1 -> the low-d neighbouring oct (fetched via the periodic nbor stencil,
       ! like load_bfield in 6e6a715b). The OUTERMOST low faces bx(0,*,*)/by(*,0,*)/
       ! bz(*,*,0) would need an oct outside the 3x3x3 nbor stencil; they are never
       ! read (edge_e reads bx at i>=1, by at j>=1, bz at k>=1; the trace reads
       ! bx/by/bz at index>=1), so we fill them with the cell's own low face -- a
       ! harmless unread value -- and skip the out-of-stencil oct fetch.
       ! Low-x face of this cell:
       if (i == 0) then
          bf%bx(i,j,k) = b0(1)
       else if (iii(cell_idx,1) == 0) then
          bf%bx(i,j,k) = 0.5_dp*(b0(1) + bold(hhh(cell_idx,1), 4, source_idx))
       else
          ind_nbor_xm = (i_subgrid_idx-1) + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx + 1
          bf%bx(i,j,k) = 0.5_dp*(b0(1) + bold(hhh(cell_idx,1), 4, nbor(ind_nbor_xm, subgrid_idx)))
       endif
       ! Low-y face of this cell:
       if (j == 0) then
          bf%by(i,j,k) = b0(2)
       else if (iii(cell_idx,3) == 0) then
          bf%by(i,j,k) = 0.5_dp*(b0(2) + bold(hhh(cell_idx,3), 5, source_idx))
       else
          ind_nbor_ym = i_subgrid_idx + nsubgridp2*(j_subgrid_idx-1) + nsubgridp2sq*k_subgrid_idx + 1
          bf%by(i,j,k) = 0.5_dp*(b0(2) + bold(hhh(cell_idx,3), 5, nbor(ind_nbor_ym, subgrid_idx)))
       endif
       ! Low-z face of this cell:
       if (k == 0) then
          bf%bz(i,j,k) = b0(3)
       else if (iii(cell_idx,5) == 0) then
          bf%bz(i,j,k) = 0.5_dp*(b0(3) + bold(hhh(cell_idx,5), 6, source_idx))
       else
          ind_nbor_zm = i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*(k_subgrid_idx-1) + 1
          bf%bz(i,j,k) = 0.5_dp*(b0(3) + bold(hhh(cell_idx,5), 6, nbor(ind_nbor_zm, subgrid_idx)))
       endif

       ! Cell-centred B = average of the two opposing faces of THIS cell.
       Bxc = 0.5_dp*(b0(1) + b0(4))
       Byc = 0.5_dp*(b0(2) + b0(5))
       Bzc = 0.5_dp*(b0(3) + b0(6))

       ! Hydro conversion + MHD energy correction (CPU ctoprim:1804-1845).
       ! Floor density and internal energy before trace/source terms see them.
       rho  = max(uold(cell_idx, 1, source_idx), smallr)
       invD = 1.0_dp / rho
       local_mhd%density   (i, j, k) = rho
       local_mhd%velocity_x(i, j, k) = uold(cell_idx, 2, source_idx) * invD
       local_mhd%velocity_y(i, j, k) = uold(cell_idx, 3, source_idx) * invD
       local_mhd%velocity_z(i, j, k) = uold(cell_idx, 4, source_idx) * invD
       Ekin = 0.5_dp*( uold(cell_idx,2,source_idx)*local_mhd%velocity_x(i,j,k) + &
            &          uold(cell_idx,3,source_idx)*local_mhd%velocity_y(i,j,k) + &
            &          uold(cell_idx,4,source_idx)*local_mhd%velocity_z(i,j,k) )
       emag = 0.5_dp*( Bxc*Bxc + (Byc*Byc + Bzc*Bzc) )
       smalle = smallc**2/gamma/(gamma - 1.0_dp)
       eint = max(uold(cell_idx,5,source_idx) - Ekin - emag, smalle*rho)
       local_mhd%pressure(i, j, k) = (gamma - 1.0_dp)*eint
       local_mhd%Bx(i, j, k) = Bxc
       local_mhd%By(i, j, k) = Byc
       local_mhd%Bz(i, j, k) = Bzc

       ! Gravity predictor (mirrors subgrid_conserved_2_primitive).
#ifdef GRAV
       local_mhd%velocity_x(i,j,k) = local_mhd%velocity_x(i,j,k) + f(cell_idx,1,source_idx)*0.5_dp*dt
       local_mhd%velocity_y(i,j,k) = local_mhd%velocity_y(i,j,k) + f(cell_idx,2,source_idx)*0.5_dp*dt
       local_mhd%velocity_z(i,j,k) = local_mhd%velocity_z(i,j,k) + f(cell_idx,3,source_idx)*0.5_dp*dt
#else
       local_mhd%velocity_x(i,j,k) = local_mhd%velocity_x(i,j,k) + constant_gravity(1)*0.5_dp*dt
       local_mhd%velocity_y(i,j,k) = local_mhd%velocity_y(i,j,k) + constant_gravity(2)*0.5_dp*dt
       local_mhd%velocity_z(i,j,k) = local_mhd%velocity_z(i,j,k) + constant_gravity(3)*0.5_dp*dt
#endif

       ! Passive scalars q(ie+n) = uold(5+n)/rho (CPU ctoprim:1870-1879).
       do n = 1, nvar-5
          scalar_sub(i, j, k, n) = uold(cell_idx, 5+n, source_idx) * invD
       end do

       local_mhd%refined(i, j, k) = grid(source_idx)%refined(cell_idx)

    end do

    call syncthreads()

  end subroutine subgrid_conserved_2_primitive_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage B3) Face-B transverse TVD slope (CPU dbf). The MHD-only
  !> slope with no hydro analog: a pure 3-point limiter on the face-centred B,
  !> the inline dbf branch of CPU uslope (umuscl.f90:2255-2333), selected at
  !> runtime by slope_mag (0: first order -> zero slope). Returns a RAW
  !> value-slope (no 1/dx, no 1/2). The trace (C1) calls this inline on the
  !> shared bf for the 12 face-slopes each cell consumes -- dbf is never
  !> stored (the former whole-subgrid mhd_dbf_scratch global spill is gone;
  !> recomputing from shared is cheaper than a global round-trip).
  !>
  !> @param[in] bm, b0, bp  : face-B at the stencil points (t-1, t, t+1) along
  !>                          the transverse direction of the slope
  !> @param[in] slope_mag   : magnetic slope limiter id (slope_mag_type)
  attributes(device) function face_b_tvd_slope(bm, b0, bp, slope_mag) result(db)
    real(kind=dp), value :: bm, b0, bp
    integer, value :: slope_mag
    real(kind=dp) :: db
    real(kind=dp) :: dlft, drgt, dcen, dsgn, slop, dlim, fac
    real(kind=dp), parameter :: half = 0.5_dp, zero = 0.0_dp, one = 1.0_dp

    if (slope_mag == 0) then
       db = zero
       return
    end if
    fac = real(min(slope_mag,2), kind=dp)
    dlft = fac*(b0 - bm)
    drgt = fac*(bp - b0)
    dcen = half*(dlft+drgt)/fac; dsgn = sign(one, dcen)
    slop = min(abs(dlft),abs(drgt)); dlim = merge(zero, slop, (dlft*drgt) <= zero)
    db = dsgn*min(dlim,abs(dcen))
  end function face_b_tvd_slope
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage B3, v4.1) Compute the limited TVD slopes of cell (ix,iy,k) in
  !> all three directions for the full MHD primitive set (rho, v, P, cell-centred
  !> B) and the passive scalars. The MHD analog of compute_tvd_slopes: a dedicated
  !> device function called once per cell from trace_3d_mhd (C1), replacing the
  !> former inline slope_moncen block. Slopes carry the half*dq convention (the
  !> 0.5 factor is applied here), == CPU uslope half*dq, like the hydro trace.
  !> All three B slopes are returned per direction (mirroring CPU uslope, which
  !> limits every primitive); the trace consumes only the transverse ones (the
  !> normal B is face-predicted).
  !>
  !> @param[in] local_mhd : The MHD subgrid of primitive variables
  !> @param[in] scalar_sub : The passive-scalar subgrid (1:nvar-5)
  !> @param[in] ix, iy, k : The cell indices within the subgrid
  !> @param[in] slope : The slope limiter id (0: 1st order, 1: minmod, 2: moncen)
  !> @param[out] slopes_x, slopes_y, slopes_z : The limited half*dq slopes
  !> @param[out] dscal_x, dscal_y, dscal_z : The limited half*dq scalar slopes
  attributes(device) subroutine compute_tvd_slopes_mhd(local_mhd, scalar_sub, ix, iy, k, slope, &
       & slopes_x, slopes_y, slopes_z, dscal_x, dscal_y, dscal_z)
    type(subgrid_6x6x6cell_primitive_mhd), intent(in) :: local_mhd
    real(kind=dp), intent(in) :: scalar_sub(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3, 1:nvar-5)
    integer, value :: ix, iy, k, slope
    type(primitive_mhd_t), intent(out) :: slopes_x, slopes_y, slopes_z
    real(kind=dp), intent(out) :: dscal_x(1:nvar-5), dscal_y(1:nvar-5), dscal_z(1:nvar-5)

    real(kind=dp), parameter :: half = 0.5_dp
    real(kind=dp) :: r, u, v, w, p, A, B, C, rscal
    integer :: n

    ! Cell centered (middle) values
    r = local_mhd%density   (ix,iy,k)
    u = local_mhd%velocity_x(ix,iy,k)
    v = local_mhd%velocity_y(ix,iy,k)
    w = local_mhd%velocity_z(ix,iy,k)
    p = local_mhd%pressure  (ix,iy,k)
    A = local_mhd%Bx(ix,iy,k)
    B = local_mhd%By(ix,iy,k)
    C = local_mhd%Bz(ix,iy,k)

    slopes_x%density    = half*slope_moncen(local_mhd%density   (ix-1,iy,k), r, local_mhd%density   (ix+1,iy,k), slope)
    slopes_x%velocity_x = half*slope_moncen(local_mhd%velocity_x(ix-1,iy,k), u, local_mhd%velocity_x(ix+1,iy,k), slope)
    slopes_x%velocity_y = half*slope_moncen(local_mhd%velocity_y(ix-1,iy,k), v, local_mhd%velocity_y(ix+1,iy,k), slope)
    slopes_x%velocity_z = half*slope_moncen(local_mhd%velocity_z(ix-1,iy,k), w, local_mhd%velocity_z(ix+1,iy,k), slope)
    slopes_x%pressure   = half*slope_moncen(local_mhd%pressure  (ix-1,iy,k), p, local_mhd%pressure  (ix+1,iy,k), slope)
    slopes_x%Bx         = half*slope_moncen(local_mhd%Bx(ix-1,iy,k), A, local_mhd%Bx(ix+1,iy,k), slope)
    slopes_x%By         = half*slope_moncen(local_mhd%By(ix-1,iy,k), B, local_mhd%By(ix+1,iy,k), slope)
    slopes_x%Bz         = half*slope_moncen(local_mhd%Bz(ix-1,iy,k), C, local_mhd%Bz(ix+1,iy,k), slope)

    slopes_y%density    = half*slope_moncen(local_mhd%density   (ix,iy-1,k), r, local_mhd%density   (ix,iy+1,k), slope)
    slopes_y%velocity_x = half*slope_moncen(local_mhd%velocity_x(ix,iy-1,k), u, local_mhd%velocity_x(ix,iy+1,k), slope)
    slopes_y%velocity_y = half*slope_moncen(local_mhd%velocity_y(ix,iy-1,k), v, local_mhd%velocity_y(ix,iy+1,k), slope)
    slopes_y%velocity_z = half*slope_moncen(local_mhd%velocity_z(ix,iy-1,k), w, local_mhd%velocity_z(ix,iy+1,k), slope)
    slopes_y%pressure   = half*slope_moncen(local_mhd%pressure  (ix,iy-1,k), p, local_mhd%pressure  (ix,iy+1,k), slope)
    slopes_y%Bx         = half*slope_moncen(local_mhd%Bx(ix,iy-1,k), A, local_mhd%Bx(ix,iy+1,k), slope)
    slopes_y%By         = half*slope_moncen(local_mhd%By(ix,iy-1,k), B, local_mhd%By(ix,iy+1,k), slope)
    slopes_y%Bz         = half*slope_moncen(local_mhd%Bz(ix,iy-1,k), C, local_mhd%Bz(ix,iy+1,k), slope)

    slopes_z%density    = half*slope_moncen(local_mhd%density   (ix,iy,k-1), r, local_mhd%density   (ix,iy,k+1), slope)
    slopes_z%velocity_x = half*slope_moncen(local_mhd%velocity_x(ix,iy,k-1), u, local_mhd%velocity_x(ix,iy,k+1), slope)
    slopes_z%velocity_y = half*slope_moncen(local_mhd%velocity_y(ix,iy,k-1), v, local_mhd%velocity_y(ix,iy,k+1), slope)
    slopes_z%velocity_z = half*slope_moncen(local_mhd%velocity_z(ix,iy,k-1), w, local_mhd%velocity_z(ix,iy,k+1), slope)
    slopes_z%pressure   = half*slope_moncen(local_mhd%pressure  (ix,iy,k-1), p, local_mhd%pressure  (ix,iy,k+1), slope)
    slopes_z%Bx         = half*slope_moncen(local_mhd%Bx(ix,iy,k-1), A, local_mhd%Bx(ix,iy,k+1), slope)
    slopes_z%By         = half*slope_moncen(local_mhd%By(ix,iy,k-1), B, local_mhd%By(ix,iy,k+1), slope)
    slopes_z%Bz         = half*slope_moncen(local_mhd%Bz(ix,iy,k-1), C, local_mhd%Bz(ix,iy,k+1), slope)

    ! Passive-scalar slopes (consumed by the scalar advection predictor, C1)
    do n = 1, nvar-5
       rscal = scalar_sub(ix,iy,k,n)
       dscal_x(n) = half*slope_moncen(scalar_sub(ix-1,iy,k,n), rscal, scalar_sub(ix+1,iy,k,n), slope)
       dscal_y(n) = half*slope_moncen(scalar_sub(ix,iy-1,k,n), rscal, scalar_sub(ix,iy+1,k,n), slope)
       dscal_z(n) = half*slope_moncen(scalar_sub(ix,iy,k-1,n), rscal, scalar_sub(ix,iy,k+1,n), slope)
    end do

  end subroutine compute_tvd_slopes_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C1) Whole-subgrid MHD trace: edge-E, MUSCL predictor, face-B
  !> prediction, 6-face qm/qp interface states, and the four edge corner states.
  !> The MHD analog of trace_3d. Two phases over the shared subgrid with a sync
  !> between (the predictor needs edge-E at planes k and k+1):
  !>   Phase 1 -- raw edge-centred E (Ex,Ey,Ez) over [1,2*nsubgrid+3] (re-host of
  !>     mhd_edge_emf / CPU trace3d:935-951): Ex=v*C-w*B, Ey=w*A-u*C, Ez=u*B-v*A,
  !>     with 4-cell velocity averages and 2-face B averages. RAW (no dt/dx).
  !>     Each component is stored only over its exact anisotropic extent (the
  !>     subgrid_edge_e_t shapes) -- the guarded-out values were never read.
  !>   Phase 2 -- predictor + corners over [1,2*nsubgrid+2] (re-host of
  !>     mhd_trace_predict / CPU trace3d:956-1448). Cell + scalar slopes come from
  !>     the dedicated compute_tvd_slopes_mhd device function (B3, v4.1; half*dq);
  !>     the 12 face-B transverse slopes (CPU dbf) are recomputed inline from the
  !>     shared bf via face_b_tvd_slope (B3) -- nothing is staged in global
  !>     memory. Face-B predicted by the discrete curl of edge-E (single-valued
  !>     normal B keeps divB clean); qm/qp written to the widened interface
  !>     arrays with the same guards as trace_3d; each corner state is written
  !>     into the slot of the ONE oct edge that consumes it (the shared
  !>     subgrid_*edge_corner buffers, guarded to the consumed edge lattice --
  !>     the write-side inverse of the CPU cmp_mag_flx gather shifts).
  !> induction=.true. zeroes the velocity source terms (kinematic-dynamo mode).
  !> The CPU floor typo at umuscl.f90:1284 (qLB X-edge pressure-floor writes the
  !> density slot) is reproduced verbatim (flagged below) for bit-level CPU match.
  attributes(device) subroutine trace_3d_mhd(local_mhd, scalar_sub, bf, edge_e, &
       & corner_x, corner_y, corner_z, thread_idx, &
       & left_x, right_x, left_y, right_y, left_z, right_z, gamma, smallr, smallc, &
       & dx, dt, slope, slope_mag, induction)
    type(subgrid_6x6x6cell_primitive_mhd), intent(in) :: local_mhd
    real(kind=dp) :: scalar_sub(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3, 1:nvar-5)
    type(subgrid_face_b_t), intent(in) :: bf
    type(subgrid_edge_e_t), intent(inout) :: edge_e
    type(subgrid_2x3x3edge_corner), intent(inout) :: corner_x
    type(subgrid_3x2x3edge_corner), intent(inout) :: corner_y
    type(subgrid_3x3x2edge_corner), intent(inout) :: corner_z
    integer, value :: thread_idx, slope, slope_mag
    real(kind=dp), value :: gamma, smallr, smallc, dx, dt
    logical, value :: induction
    type(subgrid_3x2x2cell_primitive_mhd), intent(inout) :: left_x, right_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(inout) :: left_y, right_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(inout) :: left_z, right_z

    real(kind=dp), parameter :: half = 0.5_dp
    integer, parameter :: iqLL = 1, iqRL = 2, iqLR = 3, iqRR = 4
    real(kind=dp) :: r, u, v, w, p, A, B, C, r0, p0, dtdx, smallp, rscal
    real(kind=dp) :: drx,dux,dvx,dwx,dpx, dry,duy,dvy,dwy,dpy, drz,duz,dvz,dwz,dpz
    real(kind=dp) :: dBx,dCx, dAy,dCy, dAz,dBz
    type(primitive_mhd_t) :: slopes_x, slopes_y, slopes_z
    real(kind=dp) :: dscal_x(1:nvar-5), dscal_y(1:nvar-5), dscal_z(1:nvar-5)
    real(kind=dp) :: AL,AR,BL,BR,CL,CR
    real(kind=dp) :: dALy,dARy,dALz,dARz,dBLx,dBRx,dBLz,dBRz,dCLx,dCRx,dCLy,dCRy
    real(kind=dp) :: sAL0,sAR0,sBL0,sBR0,sCL0,sCR0
    real(kind=dp) :: ELL,ELR,ERL,ERR,FLL,FLR,FRL,FRR,GLL,GLR,GRL,GRR
    real(kind=dp) :: sr0,su0,sv0,sw0,sp0, uu,vv,ww,Aa,Bb,Cc
    logical :: okp_x, okm_x, oka_x, okp_y, okm_y, oka_y, okp_z, okm_z, oka_z
    integer :: work_idx, work_size, ix, iy, k, n

    dtdx = dt/dx
    smallp = smallr*smallc*smallc

    ! ====================================================================
    ! Phase 1: raw edge-centred E over [1, 2*nsubgrid+3] (CPU trace3d:935-951).
    ! Each component is computed only over the exact anisotropic extent of
    ! subgrid_edge_e_t (one short along its own axis) -- phase 2 reads Ex at
    ! (ix, iy..iy+1, k..k+1) for ix,iy,k <= 2*nsubgrid+2, so Ex beyond
    ! 2*nsubgrid+2 along x (and cyclically for Ey/Ez) was never consumed.
    ! ====================================================================
    work_size = 2*nsubgrid+3
    do work_idx = thread_idx, work_size**3 - 1, blockDim%x
       call index_1Dto3D(work_idx, work_size, work_size, ix, iy, k)
       ix = ix + 1; iy = iy + 1; k = k + 1

       ! Ex(ix,iy,k) = v*C - w*B   (x-edge at (i,j-1/2,k-1/2); averages over k-1,k)
       if (ix <= 2*nsubgrid+2) then
          vv = 0.25_dp*( local_mhd%velocity_y(ix,iy-1,k-1) + local_mhd%velocity_y(ix,iy-1,k) + &
               &         local_mhd%velocity_y(ix,iy  ,k-1) + local_mhd%velocity_y(ix,iy  ,k) )
          ww = 0.25_dp*( local_mhd%velocity_z(ix,iy-1,k-1) + local_mhd%velocity_z(ix,iy-1,k) + &
               &         local_mhd%velocity_z(ix,iy  ,k-1) + local_mhd%velocity_z(ix,iy  ,k) )
          Bb = 0.5_dp*( bf%by(ix,iy  ,k-1) + bf%by(ix,iy  ,k) )
          Cc = 0.5_dp*( bf%bz(ix,iy-1,k  ) + bf%bz(ix,iy  ,k) )
          edge_e%Ex(ix,iy,k) = vv*Cc - ww*Bb
       end if

       ! Ey(ix,iy,k) = w*A - u*C   (y-edge at (i-1/2,j,k-1/2); averages over k-1,k)
       if (iy <= 2*nsubgrid+2) then
          uu = 0.25_dp*( local_mhd%velocity_x(ix-1,iy,k-1) + local_mhd%velocity_x(ix-1,iy,k) + &
               &         local_mhd%velocity_x(ix  ,iy,k-1) + local_mhd%velocity_x(ix  ,iy,k) )
          ww = 0.25_dp*( local_mhd%velocity_z(ix-1,iy,k-1) + local_mhd%velocity_z(ix-1,iy,k) + &
               &         local_mhd%velocity_z(ix  ,iy,k-1) + local_mhd%velocity_z(ix  ,iy,k) )
          Aa = 0.5_dp*( bf%bx(ix  ,iy,k-1) + bf%bx(ix,iy,k) )
          Cc = 0.5_dp*( bf%bz(ix-1,iy,k  ) + bf%bz(ix,iy,k) )
          edge_e%Ey(ix,iy,k) = ww*Aa - uu*Cc
       end if

       ! Ez(ix,iy,k) = u*B - v*A   (z-edge at (i-1/2,j-1/2,k); in-plane)
       if (k <= 2*nsubgrid+2) then
          uu = 0.25_dp*( local_mhd%velocity_x(ix-1,iy-1,k) + local_mhd%velocity_x(ix-1,iy,k) + &
               &         local_mhd%velocity_x(ix  ,iy-1,k) + local_mhd%velocity_x(ix  ,iy,k) )
          vv = 0.25_dp*( local_mhd%velocity_y(ix-1,iy-1,k) + local_mhd%velocity_y(ix-1,iy,k) + &
               &         local_mhd%velocity_y(ix  ,iy-1,k) + local_mhd%velocity_y(ix  ,iy,k) )
          Aa = 0.5_dp*( bf%bx(ix,iy-1,k) + bf%bx(ix,iy,k) )
          Bb = 0.5_dp*( bf%by(ix-1,iy,k) + bf%by(ix,iy,k) )
          edge_e%Ez(ix,iy,k) = uu*Bb - vv*Aa
       end if
    end do

    call syncthreads()

    ! ====================================================================
    ! Phase 2: cell predictor + corner states over [1, 2*nsubgrid+2].
    ! ====================================================================
    work_size = 2*nsubgrid+2
    do work_idx = thread_idx, work_size**3 - 1, blockDim%x
       call index_1Dto3D(work_idx, work_size, work_size, ix, iy, k)
       ix = ix + 1; iy = iy + 1; k = k + 1

       ! ---- Face-centred B values (CPU trace3d:961-966) -----------------------
       AL = bf%bx(ix  ,iy  ,k  )
       AR = bf%bx(ix+1,iy  ,k  )
       BL = bf%by(ix  ,iy  ,k  )
       BR = bf%by(ix  ,iy+1,k  )
       CL = bf%bz(ix  ,iy  ,k  )
       CR = bf%bz(ix  ,iy  ,k+1)

       ! ---- Face-centred transverse slopes (0.5*dbf; CPU trace3d:969-982) -----
       ! Recomputed inline from the shared bf via face_b_tvd_slope (B3) -- the
       ! CPU stages these in h%dbf / the old GPU spilled them to global scratch;
       ! they are a pure 3-point function of bf, so recomputing the 12 values
       ! this cell needs is cheaper than a global round-trip. Slope axes follow
       ! CPU uslope (umuscl.f90:2255-2333): dbx along y/z, dby along x/z,
       ! dbz along x/y; L/R = the cell's low/high face on the component's axis.
       dALy = half*face_b_tvd_slope(bf%bx(ix  ,iy-1,k), bf%bx(ix  ,iy,k), bf%bx(ix  ,iy+1,k), slope_mag)
       dARy = half*face_b_tvd_slope(bf%bx(ix+1,iy-1,k), bf%bx(ix+1,iy,k), bf%bx(ix+1,iy+1,k), slope_mag)
       dALz = half*face_b_tvd_slope(bf%bx(ix  ,iy,k-1), bf%bx(ix  ,iy,k), bf%bx(ix  ,iy,k+1), slope_mag)
       dARz = half*face_b_tvd_slope(bf%bx(ix+1,iy,k-1), bf%bx(ix+1,iy,k), bf%bx(ix+1,iy,k+1), slope_mag)
       dBLx = half*face_b_tvd_slope(bf%by(ix-1,iy  ,k), bf%by(ix,iy  ,k), bf%by(ix+1,iy  ,k), slope_mag)
       dBRx = half*face_b_tvd_slope(bf%by(ix-1,iy+1,k), bf%by(ix,iy+1,k), bf%by(ix+1,iy+1,k), slope_mag)
       dBLz = half*face_b_tvd_slope(bf%by(ix,iy  ,k-1), bf%by(ix,iy  ,k), bf%by(ix,iy  ,k+1), slope_mag)
       dBRz = half*face_b_tvd_slope(bf%by(ix,iy+1,k-1), bf%by(ix,iy+1,k), bf%by(ix,iy+1,k+1), slope_mag)
       dCLx = half*face_b_tvd_slope(bf%bz(ix-1,iy,k  ), bf%bz(ix,iy,k  ), bf%bz(ix+1,iy,k  ), slope_mag)
       dCRx = half*face_b_tvd_slope(bf%bz(ix-1,iy,k+1), bf%bz(ix,iy,k+1), bf%bz(ix+1,iy,k+1), slope_mag)
       dCLy = half*face_b_tvd_slope(bf%bz(ix,iy-1,k  ), bf%bz(ix,iy,k  ), bf%bz(ix,iy+1,k  ), slope_mag)
       dCRy = half*face_b_tvd_slope(bf%bz(ix,iy-1,k+1), bf%bz(ix,iy,k+1), bf%bz(ix,iy+1,k+1), slope_mag)

       ! ---- Edge-centred E gathered (CPU trace3d:985-1000) --------------------
       ELL = edge_e%Ex(ix  ,iy  ,k  ); ELR = edge_e%Ex(ix  ,iy  ,k+1)
       ERL = edge_e%Ex(ix  ,iy+1,k  ); ERR = edge_e%Ex(ix  ,iy+1,k+1)
       FLL = edge_e%Ey(ix  ,iy  ,k  ); FLR = edge_e%Ey(ix  ,iy  ,k+1)
       FRL = edge_e%Ey(ix+1,iy  ,k  ); FRR = edge_e%Ey(ix+1,iy  ,k+1)
       GLL = edge_e%Ez(ix  ,iy  ,k  ); GLR = edge_e%Ez(ix  ,iy+1,k  )
       GRL = edge_e%Ez(ix+1,iy  ,k  ); GRR = edge_e%Ez(ix+1,iy+1,k  )

       ! ---- Face-B predicted by discrete curl of edge-E (CPU trace3d:1003-1015)
       sAL0 = + (GLR-GLL) - (FLR-FLL)
       sAR0 = + (GRR-GRL) - (FRR-FRL)
       sBL0 = - (GRL-GLL) + (ELR-ELL)
       sBR0 = - (GRR-GLR) + (ERR-ERL)
       sCL0 = + (FRL-FLL) - (ERL-ELL)
       sCR0 = + (FRR-FLR) - (ERR-ELR)
       AL = AL + sAL0*dtdx*half
       AR = AR + sAR0*dtdx*half
       BL = BL + sBL0*dtdx*half
       BR = BR + sBR0*dtdx*half
       CL = CL + sCL0*dtdx*half
       CR = CR + sCR0*dtdx*half

       ! ---- Cell-centred values + TVD slopes (compute_tvd_slopes_mhd, v4.1) ---
       r = local_mhd%density   (ix,iy,k); r0 = r
       u = local_mhd%velocity_x(ix,iy,k)
       v = local_mhd%velocity_y(ix,iy,k)
       w = local_mhd%velocity_z(ix,iy,k)
       p = local_mhd%pressure  (ix,iy,k); p0 = p
       A = local_mhd%Bx(ix,iy,k)
       B = local_mhd%By(ix,iy,k)
       C = local_mhd%Bz(ix,iy,k)
       call compute_tvd_slopes_mhd(local_mhd, scalar_sub, ix, iy, k, slope, &
            & slopes_x, slopes_y, slopes_z, dscal_x, dscal_y, dscal_z)
       ! Unpack into the CPU trace3d slope names (transverse B only; the normal
       ! B is face-predicted, so slopes_x%Bx / slopes_y%By / slopes_z%Bz unused).
       drx = slopes_x%density;    dry = slopes_y%density;    drz = slopes_z%density
       dux = slopes_x%velocity_x; duy = slopes_y%velocity_x; duz = slopes_z%velocity_x
       dvx = slopes_x%velocity_y; dvy = slopes_y%velocity_y; dvz = slopes_z%velocity_y
       dwx = slopes_x%velocity_z; dwy = slopes_y%velocity_z; dwz = slopes_z%velocity_z
       dpx = slopes_x%pressure;   dpy = slopes_y%pressure;   dpz = slopes_z%pressure
       dBx = slopes_x%By;         dAy = slopes_y%Bx;         dAz = slopes_z%Bx
       dCx = slopes_x%Bz;         dCy = slopes_y%Bz;         dBz = slopes_z%By

       ! ---- Source terms incl. Lorentz force (CPU trace3d:1077-1090) ----------
       sr0 = -u*drx-v*dry-w*drz - (dux+dvy+dwz)*r
       su0 = -u*dux-v*duy-w*duz - (dpx)/r
       sv0 = -u*dvx-v*dvy-w*dvz - (dpy)/r
       sw0 = -u*dwx-v*dwy-w*dwz - (dpz)/r
       sp0 = -u*dpx-v*dpy-w*dpz - (dux+dvy+dwz)*gamma*p
       su0 = su0 + (-(B*dBx+C*dCx)/r) + (B*dAy/r) + (C*dAz/r)
       sv0 = sv0 + (A*dBx/r) + (-(A*dAy+C*dCy)/r) + (C*dBz/r)
       sw0 = sw0 + (A*dCx/r) + (B*dCy/r) + (-(A*dAz+B*dBz)/r)
       if (induction) then
          su0 = 0.0_dp; sv0 = 0.0_dp; sw0 = 0.0_dp
       end if

       ! ---- Cell-centred predicted states (CPU trace3d:1102-1110) -------------
       r = r + sr0*dtdx
       u = u + su0*dtdx
       v = v + sv0*dtdx
       w = w + sw0*dtdx
       p = p + sp0*dtdx
       A = half*(AL+AR)
       B = half*(BL+BR)
       C = half*(CL+CR)

       ! ---- X faces: qp(low-x)->right_x(ix-2), qm(high-x)->left_x(ix-1) -------
       if (ix > 1 .and. (iy > 1 .and. iy < work_size) .and. (k > 1 .and. k < work_size)) then
          right_x%density   (ix-2,iy-2,k-2) = r - drx
          right_x%velocity_x(ix-2,iy-2,k-2) = u - dux
          right_x%velocity_y(ix-2,iy-2,k-2) = v - dvx
          right_x%velocity_z(ix-2,iy-2,k-2) = w - dwx
          right_x%pressure  (ix-2,iy-2,k-2) = p - dpx
          if (right_x%density (ix-2,iy-2,k-2) < smallr) right_x%density (ix-2,iy-2,k-2) = r0
          if (right_x%pressure(ix-2,iy-2,k-2) < smallp) right_x%pressure(ix-2,iy-2,k-2) = p0
          right_x%Bx(ix-2,iy-2,k-2) = AL
          right_x%By(ix-2,iy-2,k-2) = B - dBx
          right_x%Bz(ix-2,iy-2,k-2) = C - dCx
       end if
       if (ix < work_size .and. (iy > 1 .and. iy < work_size) .and. (k > 1 .and. k < work_size)) then
          left_x%density   (ix-1,iy-2,k-2) = r + drx
          left_x%velocity_x(ix-1,iy-2,k-2) = u + dux
          left_x%velocity_y(ix-1,iy-2,k-2) = v + dvx
          left_x%velocity_z(ix-1,iy-2,k-2) = w + dwx
          left_x%pressure  (ix-1,iy-2,k-2) = p + dpx
          if (left_x%density (ix-1,iy-2,k-2) < smallr) left_x%density (ix-1,iy-2,k-2) = r0
          if (left_x%pressure(ix-1,iy-2,k-2) < smallp) left_x%pressure(ix-1,iy-2,k-2) = p0
          left_x%Bx(ix-1,iy-2,k-2) = AR
          left_x%By(ix-1,iy-2,k-2) = B + dBx
          left_x%Bz(ix-1,iy-2,k-2) = C + dCx
       end if

       ! ---- Y faces: qp(low-y)->right_y(iy-2), qm(high-y)->left_y(iy-1) -------
       if ((ix > 1 .and. ix < work_size) .and. iy > 1 .and. (k > 1 .and. k < work_size)) then
          right_y%density   (ix-2,iy-2,k-2) = r - dry
          right_y%velocity_x(ix-2,iy-2,k-2) = u - duy
          right_y%velocity_y(ix-2,iy-2,k-2) = v - dvy
          right_y%velocity_z(ix-2,iy-2,k-2) = w - dwy
          right_y%pressure  (ix-2,iy-2,k-2) = p - dpy
          if (right_y%density (ix-2,iy-2,k-2) < smallr) right_y%density (ix-2,iy-2,k-2) = r0
          if (right_y%pressure(ix-2,iy-2,k-2) < smallp) right_y%pressure(ix-2,iy-2,k-2) = p0
          right_y%Bx(ix-2,iy-2,k-2) = A - dAy
          right_y%By(ix-2,iy-2,k-2) = BL
          right_y%Bz(ix-2,iy-2,k-2) = C - dCy
       end if
       if ((ix > 1 .and. ix < work_size) .and. iy < work_size .and. (k > 1 .and. k < work_size)) then
          left_y%density   (ix-2,iy-1,k-2) = r + dry
          left_y%velocity_x(ix-2,iy-1,k-2) = u + duy
          left_y%velocity_y(ix-2,iy-1,k-2) = v + dvy
          left_y%velocity_z(ix-2,iy-1,k-2) = w + dwy
          left_y%pressure  (ix-2,iy-1,k-2) = p + dpy
          if (left_y%density (ix-2,iy-1,k-2) < smallr) left_y%density (ix-2,iy-1,k-2) = r0
          if (left_y%pressure(ix-2,iy-1,k-2) < smallp) left_y%pressure(ix-2,iy-1,k-2) = p0
          left_y%Bx(ix-2,iy-1,k-2) = A + dAy
          left_y%By(ix-2,iy-1,k-2) = BR
          left_y%Bz(ix-2,iy-1,k-2) = C + dCy
       end if

       ! ---- Z faces: qp(low-z)->right_z(k-2), qm(high-z)->left_z(k-1) ---------
       if ((ix > 1 .and. ix < work_size) .and. (iy > 1 .and. iy < work_size) .and. k > 1) then
          right_z%density   (ix-2,iy-2,k-2) = r - drz
          right_z%velocity_x(ix-2,iy-2,k-2) = u - duz
          right_z%velocity_y(ix-2,iy-2,k-2) = v - dvz
          right_z%velocity_z(ix-2,iy-2,k-2) = w - dwz
          right_z%pressure  (ix-2,iy-2,k-2) = p - dpz
          if (right_z%density (ix-2,iy-2,k-2) < smallr) right_z%density (ix-2,iy-2,k-2) = r0
          if (right_z%pressure(ix-2,iy-2,k-2) < smallp) right_z%pressure(ix-2,iy-2,k-2) = p0
          right_z%Bx(ix-2,iy-2,k-2) = A - dAz
          right_z%By(ix-2,iy-2,k-2) = B - dBz
          right_z%Bz(ix-2,iy-2,k-2) = CL
       end if
       if ((ix > 1 .and. ix < work_size) .and. (iy > 1 .and. iy < work_size) .and. k < work_size) then
          left_z%density   (ix-2,iy-2,k-1) = r + drz
          left_z%velocity_x(ix-2,iy-2,k-1) = u + duz
          left_z%velocity_y(ix-2,iy-2,k-1) = v + dvz
          left_z%velocity_z(ix-2,iy-2,k-1) = w + dwz
          left_z%pressure  (ix-2,iy-2,k-1) = p + dpz
          if (left_z%density (ix-2,iy-2,k-1) < smallr) left_z%density (ix-2,iy-2,k-1) = r0
          if (left_z%pressure(ix-2,iy-2,k-1) < smallp) left_z%pressure(ix-2,iy-2,k-1) = p0
          left_z%Bx(ix-2,iy-2,k-1) = A + dAz
          left_z%By(ix-2,iy-2,k-1) = B + dBz
          left_z%Bz(ix-2,iy-2,k-1) = CR
       end if

       ! ---- Corner-state edge-feed guards -------------------------------------
       ! Each cell corner is consumed by exactly ONE oct edge, so it is stored
       ! straight into that edge's slot of the shared corner_x/y/z buffers (the
       ! write-side inverse of the CPU cmp_mag_flx gather shifts,
       ! umuscl.f90:220-258). The guards keep the mapped edge index on the
       ! stored lattice: a +d corner maps to transverse edge index cell_d-1 in
       ! [0,2*nsubgrid] (okp_d), a -d corner to cell_d-2 (okm_d), and the
       ! along-axis segment to cell_a-2 in [0,2*nsubgrid-1] (oka_a). Corner
       ! values of cells outside these ranges fed no oct edge (the cell-indexed
       ! scheme computed and discarded them).
       okp_x = ix <= 2*nsubgrid+1; okm_x = ix >= 2; oka_x = okm_x .and. okp_x
       okp_y = iy <= 2*nsubgrid+1; okm_y = iy >= 2; oka_y = okm_y .and. okp_y
       okp_z = k  <= 2*nsubgrid+1; okm_z = k  >= 2; oka_z = okm_z .and. okp_z

       ! ---- X-edge corner states (orientation 1) (CPU trace3d:1226-1289) ------
       ! Corner letters: R/L = the cell's +y/-y side, T/B = +z/-z. The cell's
       ! RT corner is the LL corner of the x-edge at (ix-2,iy-1,k-1), etc. The
       ! edge-parallel velocity u is not stored (no 2D EMF solver reads it);
       ! components stay in the PHYSICAL frame (gather_corner_x permutes, C3).
       if (oka_x .and. okp_y .and. okp_z) then   ! qRT -> LL slot
          corner_x%density   (iqLL,ix-2,iy-1,k-1) = r + (+dry+drz)
          corner_x%velocity_y(iqLL,ix-2,iy-1,k-1) = v + (+dvy+dvz)
          corner_x%velocity_z(iqLL,ix-2,iy-1,k-1) = w + (+dwy+dwz)
          corner_x%pressure  (iqLL,ix-2,iy-1,k-1) = p + (+dpy+dpz)
          corner_x%Bx(iqLL,ix-2,iy-1,k-1) = A + (+dAy+dAz)
          corner_x%By(iqLL,ix-2,iy-1,k-1) = BR + (   +dBRz)
          corner_x%Bz(iqLL,ix-2,iy-1,k-1) = CR + (+dCRy   )
          if (corner_x%density (iqLL,ix-2,iy-1,k-1) < smallr) corner_x%density (iqLL,ix-2,iy-1,k-1) = r
          if (corner_x%pressure(iqLL,ix-2,iy-1,k-1) < smallp) corner_x%pressure(iqLL,ix-2,iy-1,k-1) = p
       end if
       if (oka_x .and. okp_y .and. okm_z) then   ! qRB -> LR slot
          corner_x%density   (iqLR,ix-2,iy-1,k-2) = r + (+dry-drz)
          corner_x%velocity_y(iqLR,ix-2,iy-1,k-2) = v + (+dvy-dvz)
          corner_x%velocity_z(iqLR,ix-2,iy-1,k-2) = w + (+dwy-dwz)
          corner_x%pressure  (iqLR,ix-2,iy-1,k-2) = p + (+dpy-dpz)
          corner_x%Bx(iqLR,ix-2,iy-1,k-2) = A + (+dAy-dAz)
          corner_x%By(iqLR,ix-2,iy-1,k-2) = BR + (   -dBRz)
          corner_x%Bz(iqLR,ix-2,iy-1,k-2) = CL + (+dCLy   )
          if (corner_x%density (iqLR,ix-2,iy-1,k-2) < smallr) corner_x%density (iqLR,ix-2,iy-1,k-2) = r
          if (corner_x%pressure(iqLR,ix-2,iy-1,k-2) < smallp) corner_x%pressure(iqLR,ix-2,iy-1,k-2) = p
       end if
       if (oka_x .and. okm_y .and. okp_z) then   ! qLT -> RL slot
          corner_x%density   (iqRL,ix-2,iy-2,k-1) = r + (-dry+drz)
          corner_x%velocity_y(iqRL,ix-2,iy-2,k-1) = v + (-dvy+dvz)
          corner_x%velocity_z(iqRL,ix-2,iy-2,k-1) = w + (-dwy+dwz)
          corner_x%pressure  (iqRL,ix-2,iy-2,k-1) = p + (-dpy+dpz)
          corner_x%Bx(iqRL,ix-2,iy-2,k-1) = A + (-dAy+dAz)
          corner_x%By(iqRL,ix-2,iy-2,k-1) = BL + (   +dBLz)
          corner_x%Bz(iqRL,ix-2,iy-2,k-1) = CR + (-dCRy   )
          if (corner_x%density (iqRL,ix-2,iy-2,k-1) < smallr) corner_x%density (iqRL,ix-2,iy-2,k-1) = r
          if (corner_x%pressure(iqRL,ix-2,iy-2,k-1) < smallp) corner_x%pressure(iqRL,ix-2,iy-2,k-1) = p
       end if
       if (oka_x .and. okm_y .and. okm_z) then   ! qLB -> RR slot
          corner_x%density   (iqRR,ix-2,iy-2,k-2) = r + (-dry-drz)
          corner_x%velocity_y(iqRR,ix-2,iy-2,k-2) = v + (-dvy-dvz)
          corner_x%velocity_z(iqRR,ix-2,iy-2,k-2) = w + (-dwy-dwz)
          corner_x%pressure  (iqRR,ix-2,iy-2,k-2) = p + (-dpy-dpz)
          corner_x%Bx(iqRR,ix-2,iy-2,k-2) = A + (-dAy-dAz)
          corner_x%By(iqRR,ix-2,iy-2,k-2) = BL + (   -dBLz)
          corner_x%Bz(iqRR,ix-2,iy-2,k-2) = CL + (-dCLy   )
          if (corner_x%density (iqRR,ix-2,iy-2,k-2) < smallr) corner_x%density (iqRR,ix-2,iy-2,k-2) = r
          if (corner_x%pressure(iqRR,ix-2,iy-2,k-2) < smallp) corner_x%pressure(iqRR,ix-2,iy-2,k-2) = p
       end if

       ! ---- Y-edge corner states (orientation 2) (CPU trace3d:1290-1353) ------
       ! Corner letters: R/L = the cell's +x/-x side, T/B = +z/-z. The 2D
       ! solver's first in-plane axis for y-edges is physical z (CPU lp1=4), so
       ! the cell's RT corner is the LL corner of edge (ix-1,iy-2,k-1) but RB
       ! feeds the RL slot and LT the LR slot (cf. the CPU Ey gather swap,
       ! umuscl.f90:236-242). The edge-parallel velocity v is not stored.
       if (okp_x .and. oka_y .and. okp_z) then   ! qRT -> LL slot
          corner_y%density   (iqLL,ix-1,iy-2,k-1) = r + (+drx+drz)
          corner_y%velocity_x(iqLL,ix-1,iy-2,k-1) = u + (+dux+duz)
          corner_y%velocity_z(iqLL,ix-1,iy-2,k-1) = w + (+dwx+dwz)
          corner_y%pressure  (iqLL,ix-1,iy-2,k-1) = p + (+dpx+dpz)
          corner_y%Bx(iqLL,ix-1,iy-2,k-1) = AR + (   +dARz)
          corner_y%By(iqLL,ix-1,iy-2,k-1) = B + (+dBx+dBz)
          corner_y%Bz(iqLL,ix-1,iy-2,k-1) = CR + (+dCRx   )
          if (corner_y%density (iqLL,ix-1,iy-2,k-1) < smallr) corner_y%density (iqLL,ix-1,iy-2,k-1) = r
          if (corner_y%pressure(iqLL,ix-1,iy-2,k-1) < smallp) corner_y%pressure(iqLL,ix-1,iy-2,k-1) = p
       end if
       if (okp_x .and. oka_y .and. okm_z) then   ! qRB -> RL slot
          corner_y%density   (iqRL,ix-1,iy-2,k-2) = r + (+drx-drz)
          corner_y%velocity_x(iqRL,ix-1,iy-2,k-2) = u + (+dux-duz)
          corner_y%velocity_z(iqRL,ix-1,iy-2,k-2) = w + (+dwx-dwz)
          corner_y%pressure  (iqRL,ix-1,iy-2,k-2) = p + (+dpx-dpz)
          corner_y%Bx(iqRL,ix-1,iy-2,k-2) = AR + (   -dARz)
          corner_y%By(iqRL,ix-1,iy-2,k-2) = B + (+dBx-dBz)
          corner_y%Bz(iqRL,ix-1,iy-2,k-2) = CL + (+dCLx   )
          if (corner_y%density (iqRL,ix-1,iy-2,k-2) < smallr) corner_y%density (iqRL,ix-1,iy-2,k-2) = r
          if (corner_y%pressure(iqRL,ix-1,iy-2,k-2) < smallp) corner_y%pressure(iqRL,ix-1,iy-2,k-2) = p
       end if
       if (okm_x .and. oka_y .and. okp_z) then   ! qLT -> LR slot
          corner_y%density   (iqLR,ix-2,iy-2,k-1) = r + (-drx+drz)
          corner_y%velocity_x(iqLR,ix-2,iy-2,k-1) = u + (-dux+duz)
          corner_y%velocity_z(iqLR,ix-2,iy-2,k-1) = w + (-dwx+dwz)
          corner_y%pressure  (iqLR,ix-2,iy-2,k-1) = p + (-dpx+dpz)
          corner_y%Bx(iqLR,ix-2,iy-2,k-1) = AL + (   +dALz)
          corner_y%By(iqLR,ix-2,iy-2,k-1) = B + (-dBx+dBz)
          corner_y%Bz(iqLR,ix-2,iy-2,k-1) = CR + (-dCRx   )
          if (corner_y%density (iqLR,ix-2,iy-2,k-1) < smallr) corner_y%density (iqLR,ix-2,iy-2,k-1) = r
          if (corner_y%pressure(iqLR,ix-2,iy-2,k-1) < smallp) corner_y%pressure(iqLR,ix-2,iy-2,k-1) = p
       end if
       if (okm_x .and. oka_y .and. okm_z) then   ! qLB -> RR slot
          corner_y%density   (iqRR,ix-2,iy-2,k-2) = r + (-drx-drz)
          corner_y%velocity_x(iqRR,ix-2,iy-2,k-2) = u + (-dux-duz)
          corner_y%velocity_z(iqRR,ix-2,iy-2,k-2) = w + (-dwx-dwz)
          corner_y%pressure  (iqRR,ix-2,iy-2,k-2) = p + (-dpx-dpz)
          corner_y%Bx(iqRR,ix-2,iy-2,k-2) = AL + (   -dALz)
          corner_y%By(iqRR,ix-2,iy-2,k-2) = B + (-dBx-dBz)
          corner_y%Bz(iqRR,ix-2,iy-2,k-2) = CL + (-dCLx   )
          if (corner_y%density (iqRR,ix-2,iy-2,k-2) < smallr) corner_y%density (iqRR,ix-2,iy-2,k-2) = r
          if (corner_y%pressure(iqRR,ix-2,iy-2,k-2) < smallp) corner_y%pressure(iqRR,ix-2,iy-2,k-2) = p
       end if

       ! ---- Z-edge corner states (orientation 3) (CPU trace3d:1354-1417) ------
       ! Corner letters: R/L = the cell's +x/-x side, T/B = +y/-y. The cell's
       ! RT corner is the LL corner of edge (ix-1,iy-1,k-2), etc. The
       ! edge-parallel velocity w is not stored.
       if (okp_x .and. okp_y .and. oka_z) then   ! qRT -> LL slot
          corner_z%density   (iqLL,ix-1,iy-1,k-2) = r + (+drx+dry)
          corner_z%velocity_x(iqLL,ix-1,iy-1,k-2) = u + (+dux+duy)
          corner_z%velocity_y(iqLL,ix-1,iy-1,k-2) = v + (+dvx+dvy)
          corner_z%pressure  (iqLL,ix-1,iy-1,k-2) = p + (+dpx+dpy)
          corner_z%Bx(iqLL,ix-1,iy-1,k-2) = AR + (   +dARy)
          corner_z%By(iqLL,ix-1,iy-1,k-2) = BR + (+dBRx   )
          corner_z%Bz(iqLL,ix-1,iy-1,k-2) = C + (+dCx+dCy)
          if (corner_z%density (iqLL,ix-1,iy-1,k-2) < smallr) corner_z%density (iqLL,ix-1,iy-1,k-2) = r
          if (corner_z%pressure(iqLL,ix-1,iy-1,k-2) < smallp) corner_z%pressure(iqLL,ix-1,iy-1,k-2) = p
       end if
       if (okp_x .and. okm_y .and. oka_z) then   ! qRB -> LR slot
          corner_z%density   (iqLR,ix-1,iy-2,k-2) = r + (+drx-dry)
          corner_z%velocity_x(iqLR,ix-1,iy-2,k-2) = u + (+dux-duy)
          corner_z%velocity_y(iqLR,ix-1,iy-2,k-2) = v + (+dvx-dvy)
          corner_z%pressure  (iqLR,ix-1,iy-2,k-2) = p + (+dpx-dpy)
          corner_z%Bx(iqLR,ix-1,iy-2,k-2) = AR + (   -dARy)
          corner_z%By(iqLR,ix-1,iy-2,k-2) = BL + (+dBLx   )
          corner_z%Bz(iqLR,ix-1,iy-2,k-2) = C + (+dCx-dCy)
          if (corner_z%density (iqLR,ix-1,iy-2,k-2) < smallr) corner_z%density (iqLR,ix-1,iy-2,k-2) = r
          if (corner_z%pressure(iqLR,ix-1,iy-2,k-2) < smallp) corner_z%pressure(iqLR,ix-1,iy-2,k-2) = p
       end if
       if (okm_x .and. okp_y .and. oka_z) then   ! qLT -> RL slot
          corner_z%density   (iqRL,ix-2,iy-1,k-2) = r + (-drx+dry)
          corner_z%velocity_x(iqRL,ix-2,iy-1,k-2) = u + (-dux+duy)
          corner_z%velocity_y(iqRL,ix-2,iy-1,k-2) = v + (-dvx+dvy)
          corner_z%pressure  (iqRL,ix-2,iy-1,k-2) = p + (-dpx+dpy)
          corner_z%Bx(iqRL,ix-2,iy-1,k-2) = AL + (   +dALy)
          corner_z%By(iqRL,ix-2,iy-1,k-2) = BR + (-dBRx   )
          corner_z%Bz(iqRL,ix-2,iy-1,k-2) = C + (-dCx+dCy)
          if (corner_z%density (iqRL,ix-2,iy-1,k-2) < smallr) corner_z%density (iqRL,ix-2,iy-1,k-2) = r
          if (corner_z%pressure(iqRL,ix-2,iy-1,k-2) < smallp) corner_z%pressure(iqRL,ix-2,iy-1,k-2) = p
       end if
       if (okm_x .and. okm_y .and. oka_z) then   ! qLB -> RR slot
          corner_z%density   (iqRR,ix-2,iy-2,k-2) = r + (-drx-dry)
          corner_z%velocity_x(iqRR,ix-2,iy-2,k-2) = u + (-dux-duy)
          corner_z%velocity_y(iqRR,ix-2,iy-2,k-2) = v + (-dvx-dvy)
          corner_z%pressure  (iqRR,ix-2,iy-2,k-2) = p + (-dpx-dpy)
          corner_z%Bx(iqRR,ix-2,iy-2,k-2) = AL + (   -dALy)
          corner_z%By(iqRR,ix-2,iy-2,k-2) = BL + (-dBLx   )
          corner_z%Bz(iqRR,ix-2,iy-2,k-2) = C + (-dCx-dCy)
          if (corner_z%density (iqRR,ix-2,iy-2,k-2) < smallr) corner_z%density (iqRR,ix-2,iy-2,k-2) = r
          if (corner_z%pressure(iqRR,ix-2,iy-2,k-2) < smallp) corner_z%pressure(iqRR,ix-2,iy-2,k-2) = p
       end if

       ! ---- Passive-scalar advection predictor (CPU trace3d:1423-1448) --------
       ! Uses the ORIGINAL cell velocities (re-read from local_mhd), not predicted.
       ! Scalar slopes come from compute_tvd_slopes_mhd (dscal_*, v4.1).
       do n = 1, nvar-5
          rscal = scalar_sub(ix,iy,k,n)
          u = local_mhd%velocity_x(ix,iy,k)
          v = local_mhd%velocity_y(ix,iy,k)
          w = local_mhd%velocity_z(ix,iy,k)
          drx = dscal_x(n)
          dry = dscal_y(n)
          drz = dscal_z(n)
          sr0 = -u*drx - v*dry - w*drz
          rscal = rscal + sr0*dtdx
          if (ix > 1 .and. (iy > 1 .and. iy < work_size) .and. (k > 1 .and. k < work_size)) &
               & right_x%scalar(ix-2,iy-2,k-2,n) = rscal - drx
          if (ix < work_size .and. (iy > 1 .and. iy < work_size) .and. (k > 1 .and. k < work_size)) &
               & left_x%scalar(ix-1,iy-2,k-2,n) = rscal + drx
          if ((ix > 1 .and. ix < work_size) .and. iy > 1 .and. (k > 1 .and. k < work_size)) &
               & right_y%scalar(ix-2,iy-2,k-2,n) = rscal - dry
          if ((ix > 1 .and. ix < work_size) .and. iy < work_size .and. (k > 1 .and. k < work_size)) &
               & left_y%scalar(ix-2,iy-1,k-2,n) = rscal + dry
          if ((ix > 1 .and. ix < work_size) .and. (iy > 1 .and. iy < work_size) .and. k > 1) &
               & right_z%scalar(ix-2,iy-2,k-2,n) = rscal - drz
          if ((ix > 1 .and. ix < work_size) .and. (iy > 1 .and. iy < work_size) .and. k < work_size) &
               & left_z%scalar(ix-2,iy-2,k-1,n) = rscal + drz
       end do

    end do

    call syncthreads()

  end subroutine trace_3d_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C2 helper) Passive-scalar interface flux, matched to the chosen
  !> 1D solver: HLLD upwinds by the (HLLD) mass flux fdens (CPU riemann_hlld:1240-
  !> 1244, fgdnv(s)=fgdnv(1)*qleft/qright); HLL (and the fall-throughs) use the full
  !> HLL flux on (rho*u*s) with the same SL/SR as the MHD core (CPU riemann_hll_mhd).
  attributes(device) function mhd_scalar_flux(riemann, fdens, speed_l, speed_r, rhoL, uL, sL, rhoR, uR, sR) result(fs)
    ! NB: Fortran is case-insensitive, so the wave speeds cannot be named SL/SR
    ! alongside the scalar values sL/sR (duplicate dummy); they follow the
    ! hll_flux speed_l/speed_r naming instead.
    integer, value :: riemann
    real(kind=dp), value :: fdens, speed_l, speed_r, rhoL, uL, sL, rhoR, uR, sR
    real(kind=dp) :: fs
    if (riemann .eq. solver_hlld) then
       if (fdens > 0.0_dp) then
          fs = fdens*sL
       else
          fs = fdens*sR
       endif
    else
       fs = hll_flux(speed_l, speed_r, rhoL*uL*sL, rhoR*uR*sR, rhoL*sL, rhoR*sR)
    endif
  end function mhd_scalar_flux
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C2 helper) Return the HLL fast-magnetosonic wave speeds SL/SR
  !> for the 1D MHD Riemann problem, identical to the speed computation inside
  !> hll_mhd_fluxes (B4) -- recomputed here (rather than modifying B4, which is
  !> frozen) so the passive-scalar HLL flux in riemann_driver_mhd uses the same
  !> SL/SR as the MHD-core flux. Floors match B4 (no-ops for realistic states).
  attributes(device) subroutine hll_mhd_wavespeeds(left, right, gamma, smallr, smallc, SL, SR)
    type(primitive_mhd_t), intent(in) :: left, right
    real(kind=dp), value :: gamma, smallr, smallc
    real(kind=dp), intent(out) :: SL, SR
    real(kind=dp) :: smallp, bx_mean, rl, rr, pl, pr, ul, ur
    real(kind=dp) :: blx, bly, blz, brx, bry, brz
    real(kind=dp) :: b2l, b2r, c2l, c2r, d2l, d2r, cfleft, cfright

    smallp = smallc**2 / gamma
    bx_mean = 0.5_dp * (left%Bx + right%Bx)
    rl = max(left%density, smallr);  rr = max(right%density, smallr)
    pl = max(left%pressure, smallp*rl); pr = max(right%pressure, smallp*rr)
    ul = left%velocity_x; ur = right%velocity_x
    blx = bx_mean; brx = bx_mean
    bly = left%By;  blz = left%Bz
    bry = right%By; brz = right%Bz
    b2l = compute_bsquared(blx, bly, blz); c2l = gamma*pl/rl
    d2l = 0.5_dp*(b2l/rl + c2l); cfleft = sqrt(d2l + sqrt(d2l**2 - c2l*blx*blx/rl))
    b2r = compute_bsquared(brx, bry, brz); c2r = gamma*pr/rr
    d2r = 0.5_dp*(b2r/rr + c2r); cfright = sqrt(d2r + sqrt(d2r**2 - c2r*brx*brx/rr))
    SL = min(min(ul, ur) - max(cfleft, cfright), 0.0_dp)
    SR = max(max(ul, ur) + max(cfleft, cfright), 0.0_dp)
  end subroutine hll_mhd_wavespeeds
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C2) MHD 1D-flux driver. The MHD analog of riemann_driver: for
  !> each of the X/Y/Z interfaces it gathers the qm/qp interface states, rotates
  !> the velocity AND magnetic field into the face-normal frame (the CPU bn,bt1,bt2
  !> / ln,lt1,lt2 permutations, cmpflxm umuscl.f90:131-204), calls riemann_mhd_fluxes
  !> (B4), and unpacks the conserved fluxes back into the interface arrays with the
  !> rotation reversed. Passive scalars are advected with the same SL/SR HLL flux as
  !> the CPU (find_mhd_flux: ff(s)=d*u*s, cvar(s)=d*s; godunov_utils.f90:1332-1335).
  !> At NDIM=3 the magnetic-flux slots (Bx/By/Bz) are written but never consumed --
  !> B is advanced by constrained transport (the EMF curl in C5), not by these
  !> face fluxes (CPU guards the face-flux B update #if NDIM<3, godunov_fine:771).
  attributes(device) subroutine riemann_driver_mhd(left_x, right_x, left_y, right_y, &
       & left_z, right_z, thread_idx, gamma, smallr, smallc, riemann)
    type(subgrid_3x2x2cell_primitive_mhd), intent(inout) :: left_x, right_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(inout) :: left_y, right_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(inout) :: left_z, right_z
    real(kind=dp), value :: gamma, smallr, smallc
    integer, value :: riemann, thread_idx
    integer :: work_idx, interface_array_size, i, j, k, n
    type(primitive_mhd_t) :: lft, rgt
    type(conserved_mhd_t) :: flux
    real(kind=dp) :: SL, SR, sLin, sRin

    interface_array_size = (2*nsubgrid+1) * (2*nsubgrid)**2

    do work_idx = thread_idx, interface_array_size * 3 - 1, blockDim%x
       if (work_idx < interface_array_size) then
          ! ---- X interfaces: normal frame is identity ----------------------
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid, i, j, k)
          lft%density = left_x%density(i,j,k);  lft%pressure = left_x%pressure(i,j,k)
          lft%velocity_x = left_x%velocity_x(i,j,k); lft%velocity_y = left_x%velocity_y(i,j,k)
          lft%velocity_z = left_x%velocity_z(i,j,k)
          lft%Bx = left_x%Bx(i,j,k); lft%By = left_x%By(i,j,k); lft%Bz = left_x%Bz(i,j,k)
          rgt%density = right_x%density(i,j,k); rgt%pressure = right_x%pressure(i,j,k)
          rgt%velocity_x = right_x%velocity_x(i,j,k); rgt%velocity_y = right_x%velocity_y(i,j,k)
          rgt%velocity_z = right_x%velocity_z(i,j,k)
          rgt%Bx = right_x%Bx(i,j,k); rgt%By = right_x%By(i,j,k); rgt%Bz = right_x%Bz(i,j,k)

          flux = riemann_mhd_fluxes(lft, rgt, gamma, smallr, smallc, riemann)
          call hll_mhd_wavespeeds(lft, rgt, gamma, smallr, smallc, SL, SR)

          left_x%density(i,j,k) = flux%density
          left_x%velocity_x(i,j,k) = flux%momentum_x
          left_x%velocity_y(i,j,k) = flux%momentum_y
          left_x%velocity_z(i,j,k) = flux%momentum_z
          left_x%pressure(i,j,k) = flux%energy
          left_x%Bx(i,j,k) = flux%Bx; left_x%By(i,j,k) = flux%By; left_x%Bz(i,j,k) = flux%Bz
          do n = 1, nvar-5
             sLin = left_x%scalar(i,j,k,n); sRin = right_x%scalar(i,j,k,n)
             left_x%scalar(i,j,k,n) = mhd_scalar_flux(riemann, flux%density, SL, SR, &
                  & max(lft%density,smallr), lft%velocity_x, sLin, max(rgt%density,smallr), rgt%velocity_x, sRin)
          end do

       else if (work_idx < 2 * interface_array_size) then
          ! ---- Y interfaces: normal=vy/By, t1=vx/Bx, t2=vz/Bz --------------
          call index_1Dto3D(work_idx - interface_array_size, 2*nsubgrid, 2*nsubgrid+1, i, j, k)
          lft%density = left_y%density(i,j,k);  lft%pressure = left_y%pressure(i,j,k)
          lft%velocity_x = left_y%velocity_y(i,j,k); lft%velocity_y = left_y%velocity_x(i,j,k)
          lft%velocity_z = left_y%velocity_z(i,j,k)
          lft%Bx = left_y%By(i,j,k); lft%By = left_y%Bx(i,j,k); lft%Bz = left_y%Bz(i,j,k)
          rgt%density = right_y%density(i,j,k); rgt%pressure = right_y%pressure(i,j,k)
          rgt%velocity_x = right_y%velocity_y(i,j,k); rgt%velocity_y = right_y%velocity_x(i,j,k)
          rgt%velocity_z = right_y%velocity_z(i,j,k)
          rgt%Bx = right_y%By(i,j,k); rgt%By = right_y%Bx(i,j,k); rgt%Bz = right_y%Bz(i,j,k)

          flux = riemann_mhd_fluxes(lft, rgt, gamma, smallr, smallc, riemann)
          call hll_mhd_wavespeeds(lft, rgt, gamma, smallr, smallc, SL, SR)

          left_y%density(i,j,k) = flux%density
          left_y%velocity_y(i,j,k) = flux%momentum_x   ! normal momentum
          left_y%velocity_x(i,j,k) = flux%momentum_y   ! tangential 1
          left_y%velocity_z(i,j,k) = flux%momentum_z   ! tangential 2
          left_y%pressure(i,j,k) = flux%energy
          left_y%By(i,j,k) = flux%Bx; left_y%Bx(i,j,k) = flux%By; left_y%Bz(i,j,k) = flux%Bz
          do n = 1, nvar-5
             sLin = left_y%scalar(i,j,k,n); sRin = right_y%scalar(i,j,k,n)
             left_y%scalar(i,j,k,n) = mhd_scalar_flux(riemann, flux%density, SL, SR, &
                  & max(lft%density,smallr), lft%velocity_x, sLin, max(rgt%density,smallr), rgt%velocity_x, sRin)
          end do

       else
          ! ---- Z interfaces: normal=vz/Bz, t1=vx/Bx, t2=vy/By --------------
          call index_1Dto3D(work_idx - 2*interface_array_size, 2*nsubgrid, 2*nsubgrid, i, j, k)
          lft%density = left_z%density(i,j,k);  lft%pressure = left_z%pressure(i,j,k)
          lft%velocity_x = left_z%velocity_z(i,j,k); lft%velocity_y = left_z%velocity_x(i,j,k)
          lft%velocity_z = left_z%velocity_y(i,j,k)
          lft%Bx = left_z%Bz(i,j,k); lft%By = left_z%Bx(i,j,k); lft%Bz = left_z%By(i,j,k)
          rgt%density = right_z%density(i,j,k); rgt%pressure = right_z%pressure(i,j,k)
          rgt%velocity_x = right_z%velocity_z(i,j,k); rgt%velocity_y = right_z%velocity_x(i,j,k)
          rgt%velocity_z = right_z%velocity_y(i,j,k)
          rgt%Bx = right_z%Bz(i,j,k); rgt%By = right_z%Bx(i,j,k); rgt%Bz = right_z%By(i,j,k)

          flux = riemann_mhd_fluxes(lft, rgt, gamma, smallr, smallc, riemann)
          call hll_mhd_wavespeeds(lft, rgt, gamma, smallr, smallc, SL, SR)

          left_z%density(i,j,k) = flux%density
          left_z%velocity_z(i,j,k) = flux%momentum_x   ! normal momentum
          left_z%velocity_x(i,j,k) = flux%momentum_y   ! tangential 1
          left_z%velocity_y(i,j,k) = flux%momentum_z   ! tangential 2
          left_z%pressure(i,j,k) = flux%energy
          left_z%Bz(i,j,k) = flux%Bx; left_z%Bx(i,j,k) = flux%By; left_z%By(i,j,k) = flux%Bz
          do n = 1, nvar-5
             sLin = left_z%scalar(i,j,k,n); sRin = right_z%scalar(i,j,k,n)
             left_z%scalar(i,j,k,n) = mhd_scalar_flux(riemann, flux%density, SL, SR, &
                  & max(lft%density,smallr), lft%velocity_x, sLin, max(rgt%density,smallr), rgt%velocity_x, sRin)
          end do
       end if
    end do

    call syncthreads()

  end subroutine riemann_driver_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C3 helpers) Read one edge corner state from the shared
  !> edge-corner buffer and permute it into the canonical 2D-Riemann frame.
  !> One function per edge orientation, the per-corner half of the CPU
  !> cmp_mag_flx gather (umuscl.f90:1640-1685): solver velocity_x/y <- the two
  !> in-plane velocities (CPU lp1/lp2), solver Bx/By <- the two in-plane B
  !> (bp1/bp2, continuity applied later in emf_solve), solver Bz <- the
  !> edge-parallel B (bor). The edge-parallel velocity (CPU lor) is consumed by
  !> NO 2D EMF solver and is not stored; the dead solver velocity_z slot is
  !> zero-filled so it is never undefined.
  attributes(device) function gather_corner_x(c, islot, I, J, K) result(q)
    type(subgrid_2x3x3edge_corner), intent(in) :: c
    integer, value :: islot, I, J, K
    type(primitive_mhd_t) :: q
    ! Orientation 1 (Ex): lp1=3, lp2=4, lor=2; bp1=7, bp2=8, bor=6.
    q%density    = c%density   (islot,I,J,K)
    q%pressure   = c%pressure  (islot,I,J,K)
    q%velocity_x = c%velocity_y(islot,I,J,K)
    q%velocity_y = c%velocity_z(islot,I,J,K)
    q%velocity_z = 0.0_dp
    q%Bx         = c%By(islot,I,J,K)
    q%By         = c%Bz(islot,I,J,K)
    q%Bz         = c%Bx(islot,I,J,K)
  end function gather_corner_x

  attributes(device) function gather_corner_y(c, islot, I, J, K) result(q)
    type(subgrid_3x2x3edge_corner), intent(in) :: c
    integer, value :: islot, I, J, K
    type(primitive_mhd_t) :: q
    ! Orientation 2 (Ey): lp1=4, lp2=2, lor=3; bp1=8, bp2=6, bor=7.
    q%density    = c%density   (islot,I,J,K)
    q%pressure   = c%pressure  (islot,I,J,K)
    q%velocity_x = c%velocity_z(islot,I,J,K)
    q%velocity_y = c%velocity_x(islot,I,J,K)
    q%velocity_z = 0.0_dp
    q%Bx         = c%Bz(islot,I,J,K)
    q%By         = c%Bx(islot,I,J,K)
    q%Bz         = c%By(islot,I,J,K)
  end function gather_corner_y

  attributes(device) function gather_corner_z(c, islot, I, J, K) result(q)
    type(subgrid_3x3x2edge_corner), intent(in) :: c
    integer, value :: islot, I, J, K
    type(primitive_mhd_t) :: q
    ! Orientation 3 (Ez): lp1=2, lp2=3, lor=4; bp1=6, bp2=7, bor=8 (identity).
    q%density    = c%density   (islot,I,J,K)
    q%pressure   = c%pressure  (islot,I,J,K)
    q%velocity_x = c%velocity_x(islot,I,J,K)
    q%velocity_y = c%velocity_y(islot,I,J,K)
    q%velocity_z = 0.0_dp
    q%Bx         = c%Bx(islot,I,J,K)
    q%By         = c%By(islot,I,J,K)
    q%Bz         = c%Bz(islot,I,J,K)
  end function gather_corner_z
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C3 helper) Enforce the parallel-B continuity of cmp_mag_flx
  !> (umuscl.f90:1669-1685) on the four (already permuted) corner states, then
  !> call the selected 2D EMF solver (HLLF/HLLD). Bx holds parallel-B-1 (bp1), By parallel-B-2
  !> (bp2); both are made single-valued across their respective edge directions.
  attributes(device) function emf_solve(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
       & switch_llf_dmin, switch_llf_pmin, riemann2d) result(E)
    type(primitive_mhd_t), intent(in) :: qLL, qLR, qRL, qRR
    real(kind=dp), value :: gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin
    integer, value :: riemann2d
    real(kind=dp) :: E
    type(primitive_mhd_t) :: sLL, sLR, sRL, sRR
    real(kind=dp) :: b1_LL, b1_LR, b2_LL, b2_RL
    real(kind=dp), parameter :: half = 0.5_dp

    sLL = qLL; sLR = qLR; sRL = qRL; sRR = qRR
    b1_LL = half*(qLL%Bx + qRL%Bx); b1_LR = half*(qLR%Bx + qRR%Bx)
    sLL%Bx = b1_LL; sRL%Bx = b1_LL; sLR%Bx = b1_LR; sRR%Bx = b1_LR
    b2_LL = half*(qLL%By + qLR%By); b2_RL = half*(qRL%By + qRR%By)
    sLL%By = b2_LL; sLR%By = b2_LL; sRL%By = b2_RL; sRR%By = b2_RL
    E = riemann2d_emf(sLL, sLR, sRL, sRR, gamma, smallr, smallc, &
         & switch_llf_dmin, switch_llf_pmin, riemann2d)
  end function emf_solve
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C3) Whole-subgrid EMF solve. The MHD-only stage with no hydro
  !> analog. Mirrors the three CPU cmp_mag_flx calls (umuscl.f90:220-265). For
  !> each output edge (I,J,K) of the oct (v4.1 edge family: 3x3 edge lines
  !> transverse x 2*nsubgrid segments along the edge direction, 18 per
  !> orientation) and each orientation it reads the four corner slots of that
  !> edge from the shared corner_x/y/z buffers -- shift-free: the CPU's
  !> orientation-specific gather shifts (and the qRT/qRB/qLT/qLB ->
  !> qLL/qLR/qRL/qRR remap, umuscl.f90:220-258) were applied at the WRITE side
  !> in trace_3d_mhd, so slot iqLL of edge (I,J,K) already holds what the CPU
  !> gather would fetch. The per-orientation component permutation into the 2D
  !> solver frame happens in gather_corner_x/y/z. emf_solve then enforces the
  !> parallel-B continuity and dispatches the 2D solver. RAW E is stored (the
  !> dt/dx scaling is applied once per consumer, C5/C6).
  attributes(device) subroutine cmp_mag_flx_mhd(corner_x, corner_y, corner_z, emfx, emfy, emfz, &
       & thread_idx, gamma, smallr, smallc, &
       & switch_llf_dmin, switch_llf_pmin, riemann2d)
    type(subgrid_2x3x3edge_corner), intent(in) :: corner_x
    type(subgrid_3x2x3edge_corner), intent(in) :: corner_y
    type(subgrid_3x3x2edge_corner), intent(in) :: corner_z
    integer, value :: thread_idx, riemann2d
    real(kind=dp), value :: gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin
    type(subgrid_2x3x3edge_primitive), intent(inout) :: emfx
    type(subgrid_3x2x3edge_primitive), intent(inout) :: emfy
    type(subgrid_3x3x2edge_primitive), intent(inout) :: emfz
    integer, parameter :: iqLL = 1, iqRL = 2, iqLR = 3, iqRR = 4
    integer :: work_idx, emf_size, I, J, K
    type(primitive_mhd_t) :: qLL, qLR, qRL, qRR

    ! 18 edges per orientation (v4.1 edge family): 3x3 edge lines in the
    ! transverse plane x 2*nsubgrid segments along the edge direction.
    emf_size = (2*nsubgrid+1)**2 * (2*nsubgrid)

    do work_idx = thread_idx, emf_size*3 - 1, blockDim%x
       if (work_idx < emf_size) then
          ! ---- EMF z (orientation 3): lp1=2 lp2=3 lor=4, bp1=6 bp2=7 bor=8 ----
          ! Edges parallel to z: I,J in [0,2*nsubgrid], K in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid+1, I, J, K)
          qLL = gather_corner_z(corner_z, iqLL, I, J, K)
          qRL = gather_corner_z(corner_z, iqRL, I, J, K)
          qLR = gather_corner_z(corner_z, iqLR, I, J, K)
          qRR = gather_corner_z(corner_z, iqRR, I, J, K)
          emfz%edge_e(I,J,K) = emf_solve(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
               & switch_llf_dmin, switch_llf_pmin, riemann2d)

       else if (work_idx < 2*emf_size) then
          ! ---- EMF y (orientation 2): lp1=4 lp2=2 lor=3, bp1=8 bp2=6 bor=7 ----
          ! Edges parallel to y: I,K in [0,2*nsubgrid], J in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx - emf_size, 2*nsubgrid+1, 2*nsubgrid, I, J, K)
          qLL = gather_corner_y(corner_y, iqLL, I, J, K)
          qRL = gather_corner_y(corner_y, iqRL, I, J, K)
          qLR = gather_corner_y(corner_y, iqLR, I, J, K)
          qRR = gather_corner_y(corner_y, iqRR, I, J, K)
          emfy%edge_e(I,J,K) = emf_solve(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
               & switch_llf_dmin, switch_llf_pmin, riemann2d)

       else
          ! ---- EMF x (orientation 1): lp1=3 lp2=4 lor=2, bp1=7 bp2=8 bor=6 ----
          ! Edges parallel to x: J,K in [0,2*nsubgrid], I in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx - 2*emf_size, 2*nsubgrid, 2*nsubgrid+1, I, J, K)
          qLL = gather_corner_x(corner_x, iqLL, I, J, K)
          qRL = gather_corner_x(corner_x, iqRL, I, J, K)
          qLR = gather_corner_x(corner_x, iqLR, I, J, K)
          qRR = gather_corner_x(corner_x, iqRR, I, J, K)
          emfx%edge_e(I,J,K) = emf_solve(qLL, qLR, qRL, qRR, gamma, smallr, smallc, &
               & switch_llf_dmin, switch_llf_pmin, riemann2d)
       end if
    end do

    call syncthreads()

  end subroutine cmp_mag_flx_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C4a) MHD analog of zero_fine_fluxes. Zero the conserved fluxes
  !> (and passive-scalar fluxes; and the unused-in-3D transverse-B advection
  !> fluxes, for CPU fidelity) at faces touching a refined cell. Same refined-mask
  !> stencil as the hydro zero_fine_fluxes (CPU godunov_fine.f90:648-664).
  attributes(device) subroutine zero_fine_fluxes_mhd(local_mhd, fluxes_x, fluxes_y, fluxes_z, thread_idx)
    type(subgrid_6x6x6cell_primitive_mhd), intent(in) :: local_mhd
    type(subgrid_3x2x2cell_primitive_mhd), intent(inout) :: fluxes_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(inout) :: fluxes_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(inout) :: fluxes_z
    integer, value :: thread_idx
    integer :: work_idx, interface_array_size, i, j, k, n

    interface_array_size = (2*nsubgrid+1) * (2*nsubgrid)**2

    do work_idx = thread_idx, interface_array_size * 3 - 1, blockDim%x
       if (work_idx < interface_array_size) then
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid, i, j, k)
          if (local_mhd%refined(i+1,j+2,k+2) .or. local_mhd%refined(i+2,j+2,k+2)) then
             fluxes_x%density(i,j,k) = 0_dp;  fluxes_x%velocity_x(i,j,k) = 0_dp
             fluxes_x%velocity_y(i,j,k) = 0_dp; fluxes_x%velocity_z(i,j,k) = 0_dp
             fluxes_x%pressure(i,j,k) = 0_dp
             fluxes_x%Bx(i,j,k) = 0_dp; fluxes_x%By(i,j,k) = 0_dp; fluxes_x%Bz(i,j,k) = 0_dp
             do n = 1, nvar-5
                fluxes_x%scalar(i,j,k,n) = 0_dp
             end do
          end if
       else if (work_idx < 2 * interface_array_size) then
          call index_1Dto3D(work_idx - interface_array_size, 2*nsubgrid, 2*nsubgrid+1, i, j, k)
          if (local_mhd%refined(i+2,j+1,k+2) .or. local_mhd%refined(i+2,j+2,k+2)) then
             fluxes_y%density(i,j,k) = 0_dp;  fluxes_y%velocity_x(i,j,k) = 0_dp
             fluxes_y%velocity_y(i,j,k) = 0_dp; fluxes_y%velocity_z(i,j,k) = 0_dp
             fluxes_y%pressure(i,j,k) = 0_dp
             fluxes_y%Bx(i,j,k) = 0_dp; fluxes_y%By(i,j,k) = 0_dp; fluxes_y%Bz(i,j,k) = 0_dp
             do n = 1, nvar-5
                fluxes_y%scalar(i,j,k,n) = 0_dp
             end do
          end if
       else
          call index_1Dto3D(work_idx - 2*interface_array_size, 2*nsubgrid, 2*nsubgrid, i, j, k)
          if (local_mhd%refined(i+2,j+2,k+1) .or. local_mhd%refined(i+2,j+2,k+2)) then
             fluxes_z%density(i,j,k) = 0_dp;  fluxes_z%velocity_x(i,j,k) = 0_dp
             fluxes_z%velocity_y(i,j,k) = 0_dp; fluxes_z%velocity_z(i,j,k) = 0_dp
             fluxes_z%pressure(i,j,k) = 0_dp
             fluxes_z%Bx(i,j,k) = 0_dp; fluxes_z%By(i,j,k) = 0_dp; fluxes_z%Bz(i,j,k) = 0_dp
             do n = 1, nvar-5
                fluxes_z%scalar(i,j,k,n) = 0_dp
             end do
          end if
       end if
    end do

    call syncthreads()

  end subroutine zero_fine_fluxes_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief Pure-induction (kinematic dynamo) mode: zero ALL Euler fluxes so the
  !> conservative update leaves rho/momentum/energy/scalars untouched and only
  !> the CT update advances B. Mirrors CPU godunov_fine.f90:667
  !> (`if(r%induction)h%flux=0.0d0`); zeroing the flux arrays (rather than
  !> gating the consumers) keeps C5/C6 and the coarse/fine Part-1 correction
  !> bit-identical to the CPU. Called from the kernel only when induction.
  attributes(device) subroutine zero_euler_fluxes_mhd(fluxes_x, fluxes_y, fluxes_z, thread_idx)
    type(subgrid_3x2x2cell_primitive_mhd), intent(inout) :: fluxes_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(inout) :: fluxes_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(inout) :: fluxes_z
    integer, value :: thread_idx
    integer :: work_idx, interface_array_size, i, j, k, n

    interface_array_size = (2*nsubgrid+1) * (2*nsubgrid)**2

    do work_idx = thread_idx, interface_array_size * 3 - 1, blockDim%x
       if (work_idx < interface_array_size) then
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid, i, j, k)
          fluxes_x%density(i,j,k) = 0_dp;  fluxes_x%velocity_x(i,j,k) = 0_dp
          fluxes_x%velocity_y(i,j,k) = 0_dp; fluxes_x%velocity_z(i,j,k) = 0_dp
          fluxes_x%pressure(i,j,k) = 0_dp
          fluxes_x%Bx(i,j,k) = 0_dp; fluxes_x%By(i,j,k) = 0_dp; fluxes_x%Bz(i,j,k) = 0_dp
          do n = 1, nvar-5
             fluxes_x%scalar(i,j,k,n) = 0_dp
          end do
       else if (work_idx < 2 * interface_array_size) then
          call index_1Dto3D(work_idx - interface_array_size, 2*nsubgrid, 2*nsubgrid+1, i, j, k)
          fluxes_y%density(i,j,k) = 0_dp;  fluxes_y%velocity_x(i,j,k) = 0_dp
          fluxes_y%velocity_y(i,j,k) = 0_dp; fluxes_y%velocity_z(i,j,k) = 0_dp
          fluxes_y%pressure(i,j,k) = 0_dp
          fluxes_y%Bx(i,j,k) = 0_dp; fluxes_y%By(i,j,k) = 0_dp; fluxes_y%Bz(i,j,k) = 0_dp
          do n = 1, nvar-5
             fluxes_y%scalar(i,j,k,n) = 0_dp
          end do
       else
          call index_1Dto3D(work_idx - 2*interface_array_size, 2*nsubgrid, 2*nsubgrid, i, j, k)
          fluxes_z%density(i,j,k) = 0_dp;  fluxes_z%velocity_x(i,j,k) = 0_dp
          fluxes_z%velocity_y(i,j,k) = 0_dp; fluxes_z%velocity_z(i,j,k) = 0_dp
          fluxes_z%pressure(i,j,k) = 0_dp
          fluxes_z%Bx(i,j,k) = 0_dp; fluxes_z%By(i,j,k) = 0_dp; fluxes_z%Bz(i,j,k) = 0_dp
          do n = 1, nvar-5
             fluxes_z%scalar(i,j,k,n) = 0_dp
          end do
       end if
    end do

    call syncthreads()

  end subroutine zero_euler_fluxes_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C4b) Zero an edge EMF if ANY of the (up to 4) cells touching
  !> that edge is refined. Port of CPU godunov_fine.f90:672-708. The edge (I,J,K)
  !> in the local frame (v4.1 anisotropic edge family: 18 edges per orientation)
  !> is at subgrid corner (X,Y,Z)=(I+2,J+2,K+2); the
  !> four cells are the CPU okloc(i3-+..) neighbours mapped to the subgrid.
  attributes(device) subroutine zero_fine_emf(local_mhd, emfx, emfy, emfz, thread_idx)
    type(subgrid_6x6x6cell_primitive_mhd), intent(in) :: local_mhd
    type(subgrid_2x3x3edge_primitive), intent(inout) :: emfx
    type(subgrid_3x2x3edge_primitive), intent(inout) :: emfy
    type(subgrid_3x3x2edge_primitive), intent(inout) :: emfz
    integer, value :: thread_idx
    integer :: work_idx, emf_size, I, J, K, X, Y, Z

    emf_size = (2*nsubgrid+1)**2 * (2*nsubgrid)   ! 18 edges per orientation

    do work_idx = thread_idx, emf_size*3 - 1, blockDim%x
       if (work_idx < emf_size) then
          ! Edges parallel to z: I,J in [0,2*nsubgrid], K in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx, 2*nsubgrid+1, 2*nsubgrid+1, I, J, K)
          X = I+2; Y = J+2; Z = K+2
          if (local_mhd%refined(X-1,Y-1,Z) .or. local_mhd%refined(X,Y-1,Z) .or. &
               & local_mhd%refined(X-1,Y,Z) .or. local_mhd%refined(X,Y,Z)) emfz%edge_e(I,J,K) = 0_dp
       else if (work_idx < 2*emf_size) then
          ! Edges parallel to y: I,K in [0,2*nsubgrid], J in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx - emf_size, 2*nsubgrid+1, 2*nsubgrid, I, J, K)
          X = I+2; Y = J+2; Z = K+2
          if (local_mhd%refined(X-1,Y,Z-1) .or. local_mhd%refined(X,Y,Z-1) .or. &
               & local_mhd%refined(X-1,Y,Z) .or. local_mhd%refined(X,Y,Z)) emfy%edge_e(I,J,K) = 0_dp
       else
          ! Edges parallel to x: J,K in [0,2*nsubgrid], I in [0,2*nsubgrid-1].
          call index_1Dto3D(work_idx - 2*emf_size, 2*nsubgrid, 2*nsubgrid+1, I, J, K)
          X = I+2; Y = J+2; Z = K+2
          if (local_mhd%refined(X,Y-1,Z-1) .or. local_mhd%refined(X,Y,Z-1) .or. &
               & local_mhd%refined(X,Y-1,Z) .or. local_mhd%refined(X,Y,Z)) emfx%edge_e(I,J,K) = 0_dp
       end if
    end do

    call syncthreads()

  end subroutine zero_fine_emf
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C5) MHD conservative + constrained-transport update at the
  !> current level. The hydro part mirrors conservative_update (density/momentum/
  !> energy) and extends it to passive scalars (CPU godunov_fine.f90:764-769,
  !> unew(5+n) += scalar-flux diff). The CT part advances the 6 face-B of each
  !> cell by the discrete curl of the EMFs (CPU godunov_fine.f90:823-861), with the
  !> EMF *dt/dx scaling APPLIED EXACTLY ONCE HERE (C1/C3 keep raw E). bnew was
  !> pre-loaded with bold by set_unew (A3), so bnew = bold + dt/dx*curl(E). Each
  !> cell writes its own 6 faces -- no atomics at the current level (the shared
  !> oct-boundary edges get identical EMFs from both blocks, preserving the face-B
  !> redundancy / divB).
  attributes(device) subroutine conservative_update_mhd(unew, bnew, nbor, fluxes_x, fluxes_y, fluxes_z, &
       & emfx, emfy, emfz, head_idx, block_idx, thread_idx, dtdx)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    type(subgrid_3x2x2cell_primitive_mhd), intent(in) :: fluxes_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(in) :: fluxes_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(in) :: fluxes_z
    type(subgrid_2x3x3edge_primitive), intent(in) :: emfx
    type(subgrid_3x2x3edge_primitive), intent(in) :: emfy
    type(subgrid_3x3x2edge_primitive), intent(in) :: emfz
    integer(kind=4), value :: head_idx
    integer, value :: block_idx, thread_idx
    real(kind=dp), value :: dtdx

    integer :: work_size, i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: work_idx, subgrid_idx, oct_idx, cell_idx, ind_nbor, n
    real(kind=dp) :: ud, umx, umy, umz, ue, supd, dflux

    work_size = 2*nsubgrid

    do work_idx = thread_idx, work_size**3 - 1, blockDim%x
       subgrid_idx = head_idx + block_idx
       call index_1Dto3D(work_idx/8, work_size/2, work_size/2, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1
       j_subgrid_idx = j_subgrid_idx + 1
       k_subgrid_idx = k_subgrid_idx + 1
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2 * j_subgrid_idx + nsubgridp2sq * k_subgrid_idx
       oct_idx = nbor(ind_nbor, subgrid_idx)
       cell_idx = mod(work_idx, 8) + 1
       call index_1Dto3D(cell_idx - 1, 2, 2, i, j, k)
       i = i + 2*(i_subgrid_idx - 1)
       j = j + 2*(j_subgrid_idx - 1)
       k = k + 2*(k_subgrid_idx - 1)

       ! ---- Hydro conservative update (density, momentum, energy) -------------
       ud  = (fluxes_x%density   (i,j,k) - fluxes_x%density   (i+1,j,k)) * dtdx
       umx = (fluxes_x%velocity_x(i,j,k) - fluxes_x%velocity_x(i+1,j,k)) * dtdx
       umy = (fluxes_x%velocity_y(i,j,k) - fluxes_x%velocity_y(i+1,j,k)) * dtdx
       umz = (fluxes_x%velocity_z(i,j,k) - fluxes_x%velocity_z(i+1,j,k)) * dtdx
       ue  = (fluxes_x%pressure  (i,j,k) - fluxes_x%pressure  (i+1,j,k)) * dtdx
       ud  = ud  + (fluxes_y%density   (i,j,k) - fluxes_y%density   (i,j+1,k)) * dtdx
       umx = umx + (fluxes_y%velocity_x(i,j,k) - fluxes_y%velocity_x(i,j+1,k)) * dtdx
       umy = umy + (fluxes_y%velocity_y(i,j,k) - fluxes_y%velocity_y(i,j+1,k)) * dtdx
       umz = umz + (fluxes_y%velocity_z(i,j,k) - fluxes_y%velocity_z(i,j+1,k)) * dtdx
       ue  = ue  + (fluxes_y%pressure  (i,j,k) - fluxes_y%pressure  (i,j+1,k)) * dtdx
       ud  = ud  + (fluxes_z%density   (i,j,k) - fluxes_z%density   (i,j,k+1)) * dtdx
       umx = umx + (fluxes_z%velocity_x(i,j,k) - fluxes_z%velocity_x(i,j,k+1)) * dtdx
       umy = umy + (fluxes_z%velocity_y(i,j,k) - fluxes_z%velocity_y(i,j,k+1)) * dtdx
       umz = umz + (fluxes_z%velocity_z(i,j,k) - fluxes_z%velocity_z(i,j,k+1)) * dtdx
       ue  = ue  + (fluxes_z%pressure  (i,j,k) - fluxes_z%pressure  (i,j,k+1)) * dtdx
       unew(cell_idx, 1, oct_idx) = unew(cell_idx, 1, oct_idx) + ud
       unew(cell_idx, 2, oct_idx) = unew(cell_idx, 2, oct_idx) + umx
       unew(cell_idx, 3, oct_idx) = unew(cell_idx, 3, oct_idx) + umy
       unew(cell_idx, 4, oct_idx) = unew(cell_idx, 4, oct_idx) + umz
       unew(cell_idx, 5, oct_idx) = unew(cell_idx, 5, oct_idx) + ue

       ! ---- Passive scalars: unew(5+n) += scalar-flux diff --------------------
       do n = 1, nvar-5
          supd = (fluxes_x%scalar(i,j,k,n) - fluxes_x%scalar(i+1,j,k,n)) * dtdx &
               & + (fluxes_y%scalar(i,j,k,n) - fluxes_y%scalar(i,j+1,k,n)) * dtdx &
               & + (fluxes_z%scalar(i,j,k,n) - fluxes_z%scalar(i,j,k+1,n)) * dtdx
          unew(cell_idx, 5+n, oct_idx) = unew(cell_idx, 5+n, oct_idx) + supd
       end do

       ! ---- Constrained-transport update of the 6 face-B (CPU :823-861) -------
       ! EMF indices are in the per-orientation edge frame (v4.1 family); (i,j,k)
       ! here is the oct-local cell coord {0,1} (i_subgrid_idx==1 for nsubgrid=1).
       ! *dtdx ONCE.
       dflux = ( (emfy%edge_e(i,j,k)-emfy%edge_e(i,j,k+1)) - (emfz%edge_e(i,j,k)-emfz%edge_e(i,j+1,k)) ) * dtdx
       bnew(cell_idx, 1, oct_idx) = bnew(cell_idx, 1, oct_idx) + dflux
       dflux = ( (emfy%edge_e(i+1,j,k)-emfy%edge_e(i+1,j,k+1)) - (emfz%edge_e(i+1,j,k)-emfz%edge_e(i+1,j+1,k)) ) * dtdx
       bnew(cell_idx, 4, oct_idx) = bnew(cell_idx, 4, oct_idx) + dflux
       dflux = ( (emfz%edge_e(i,j,k)-emfz%edge_e(i+1,j,k)) - (emfx%edge_e(i,j,k)-emfx%edge_e(i,j,k+1)) ) * dtdx
       bnew(cell_idx, 2, oct_idx) = bnew(cell_idx, 2, oct_idx) + dflux
       dflux = ( (emfz%edge_e(i,j+1,k)-emfz%edge_e(i+1,j+1,k)) - (emfx%edge_e(i,j+1,k)-emfx%edge_e(i,j+1,k+1)) ) * dtdx
       bnew(cell_idx, 5, oct_idx) = bnew(cell_idx, 5, oct_idx) + dflux
       dflux = ( (emfx%edge_e(i,j,k)-emfx%edge_e(i,j+1,k)) - (emfy%edge_e(i,j,k)-emfy%edge_e(i+1,j,k)) ) * dtdx
       bnew(cell_idx, 3, oct_idx) = bnew(cell_idx, 3, oct_idx) + dflux
       dflux = ( (emfx%edge_e(i,j,k+1)-emfx%edge_e(i,j+1,k+1)) - (emfy%edge_e(i,j,k+1)-emfy%edge_e(i+1,j,k+1)) ) * dtdx
       bnew(cell_idx, 6, oct_idx) = bnew(cell_idx, 6, oct_idx) + dflux

    end do

  end subroutine conservative_update_mhd
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C6 helper) For the neighbouring oct at oct-offset (di,dj,dk)
  !> from this block's central oct, report whether it is a COARSE (cache) oct and,
  !> if so, the parent coarse oct index + cell index it stands for. This is the
  !> GPU analog of the CPU childloc/gridloc/cellloc lookup: a cache oct has index
  !> > ngridmax (it represents an unrefined level-(ilevel-1) cell); its coarse cell
  !> is father(cache) + the ckey-derived child position (same idiom as the hydro
  !> coarse_cell_update). is_coarse maps to the CPU .not.ok(childloc).
  attributes(device) subroutine get_cf_cell(nbor, grid, father, subgrid_idx, ngridmax, &
       & di, dj, dk, is_coarse, coct, ccell)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, value :: subgrid_idx, ngridmax, di, dj, dk
    logical, intent(out) :: is_coarse
    integer, intent(out) :: coct, ccell
    integer :: stencil_idx, nbidx, fidx, ci, cj, ck

    stencil_idx = 1 + (1+di) + nsubgridp2*(1+dj) + nsubgridp2sq*(1+dk)
    nbidx = nbor(stencil_idx, subgrid_idx)
    is_coarse = (nbidx > ngridmax)
    coct = 0; ccell = 1
    if (is_coarse) then
       fidx = father(nbidx)
       ci = grid(nbidx)%ckey(1) - 2*grid(fidx)%ckey(1)
       cj = grid(nbidx)%ckey(2) - 2*grid(fidx)%ckey(2)
       ck = grid(nbidx)%ckey(3) - 2*grid(fidx)%ckey(3)
       ccell = 1 + ci + 2*cj + 4*ck
       coct = fidx
    end if
  end subroutine get_cf_cell
  ! =========================================================================

  ! =========================================================================
  !> @brief (Stage C6) MHD coarse/fine correction at level ilevel-1. Two parts:
  !>  (1) Hydro flux correction -- mirrors the (proven) cube coarse_cell_update,
  !>      extended to passive scalars (unew slot 5+n from the scalar flux). The 6
  !>      oct-boundary faces' summed fine fluxes are atomicadded into the coarse
  !>      parent cell (found via nbor>ngridmax -> father -> ckey).
  !>  (2) Coarse/fine EMF correction -- port of CPU godunov_fine.f90:1037-1282. At
  !>      each of the central oct's 12 boundary edges, the fine EMF is averaged
  !>      (*0.25*weight) into the coarse face-B of whichever of the (up to 3) octs
  !>      sharing the edge are coarse. weight=0.5 if any sharer is refined, else 1.
  !>      Done by thread 0 only (12 edges; atomicadd handles cross-block races).
  !>
  !>  ##### HIGHEST-RISK / LEAST-VERIFIED STAGE. ##### The CPU uses a childloc/
  !>  gridloc/cellloc neighbourhood workspace; this re-expresses it on the GPU
  !>  nbor/father/ckey model. It is NOT exercised by E2 (level-min: C6 is never
  !>  called) and reaching E3 (AMR) also needs D4 (interpol_mhd, out of scope). The
  !>  edge slot/sign/weight tables below are transcribed from the CPU; they are the
  !>  primary thing to validate (max|divB| over time) once E3 is reachable.
  attributes(device) subroutine coarse_cell_update_mhd(grid, unew, bnew, father, nbor, &
       & fluxes_x, fluxes_y, fluxes_z, emfx, emfy, emfz, head_idx, block_idx, thread_idx, ngridmax, dtdx)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, device :: nbor(1:subgridsize,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    type(subgrid_3x2x2cell_primitive_mhd), intent(in) :: fluxes_x
    type(subgrid_2x3x2cell_primitive_mhd), intent(in) :: fluxes_y
    type(subgrid_2x2x3cell_primitive_mhd), intent(in) :: fluxes_z
    type(subgrid_2x3x3edge_primitive), intent(in) :: emfx
    type(subgrid_3x2x3edge_primitive), intent(in) :: emfy
    type(subgrid_3x3x2edge_primitive), intent(in) :: emfz
    integer, value :: head_idx, block_idx, thread_idx, ngridmax
    real(kind=dp), value :: dtdx
    real(kind=dp), parameter :: inv_twotondim = 1.0_dp / real(twotondim, kind=dp)

    integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
    integer :: subgrid_idx, cell_idx, source_idx, father_idx, work_idx
    integer :: interface_array_size, info, ind_nbor, n
    real(kind=dp) :: fd, fmx, fmy, fmz, fe, fs(1:nvar-5), scale, dflux, weight
    logical :: c1, c2, c3
    integer :: oc1, oc2, oc3, cc1, cc2, cc3

    interface_array_size = nsubgrid**(ndim-1)
    scale = dtdx * inv_twotondim
    subgrid_idx = head_idx + block_idx

    ! =================================================================
    ! Part 1: hydro flux + passive-scalar coarse/fine correction
    ! =================================================================
    if (thread_idx < interface_array_size) then            ! left X
       work_idx = thread_idx
       call index_1Dto2D(work_idx, nsubgrid, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = 0; j_subgrid_idx = j_subgrid_idx + 1; k_subgrid_idx = k_subgrid_idx + 1
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do j = 2*j_subgrid_idx-2, 2*j_subgrid_idx-1
          do k = 2*k_subgrid_idx-2, 2*k_subgrid_idx-1
             fd  = fd  - fluxes_x%density   (0,j,k)*scale; fmx = fmx - fluxes_x%velocity_x(0,j,k)*scale
             fmy = fmy - fluxes_x%velocity_y(0,j,k)*scale; fmz = fmz - fluxes_x%velocity_z(0,j,k)*scale
             fe  = fe  - fluxes_x%pressure  (0,j,k)*scale
             do n=1,nvar-5; fs(n) = fs(n) - fluxes_x%scalar(0,j,k,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    else if (thread_idx < 2*interface_array_size) then     ! right X
       work_idx = thread_idx - interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, j_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = nsubgrid+1; j_subgrid_idx = j_subgrid_idx + 1; k_subgrid_idx = k_subgrid_idx + 1
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do j = 2*j_subgrid_idx-2, 2*j_subgrid_idx-1
          do k = 2*k_subgrid_idx-2, 2*k_subgrid_idx-1
             fd  = fd  + fluxes_x%density   (2*nsubgrid,j,k)*scale; fmx = fmx + fluxes_x%velocity_x(2*nsubgrid,j,k)*scale
             fmy = fmy + fluxes_x%velocity_y(2*nsubgrid,j,k)*scale; fmz = fmz + fluxes_x%velocity_z(2*nsubgrid,j,k)*scale
             fe  = fe  + fluxes_x%pressure  (2*nsubgrid,j,k)*scale
             do n=1,nvar-5; fs(n) = fs(n) + fluxes_x%scalar(2*nsubgrid,j,k,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    else if (thread_idx < 3*interface_array_size) then     ! left Y
       work_idx = thread_idx - 2*interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1; j_subgrid_idx = 0; k_subgrid_idx = k_subgrid_idx + 1
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do i = 2*i_subgrid_idx-2, 2*i_subgrid_idx-1
          do k = 2*k_subgrid_idx-2, 2*k_subgrid_idx-1
             fd  = fd  - fluxes_y%density   (i,0,k)*scale; fmx = fmx - fluxes_y%velocity_x(i,0,k)*scale
             fmy = fmy - fluxes_y%velocity_y(i,0,k)*scale; fmz = fmz - fluxes_y%velocity_z(i,0,k)*scale
             fe  = fe  - fluxes_y%pressure  (i,0,k)*scale
             do n=1,nvar-5; fs(n) = fs(n) - fluxes_y%scalar(i,0,k,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    else if (thread_idx < 4*interface_array_size) then     ! right Y
       work_idx = thread_idx - 3*interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, k_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1; j_subgrid_idx = nsubgrid+1; k_subgrid_idx = k_subgrid_idx + 1
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do i = 2*i_subgrid_idx-2, 2*i_subgrid_idx-1
          do k = 2*k_subgrid_idx-2, 2*k_subgrid_idx-1
             fd  = fd  + fluxes_y%density   (i,2*nsubgrid,k)*scale; fmx = fmx + fluxes_y%velocity_x(i,2*nsubgrid,k)*scale
             fmy = fmy + fluxes_y%velocity_y(i,2*nsubgrid,k)*scale; fmz = fmz + fluxes_y%velocity_z(i,2*nsubgrid,k)*scale
             fe  = fe  + fluxes_y%pressure  (i,2*nsubgrid,k)*scale
             do n=1,nvar-5; fs(n) = fs(n) + fluxes_y%scalar(i,2*nsubgrid,k,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    else if (thread_idx < 5*interface_array_size) then     ! left Z
       work_idx = thread_idx - 4*interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, j_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1; j_subgrid_idx = j_subgrid_idx + 1; k_subgrid_idx = 0
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do i = 2*i_subgrid_idx-2, 2*i_subgrid_idx-1
          do j = 2*j_subgrid_idx-2, 2*j_subgrid_idx-1
             fd  = fd  - fluxes_z%density   (i,j,0)*scale; fmx = fmx - fluxes_z%velocity_x(i,j,0)*scale
             fmy = fmy - fluxes_z%velocity_y(i,j,0)*scale; fmz = fmz - fluxes_z%velocity_z(i,j,0)*scale
             fe  = fe  - fluxes_z%pressure  (i,j,0)*scale
             do n=1,nvar-5; fs(n) = fs(n) - fluxes_z%scalar(i,j,0,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    else if (thread_idx < 6*interface_array_size) then     ! right Z
       work_idx = thread_idx - 5*interface_array_size
       call index_1Dto2D(work_idx, nsubgrid, i_subgrid_idx, j_subgrid_idx)
       i_subgrid_idx = i_subgrid_idx + 1; j_subgrid_idx = j_subgrid_idx + 1; k_subgrid_idx = nsubgrid+1
       fd=0_dp; fmx=0_dp; fmy=0_dp; fmz=0_dp; fe=0_dp
       do n=1,nvar-5; fs(n)=0_dp; end do
       do i = 2*i_subgrid_idx-2, 2*i_subgrid_idx-1
          do j = 2*j_subgrid_idx-2, 2*j_subgrid_idx-1
             fd  = fd  + fluxes_z%density   (i,j,2*nsubgrid)*scale; fmx = fmx + fluxes_z%velocity_x(i,j,2*nsubgrid)*scale
             fmy = fmy + fluxes_z%velocity_y(i,j,2*nsubgrid)*scale; fmz = fmz + fluxes_z%velocity_z(i,j,2*nsubgrid)*scale
             fe  = fe  + fluxes_z%pressure  (i,j,2*nsubgrid)*scale
             do n=1,nvar-5; fs(n) = fs(n) + fluxes_z%scalar(i,j,2*nsubgrid,n)*scale; end do
          end do
       end do
       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
       source_idx = nbor(ind_nbor, subgrid_idx)
       if (source_idx > ngridmax) then
          father_idx = father(source_idx)
          i = grid(source_idx)%ckey(1) - 2*grid(father_idx)%ckey(1)
          j = grid(source_idx)%ckey(2) - 2*grid(father_idx)%ckey(2)
          k = grid(source_idx)%ckey(3) - 2*grid(father_idx)%ckey(3)
          cell_idx = 1 + i + 2*j + 4*k
          info = atomicadd(unew(cell_idx,1,father_idx), fd);  info = atomicadd(unew(cell_idx,2,father_idx), fmx)
          info = atomicadd(unew(cell_idx,3,father_idx), fmy); info = atomicadd(unew(cell_idx,4,father_idx), fmz)
          info = atomicadd(unew(cell_idx,5,father_idx), fe)
          do n=1,nvar-5; info = atomicadd(unew(cell_idx,5+n,father_idx), fs(n)); end do
       end if
    end if

    ! =================================================================
    ! Part 2: coarse/fine EMF correction (CPU godunov_fine.f90:1037-1282).
    ! Done by thread 0; emfx/emfy/emfz are the fine EMFs in the per-orientation
    ! edge frame (v4.1 family); offsets
    ! (di,dj,dk) index the octs sharing each of the 12 boundary edges. c1/c2/c3 =
    ! is_coarse for those neighbours (CPU .not.ok1/2/3); weight=0.5 if any is
    ! refined. atomicadd handles other blocks correcting the same coarse cell.
    ! NB the GPU edge arrays hold RAW E (C5 scales its own curl inline), whereas
    ! the CPU h%emf* are stored dt/dx-scaled before this correction runs -- so
    ! every dflux below carries the *dtdx that the CPU applied at store time.
    ! =================================================================
    if (thread_idx == 0) then

       ! ---- 4 EMFz edges ----
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1,-1, 0, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfz%edge_e(0,0,0)+emfz%edge_e(0,0,1))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,5,oc1),dflux);  info=atomicadd(bnew(cc1,1,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,4,oc2),dflux);  info=atomicadd(bnew(cc2,5,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,2,oc3),-dflux); info=atomicadd(bnew(cc3,4,oc3),-dflux); endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 1, 0, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfz%edge_e(0,2,0)+emfz%edge_e(0,2,1))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,4,oc1),dflux);  info=atomicadd(bnew(cc1,5,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,2,oc2),-dflux); info=atomicadd(bnew(cc2,4,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,1,oc3),-dflux); info=atomicadd(bnew(cc3,2,oc3),dflux);  endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 1, 0, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfz%edge_e(2,2,0)+emfz%edge_e(2,2,1))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,2,oc1),-dflux); info=atomicadd(bnew(cc1,4,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,1,oc2),-dflux); info=atomicadd(bnew(cc2,2,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,5,oc3),dflux);  info=atomicadd(bnew(cc3,1,oc3),dflux);  endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1,-1, 0, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfz%edge_e(2,0,0)+emfz%edge_e(2,0,1))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,1,oc1),-dflux); info=atomicadd(bnew(cc1,2,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,5,oc2),dflux);  info=atomicadd(bnew(cc2,1,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,4,oc3),dflux);  info=atomicadd(bnew(cc3,5,oc3),-dflux); endif
       end if

       ! ---- 4 EMFx edges ----
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0,-1, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1,-1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfx%edge_e(0,0,0)+emfx%edge_e(1,0,0))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,6,oc1),dflux);  info=atomicadd(bnew(cc1,2,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,5,oc2),dflux);  info=atomicadd(bnew(cc2,6,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,3,oc3),-dflux); info=atomicadd(bnew(cc3,5,oc3),-dflux); endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0,-1, 1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0, 1, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfx%edge_e(0,0,2)+emfx%edge_e(1,0,2))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,5,oc1),dflux);  info=atomicadd(bnew(cc1,6,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,3,oc2),-dflux); info=atomicadd(bnew(cc2,5,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,2,oc3),-dflux); info=atomicadd(bnew(cc3,3,oc3),dflux);  endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0, 1, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1, 1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfx%edge_e(0,2,2)+emfx%edge_e(1,2,2))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,3,oc1),-dflux); info=atomicadd(bnew(cc1,5,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,2,oc2),-dflux); info=atomicadd(bnew(cc2,3,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,6,oc3),dflux);  info=atomicadd(bnew(cc3,2,oc3),dflux);  endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 1,-1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0,-1, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfx%edge_e(0,2,0)+emfx%edge_e(1,2,0))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,2,oc1),-dflux); info=atomicadd(bnew(cc1,3,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,6,oc2),dflux);  info=atomicadd(bnew(cc2,2,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,5,oc3),dflux);  info=atomicadd(bnew(cc3,6,oc3),-dflux); endif
       end if

       ! ---- 4 EMFy edges ----
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0,-1, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0,-1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfy%edge_e(0,0,0)+emfy%edge_e(0,1,0))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,6,oc1),-dflux); info=atomicadd(bnew(cc1,1,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,4,oc2),-dflux); info=atomicadd(bnew(cc2,6,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,3,oc3),dflux);  info=atomicadd(bnew(cc3,4,oc3),dflux);  endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax,-1, 0, 1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0, 1, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfy%edge_e(0,0,2)+emfy%edge_e(0,1,2))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,4,oc1),-dflux); info=atomicadd(bnew(cc1,6,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,3,oc2),dflux);  info=atomicadd(bnew(cc2,4,oc2),dflux);  endif
          if(c3)then; info=atomicadd(bnew(cc3,1,oc3),dflux);  info=atomicadd(bnew(cc3,3,oc3),-dflux); endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0, 1, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0, 1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0, 0, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfy%edge_e(2,0,2)+emfy%edge_e(2,1,2))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,3,oc1),dflux);  info=atomicadd(bnew(cc1,4,oc1),dflux);  endif
          if(c2)then; info=atomicadd(bnew(cc2,1,oc2),dflux);  info=atomicadd(bnew(cc2,3,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,6,oc3),-dflux); info=atomicadd(bnew(cc3,1,oc3),-dflux); endif
       end if
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0, 0, c1,oc1,cc1)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 1, 0,-1, c2,oc2,cc2)
       call get_cf_cell(nbor,grid,father,subgrid_idx,ngridmax, 0, 0,-1, c3,oc3,cc3)
       if (c1 .or. c3) then
          weight=1.0_dp; if(.not.c1 .or. .not.c2 .or. .not.c3) weight=0.5_dp
          dflux=(emfy%edge_e(2,0,0)+emfy%edge_e(2,1,0))*0.25_dp*weight*dtdx
          if(c1)then; info=atomicadd(bnew(cc1,1,oc1),dflux);  info=atomicadd(bnew(cc1,3,oc1),-dflux); endif
          if(c2)then; info=atomicadd(bnew(cc2,6,oc2),-dflux); info=atomicadd(bnew(cc2,1,oc2),-dflux); endif
          if(c3)then; info=atomicadd(bnew(cc3,4,oc3),-dflux); info=atomicadd(bnew(cc3,6,oc3),dflux);  endif
       end if

    end if

  end subroutine coarse_cell_update_mhd
  ! =========================================================================
#endif

  ! ##########################################################################
  ! ## STAGE B1: mhd_integrator_kernel SHARED-MEMORY BUDGET (all-resident)   ##
  ! ##########################################################################
  !
  ! The fused MHD Godunov+CT kernel keeps EVERY working buffer in shared memory
  ! -- no global scratch, mirroring the hydro kernel. Two observations make the
  ! footprint fit where the original cell-indexed design (~202 KB) could not:
  !
  !   1. The four 2D-Riemann corner states are consumed ONLY on the oct's edges
  !      (3x3x2 = 18 edges per orientation at nsubgrid=1, 4 corner slots each),
  !      so they are stored on that edge lattice (the subgrid_*edge_corner
  !      family) instead of the full 6^3 cell lattice: 165888 B -> 12096 B
  !      (the edge-parallel velocity is not stored -- no 2D solver reads it).
  !      This is the same anisotropic-extent move the v4.1 edge-EMF family made
  !      for the EMF outputs. The former global spill (mhd_corner_scratch,
  !      ~162 KB x the level's block count, i.e. tens of GB at production
  !      grids, plus a full global write+read round-trip per block) is GONE.
  !   2. The face-B transverse slopes (CPU dbf) are a pure 3-point limiter of
  !      the shared bf, so the trace recomputes the 12 values each cell needs
  !      inline (face_b_tvd_slope) instead of staging 12096 B per block in the
  !      former mhd_dbf_scratch global array. Cheaper than the round-trip.
  !
  ! Resident shared per block (nsubgrid=1, nvar=8, FP64; logical = 4 B):
  !   (A) subgrid_6x6x6cell_primitive_mhd  8*216*8 + 216*4         = 14688 B
  !       scalar_subgrid (nvar-5=3)        3*216*8                 =  5184 B
  !   (B) subgrid_face_b_t (bf)            3*216*8                 =  5184 B
  !   (D) subgrid_edge_e_t (exact extents) 3*(4*5*5)*8             =  2400 B
  !   (E) emfx+emfy+emfz (v4.1 family)     3*18*8                  =   432 B
  !   (F) corner_x/y/z (4 slots * 18 edges
  !       * 7 fields per orientation)      3*4032                  = 12096 B
  !   (G) 6 MHD interface arrays (11-wide) 6*12*11*8               =  6336 B
  !       ------------------------------------------------------------------
  !       TOTAL resident                                           = 46320 B
  !                                       = 45.2 KB < 48 KB static limit. OK.
  !
  ! Reference: hydro_integrator_kernel resident shared is 12384 B = 12.1 KB
  ! (subgrid_6x6x6cell_primitive 9504 + 6 interface arrays 2880); MHD is ~3.7x
  ! that, under the default 48 KB static limit at 64 threads/block -- no opt-in.
  ! NOTE: reducing threads/block does NOT shrink per-block shared memory (the
  ! subgrids are sized by nsubgrid, compile-time); raising nsubgrid past 1 will
  ! NOT fit (the corner family alone grows ~5.6x at nsubgrid=2) -- re-derive
  ! this budget before touching nsubgrid.
  ! ##########################################################################

#ifndef PAPER
  attributes(global) subroutine hydro_integrator_kernel(grid, uold, unew, f, father, nbor, &
       & head_idx, num_subgrids, ngridmax, ilevel, levelmin, levelmax, &
       & gamma, dt, dx, slope, riemann, constant_gravity)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, device :: nbor(1:subgridsize,*)
    real(kind=8), device :: constant_gravity(1:3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    integer, intent(in), value :: ngridmax
    integer, intent(in), value :: ilevel, levelmin, levelmax
    real(kind=dp), intent(in), value :: gamma
    real(kind=dp), intent(in), value :: dt
    real(kind=dp), intent(in), value :: dx
    integer, intent(in), value :: slope
    integer, intent(in), value :: riemann

    type(subgrid_3x2x2cell_primitive), shared :: left_interfaces_x, right_interfaces_x
    type(subgrid_2x3x2cell_primitive), shared :: left_interfaces_y, right_interfaces_y
    type(subgrid_2x2x3cell_primitive), shared :: left_interfaces_z, right_interfaces_z
    type(subgrid_6x6x6cell_primitive), shared :: local_subgrid
    real(kind=dp) :: dtdx
    integer :: block_idx  ! The index of this block, corresponds to the subgrid to load
    integer :: thread_idx ! The index of this thread within the block

    dtdx = dt/dx

    ! compute the various indices. Note the conversion to zero based indexing
    block_idx = blockIdx%x - 1
    thread_idx = threadIdx%x - 1

    ! thread guard, probably not needed since num_blocks should always be equal to num_subgrids
    if (block_idx >= num_subgrids) return

    ! =======================================================================
    ! Convert from conserved to primitive variables
    ! =======================================================================
    call subgrid_conserved_2_primitive(grid, uold, f, constant_gravity, nbor, &
         & head_idx, block_idx, thread_idx, gamma, dt, local_subgrid)

    ! =======================================================================
    ! Perform tracing step and compute the interface states
    ! =======================================================================
    ! This will compute the interface states and write them to shared memory
    call trace_3d(local_subgrid, thread_idx, &
         & left_interfaces_x, right_interfaces_x, left_interfaces_y, right_interfaces_y, &
         & left_interfaces_z, right_interfaces_z, gamma, dtdx, slope)

    ! =======================================================================
    ! Compute the fluxes.
    ! =======================================================================
    ! This will compute the fluxes and write them to shared memory. Note that
    ! it writes the fluxes to the `left_interfaces_?` arrays and that those
    ! fluxes are in the conserved variables despite what the member variables
    ! names say
    call riemann_driver(left_interfaces_x, right_interfaces_x, left_interfaces_y, &
         & right_interfaces_y, left_interfaces_z, right_interfaces_z, thread_idx, &
         & gamma, riemann)

    ! =======================================================================
    ! Zero fluxes at boundaries with finer levels.
    ! =======================================================================
    if (ilevel < levelmax) then
       call zero_fine_fluxes(local_subgrid, left_interfaces_x, left_interfaces_y, left_interfaces_z, thread_idx)
    endif

    ! =======================================================================
    ! Update the conserved variables at current level.
    ! =======================================================================
    call conservative_update(unew, nbor, left_interfaces_x, left_interfaces_y, left_interfaces_z, head_idx, block_idx, &
         & thread_idx, dtdx)

    ! =======================================================================
    ! Update the conserved variables at coarser level.
    ! =======================================================================
    if (ilevel > levelmin) then
       call coarse_cell_update(grid, unew, father, nbor, left_interfaces_x, left_interfaces_y, left_interfaces_z, &
            & head_idx, block_idx, thread_idx, ngridmax, dtdx)
    endif

  end subroutine hydro_integrator_kernel

  ! =========================================================================
  !> @brief (Stage C7) Fused cube ("rock") MHD Godunov + constrained-transport
  !> integrator. The MHD analog of hydro_integrator_kernel, dispatched by
  !> gpu_godunov under #ifdef MHD (this whole kernel is compiled only when MHD is
  !> defined; the rest of the build is intact otherwise). Pipeline over the
  !> shared 6^3 subgrid:
  !>   B2 subgrid_conserved_2_primitive_mhd  (rho,v,P,B + scalars + face-B bf)
  !>   C1 trace_3d_mhd                        (edge-E, predictor incl. inline
  !>                                           face-B dbf slopes (B3), qm/qp,
  !>                                           corners -> shared edge buffers)
  !>   C2 riemann_driver_mhd                  (1D fluxes)
  !>   C3 cmp_mag_flx_mhd                      (2D EMF solve, shared corners)
  !>   C4 zero_fine_fluxes_mhd + zero_fine_emf (if ilevel<levelmax)
  !>   C5 conservative_update_mhd             (cell update + CT, EMF *dt/dx once)
  !>   C6 coarse_cell_update_mhd              (if ilevel>levelmin)
  !> Every working buffer is in shared memory (B1 budget above) -- the kernel
  !> needs NO global scratch, exactly like hydro_integrator_kernel.
  !> slope=slope_type, slope_mag=slope_mag_type, riemann (1D), riemann2d (2D),
  !> induction are passed by value; gravity via constant_gravity/f.
#ifdef MHD
  attributes(global) subroutine mhd_integrator_kernel(grid, uold, unew, bold, bnew, &
       & f, father, nbor, &
       & head_idx, num_subgrids, ngridmax, ilevel, levelmin, levelmax, &
       & gamma, smallr, smallc, dt, dx, slope, slope_mag, riemann, riemann2d, &
       & switch_llf_dmin, switch_llf_pmin, induction, constant_gravity)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, device :: nbor(1:subgridsize,*)
    real(kind=8), device :: constant_gravity(1:3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    integer(kind=4), intent(in), value :: head_idx, num_subgrids
    integer, intent(in), value :: ngridmax, ilevel, levelmin, levelmax
    real(kind=dp), intent(in), value :: gamma, smallr, smallc, dt, dx
    real(kind=dp), intent(in), value :: switch_llf_dmin, switch_llf_pmin
    integer, intent(in), value :: slope, slope_mag, riemann, riemann2d
    logical, intent(in), value :: induction

    ! Resident shared buffers -- the whole working set. See the budget block
    ! above: 46320 B at nsubgrid=1, nvar=8 -> fits the 48 KB static limit.
    type(subgrid_6x6x6cell_primitive_mhd), shared :: local_mhd
    real(kind=dp), shared :: scalar_subgrid(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3, 1:nvar-5)
    type(subgrid_face_b_t), shared :: bf
    type(subgrid_edge_e_t), shared :: edge_e
    type(subgrid_2x3x3edge_primitive), shared :: emfx
    type(subgrid_3x2x3edge_primitive), shared :: emfy
    type(subgrid_3x3x2edge_primitive), shared :: emfz
    type(subgrid_2x3x3edge_corner), shared :: corner_x
    type(subgrid_3x2x3edge_corner), shared :: corner_y
    type(subgrid_3x3x2edge_corner), shared :: corner_z
    type(subgrid_3x2x2cell_primitive_mhd), shared :: left_x, right_x
    type(subgrid_2x3x2cell_primitive_mhd), shared :: left_y, right_y
    type(subgrid_2x2x3cell_primitive_mhd), shared :: left_z, right_z
    real(kind=dp) :: dtdx
    integer :: block_idx, thread_idx

    dtdx = dt/dx
    block_idx = blockIdx%x - 1
    thread_idx = threadIdx%x - 1
    if (block_idx >= num_subgrids) return

    ! B2: conserved -> primitive (+ cell-centred B + bf face buffer + scalars)
    call subgrid_conserved_2_primitive_mhd(grid, uold, bold, f, constant_gravity, nbor, &
         & head_idx, block_idx, thread_idx, gamma, smallr, smallc, dt, local_mhd, scalar_subgrid, bf)

    ! C1: edge-E + MUSCL predictor (with inline face-B dbf slopes, B3) + qm/qp
    !     + corner states into the shared edge-corner buffers
    call trace_3d_mhd(local_mhd, scalar_subgrid, bf, edge_e, &
         & corner_x, corner_y, corner_z, thread_idx, left_x, right_x, left_y, right_y, &
         & left_z, right_z, gamma, smallr, smallc, dx, dt, slope, slope_mag, induction)

    ! C2: 1D MHD fluxes (written back into the left_* interface arrays)
    call riemann_driver_mhd(left_x, right_x, left_y, right_y, left_z, right_z, &
         & thread_idx, gamma, smallr, smallc, riemann)

    ! Pure induction: zero the Euler fluxes so only the CT update acts
    ! (CPU godunov_fine.f90:667). induction is block-uniform, so the
    ! syncthreads inside the call is safe.
    if (induction) then
       call zero_euler_fluxes_mhd(left_x, left_y, left_z, thread_idx)
    endif

    ! C3: 2D EMF solve from the shared edge-corner buffers -> edge-EMF subgrids
    call cmp_mag_flx_mhd(corner_x, corner_y, corner_z, emfx, emfy, emfz, thread_idx, &
         & gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin, riemann2d)

    ! C4: zero fluxes + EMFs at refined boundaries (only if finer levels exist)
    if (ilevel < levelmax) then
       call zero_fine_fluxes_mhd(local_mhd, left_x, left_y, left_z, thread_idx)
       call zero_fine_emf(local_mhd, emfx, emfy, emfz, thread_idx)
    endif

    ! C5: conservative update at current level + constrained-transport B update
    call conservative_update_mhd(unew, bnew, nbor, left_x, left_y, left_z, emfx, emfy, emfz, &
         & head_idx, block_idx, thread_idx, dtdx)

    ! C6: coarse/fine flux + EMF correction into the parent level
    if (ilevel > levelmin) then
       call coarse_cell_update_mhd(grid, unew, bnew, father, nbor, left_x, left_y, left_z, &
            & emfx, emfy, emfz, head_idx, block_idx, thread_idx, ngridmax, dtdx)
    endif

  end subroutine mhd_integrator_kernel
#endif
#endif
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine hydro_crit(prim_lft, prim_mid, prim_rgt, ok, &
       & err_grad_d, err_grad_p, floor_d, floor_p)
    type(primitive_t) :: prim_lft, prim_mid, prim_rgt
    real(kind=dp), value :: err_grad_d, err_grad_p
    real(kind=dp), value :: floor_d, floor_p
    logical :: ok

    real(kind=8) :: err_lft, err_rgt, error

    ok = .false.

    if (err_grad_d > 0.0_dp) then
       err_lft = abs((prim_mid%density - prim_lft%density) / (prim_mid%density + prim_lft%density + floor_d))
       err_rgt = abs((prim_rgt%density - prim_mid%density) / (prim_rgt%density + prim_mid%density + floor_d))
       error = 2.0_dp*max(err_lft, err_rgt)
       if (error > err_grad_d) ok = .true.
    endif

    if (err_grad_p > 0.0_dp) then
       err_lft = abs((prim_mid%pressure - prim_lft%pressure) / (prim_mid%pressure + prim_lft%pressure + floor_d))
       err_rgt = abs((prim_rgt%pressure - prim_mid%pressure) / (prim_rgt%pressure + prim_mid%pressure + floor_d))
       error = 2.0_dp*max(err_lft, err_rgt)
       if (error > err_grad_p) ok = .true.
    endif

  end subroutine hydro_crit
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine hydro_flag_kernel(flag1, grid, nbor, uold, head_idx, num_octs, & 
       & gamma, err_grad_d, err_grad_p, floor_d, floor_p)
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    real(kind=dp), intent(in), value :: gamma
    real(kind=dp), intent(in), value :: err_grad_d, floor_d
    real(kind=dp), intent(in), value :: err_grad_p, floor_p

    integer :: cell_idx, oct_idx, block_idx, source_idx, subgrid_idx
    integer :: i, j, k, il, jl, kl, ir, jr, kr
    integer :: icell, inbor, idim, ind_nbor
    type(primitive_t) :: prim_lft, prim_mid, prim_rgt
    type(conserved_t) :: cons_lft, cons_mid, cons_rgt
    logical :: ok

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

    ! Compute subgrid idx
    subgrid_idx = (oct_idx - 1) / nsubgridtondim + 1

    ! Compute oct idx within subgrid
    oct_idx = (oct_idx - 1) - (subgrid_idx - 1) * nsubgridtondim
    k = oct_idx / nsubgridsq
    j = (oct_idx - k * nsubgridsq) / nsubgrid
    i = oct_idx - j * nsubgrid - k * nsubgridsq
    i = i + 1; j = j + 1; k = k + 1

    ! Compute true oct idx
    ind_nbor = 1 + i + nsubgridp2 * j  + nsubgridp2sq * k
    oct_idx = nbor(ind_nbor, subgrid_idx)

    ! Middle cell
    cons_mid%density    = uold(cell_idx, 1, oct_idx)
    cons_mid%momentum_x = uold(cell_idx, 2, oct_idx)
    cons_mid%momentum_y = uold(cell_idx, 3, oct_idx)
    cons_mid%momentum_z = uold(cell_idx, 4, oct_idx)
    cons_mid%energy     = uold(cell_idx, 5, oct_idx)
    prim_mid = conserved_2_primitive(cons_mid, gamma)

    ! Loop over dimensions
    do idim = 1, ndim

       il = 0; jl = 0; kl = 0
       ir = 0; jr = 0; kr = 0
       if (idim == 1) then
          il = iii(cell_idx, 2 * (idim-1) + 1)
          ir = iii(cell_idx, 2 * (idim-1) + 2)
       else if (idim == 2) then
          jl = iii(cell_idx, 2 * (idim-1) + 1)
          jr = iii(cell_idx, 2 * (idim-1) + 2)
       else
          kl = iii(cell_idx, 2 * (idim-1) + 1)
          kr = iii(cell_idx, 2 * (idim-1) + 2)
       endif

       ! Left cell
       icell = hhh(cell_idx, 2 * (idim-1) + 1)
       inbor = 1 + (i + il) + nsubgridp2 * (j + jl)  + nsubgridp2sq * (k + kl)
       source_idx = nbor(inbor, subgrid_idx)
       cons_lft%density    = uold(icell, 1, source_idx)
       cons_lft%momentum_x = uold(icell, 2, source_idx)
       cons_lft%momentum_y = uold(icell, 3, source_idx)
       cons_lft%momentum_z = uold(icell, 4, source_idx)
       cons_lft%energy     = uold(icell, 5, source_idx)
       prim_lft = conserved_2_primitive(cons_lft, gamma)

       ! Right cell
       icell = hhh(cell_idx, 2 * (idim-1) + 2)
       inbor = 1 + (i + ir) + nsubgridp2 * (j + jr)  + nsubgridp2sq * (k + kr)
       source_idx = nbor(inbor, subgrid_idx)
       cons_rgt%density    = uold(icell, 1, source_idx)
       cons_rgt%momentum_x = uold(icell, 2, source_idx)
       cons_rgt%momentum_y = uold(icell, 3, source_idx)
       cons_rgt%momentum_z = uold(icell, 4, source_idx)
       cons_rgt%energy     = uold(icell, 5, source_idx)
       prim_rgt = conserved_2_primitive(cons_rgt, gamma)

       ! Check refinement criteria
       call hydro_crit(prim_lft, prim_mid, prim_rgt, ok, err_grad_d, err_grad_p, floor_d, floor_p)

       ! If satisfied set flag1 to 1
       if (ok) flag1(cell_idx, oct_idx) = 1

    end do

  end subroutine hydro_flag_kernel
  ! =========================================================================~

  ! =========================================================================
  attributes(global) subroutine upload_kernel(grid, father, uold, bold, head_idx, num_octs, interpol_var, smallr)
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: father(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=4), intent(in), value :: interpol_var
    real(kind=dp), intent(in), value :: smallr

    integer :: tid, bid, cell_idx, oct_idx
    integer :: ind, father_idx, i, j, k
    integer :: ivar ! Conserved-variable slot (1:nvar, CPU upload_fine parity)
    integer :: idim ! Spatial dimension (face-B restriction / energy split)
    real(kind=dp) :: eint_sum, ekin, erad, emag ! interpol_var==1 internal-energy restriction
#ifdef MHD
    integer, dimension(1:6,1:4) :: hh ! Child cells lying on each parent face (MHD)
#endif
    real(kind=dp), parameter :: inv_twotondim = 1.0_dp / real(twotondim, kind=dp)

    ! Thread and block id
    tid = threadIdx%x - 1
    bid = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = tid + bid * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the parent cell idx
    father_idx = father(oct_idx)
    i = grid(oct_idx)%ckey(1) - 2 * grid(father_idx)%ckey(1)
    j = grid(oct_idx)%ckey(2) - 2 * grid(father_idx)%ckey(2)
    k = grid(oct_idx)%ckey(3) - 2 * grid(father_idx)%ckey(3)
    cell_idx = 1 + i + 2*j + 4*k

    ! Reset conservative variables and average the children, over ALL nvar slots
    ! (CPU upload_fine does ivar=1,nvar, upload.f90:141-149 -- the passive
    ! scalars at 6:nvar are restricted exactly like the five core variables).
    do ivar = 1, nvar
       uold(cell_idx, ivar, father_idx) = 0_dp
       do ind = 1, twotondim
          uold(cell_idx, ivar, father_idx) = uold(cell_idx, ivar, father_idx) + uold(ind, ivar, oct_idx) * inv_twotondim
       end do
    end do

    ! Restriction of the face-centred B field (mirrors CPU upload_fine, upload.f90:118-195).
    ! A parent face-B is the area-average of the child faces lying ON that parent face
    ! (twotondim/2 = 4 children share each parent face), NOT the twotondim volume average
    ! used above for uold. This averaging preserves the face-B redundancy across the parent
    ! level: a shared coarse face is the mean of the 4 fine faces on it, and those fine
    ! faces are pairwise equal across the two coarse cells, so divB stays at round-off.
#ifdef MHD
    ! Child cells whose low/high face on each axis lies on the corresponding parent face
    hh(1,1:4) = (/1,3,5,7/) ! low-x face children
    hh(2,1:4) = (/2,4,6,8/) ! high-x face children
    hh(3,1:4) = (/1,2,5,6/) ! low-y face children
    hh(4,1:4) = (/3,4,7,8/) ! high-y face children
    hh(5,1:4) = (/1,2,3,4/) ! low-z face children
    hh(6,1:4) = (/5,6,7,8/) ! high-z face children

    ! Reset parent face-B (this refined parent cell)
    do idim = 1, 6
       bold(cell_idx, idim, father_idx) = 0_dp
    end do

    ! Area-average each parent face from the 4 child faces lying on it
    do idim = 1, ndim
       ! Low-side face (component idim)
       do ind = 1, twotondim/2
          bold(cell_idx, idim, father_idx) = bold(cell_idx, idim, father_idx) &
               & + bold(hh(2*idim-1,ind), idim, oct_idx) / dble(twotondim/2)
       end do
       ! High-side face (component idim+3)
       do ind = 1, twotondim/2
          bold(cell_idx, idim+3, father_idx) = bold(cell_idx, idim+3, father_idx) &
               & + bold(hh(2*idim,ind), idim+3, oct_idx) / dble(twotondim/2)
       end do
    end do
#endif

    ! Average INTERNAL energy instead of total energy (interpol_var==1), mirroring CPU
    ! upload_fine (upload.f90:222-262). The slot-5 average above is TOTAL energy; when
    ! interpol_var==1 we OVERWRITE it: per child eint = E - ekin - erad - emag, average
    ! those, then add back the parent's ekin (+erad)(+emag) from the already-restricted
    ! parent cell. Per the PI, the GPU kernel's MISSING interpol_var==1 guard (it always
    ! averaged total energy) is the likely cause of the earlier hydro regression.
    if (interpol_var == 1) then
       eint_sum = 0.0_dp
       do ind = 1, twotondim
          ekin = 0.0_dp
          do idim = 1, 3
             ekin = ekin + 0.5_dp*uold(ind,idim+1,oct_idx)**2 / max(uold(ind,1,oct_idx), smallr)
          end do
          emag = 0.0_dp
#ifdef MHD
          ! Mirrors CPU upload.f90:233 EXACTLY: this emag is LINEAR in B
          ! (0.125*(B_lo+B_hi), no square), unlike courant_fine's 0.125*(.)**2. Kept
          ! bug-for-bug so the GPU restriction matches the CPU bit-for-bit.
          do idim = 1, 3
             emag = emag + 0.125_dp*(bold(ind,idim,oct_idx)+bold(ind,idim+3,oct_idx))
          end do
#endif
          erad = 0.0_dp
#if NENER>0
          do idim = 1, nener
             erad = erad + uold(ind,5+idim,oct_idx)
          end do
#endif
          eint_sum = eint_sum + uold(ind,5,oct_idx) - ekin - erad - emag
       end do
       ! Add back the parent-cell ekin (+erad)(+emag), recomputed from the restricted parent
       ekin = 0.0_dp
       do idim = 1, 3
          ekin = ekin + 0.5_dp*uold(cell_idx,idim+1,father_idx)**2 / max(uold(cell_idx,1,father_idx), smallr)
       end do
       emag = 0.0_dp
#ifdef MHD
       do idim = 1, 3
          emag = emag + 0.125_dp*(bold(cell_idx,idim,father_idx)+bold(cell_idx,idim+3,father_idx))
       end do
#endif
       erad = 0.0_dp
#if NENER>0
       do idim = 1, nener
          erad = erad + uold(cell_idx,5+idim,father_idx)
       end do
#endif
       uold(cell_idx,5,father_idx) = eint_sum*inv_twotondim + ekin + erad + emag
    end if

  end subroutine upload_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine set_uold_kernel(uold, unew, bold, bnew, head_idx, num_octs)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: block_idx ! The index of this block, corresponds to the oct to load
    integer :: cell_idx ! The index of the cell within the block
    integer :: oct_idx ! The index of the oct  within the block
#ifdef MHD
    integer :: ib ! Face-B component index (MHD)
    integer :: ivar ! Passive-scalar index (MHD, nvar>5)
#endif

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

    uold(cell_idx, 1, oct_idx) = unew(cell_idx, 1, oct_idx)
    uold(cell_idx, 2, oct_idx) = unew(cell_idx, 2, oct_idx)
    uold(cell_idx, 3, oct_idx) = unew(cell_idx, 3, oct_idx)
    uold(cell_idx, 4, oct_idx) = unew(cell_idx, 4, oct_idx)
    uold(cell_idx, 5, oct_idx) = unew(cell_idx, 5, oct_idx)

    ! Set bold to bnew (mirrors CPU set_uold, godunov_fine.f90:213 m%bold(:,:,i)=m%bnew(:,:,i))
    ! and write back the passive scalars that conservative_update_mhd advanced
    ! (slots 6:nvar; the cube hydro path never touches them, so do this only for MHD).
#ifdef MHD
    do ib = 1, 6
       bold(cell_idx, ib, oct_idx) = bnew(cell_idx, ib, oct_idx)
    end do
    do ivar = 6, nvar
       uold(cell_idx, ivar, oct_idx) = unew(cell_idx, ivar, oct_idx)
    end do
#endif

  end subroutine set_uold_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine set_unew_kernel(uold, unew, bold, bnew, head_idx, num_octs)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: block_idx ! The index of this block, corresponds to the oct to load
    integer :: cell_idx ! The index of the cell within the block
    integer :: oct_idx ! The index of the oct  within the block
#ifdef MHD
    integer :: ib ! Face-B component index (MHD)
    integer :: ivar ! Passive-scalar index (MHD, nvar>5)
#endif

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

    unew(cell_idx, 1, oct_idx) = uold(cell_idx, 1, oct_idx)
    unew(cell_idx, 2, oct_idx) = uold(cell_idx, 2, oct_idx)
    unew(cell_idx, 3, oct_idx) = uold(cell_idx, 3, oct_idx)
    unew(cell_idx, 4, oct_idx) = uold(cell_idx, 4, oct_idx)
    unew(cell_idx, 5, oct_idx) = uold(cell_idx, 5, oct_idx)

    ! Set bnew to bold (mirrors CPU set_unew, godunov_fine.f90:150 m%bnew(:,:,i)=m%bold(:,:,i))
    ! and seed unew with the passive scalars so conservative_update_mhd accumulates
    ! onto uold (slots 6:nvar; MHD-only, the cube hydro path never touches them).
#ifdef MHD
    do ib = 1, 6
       bnew(cell_idx, ib, oct_idx) = bold(cell_idx, ib, oct_idx)
    end do
    do ivar = 6, nvar
       unew(cell_idx, ivar, oct_idx) = uold(cell_idx, ivar, oct_idx)
    end do
#endif

  end subroutine set_unew_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sync_hydro(uold, f, constant_gravity, head_idx, num_octs, gamma, smallr, dt)
    real(kind=8), device :: constant_gravity(1:3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    real(kind=dp), intent(in), value :: gamma, smallr
    real(kind=8), intent(in), value :: dt

    integer :: block_idx, cell_idx, oct_idx
    type(primitive_t) :: prim
    type(conserved_t) :: cons
    real(kind=dp) :: rho, mx, my, mz, ener

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

#ifdef MHD
       ! MHD: apply the gravity source DIRECTLY on the conserved variables
       ! (CPU synchro_hydro_fine, synchro_hydro_fine.f90:88-115). The magnetic
       ! energy is never separated out -- it rides inside (E - kinetic), so it is
       ! not folded into a gas pressure (D3) and B is untouched. No bold needed.
       rho = max(uold(cell_idx, 1, oct_idx), smallr)
       mx  = uold(cell_idx, 2, oct_idx)
       my  = uold(cell_idx, 3, oct_idx)
       mz  = uold(cell_idx, 4, oct_idx)
       ener = uold(cell_idx, 5, oct_idx) - 0.5_dp*(mx*mx + my*my + mz*mz)/rho
#ifdef GRAV
       mx = mx + rho*f(cell_idx, 1, oct_idx)*dt
       my = my + rho*f(cell_idx, 2, oct_idx)*dt
       mz = mz + rho*f(cell_idx, 3, oct_idx)*dt
#else
       mx = mx + rho*constant_gravity(1)*dt
       my = my + rho*constant_gravity(2)*dt
       mz = mz + rho*constant_gravity(3)*dt
#endif
       ener = ener + 0.5_dp*(mx*mx + my*my + mz*mz)/rho
       uold(cell_idx, 2, oct_idx) = mx
       uold(cell_idx, 3, oct_idx) = my
       uold(cell_idx, 4, oct_idx) = mz
       uold(cell_idx, 5, oct_idx) = ener
#else
       ! Hydro: c2p -> velocity update -> p2c (unchanged).
       cons%density    = uold(cell_idx, 1, oct_idx)
       cons%momentum_x = uold(cell_idx, 2, oct_idx)
       cons%momentum_y = uold(cell_idx, 3, oct_idx)
       cons%momentum_z = uold(cell_idx, 4, oct_idx)
       cons%energy     = uold(cell_idx, 5, oct_idx)
       prim = conserved_2_primitive(cons, gamma)
#ifdef GRAV
       prim%velocity_x = prim%velocity_x + f(cell_idx, 1, oct_idx) * dt
       prim%velocity_y = prim%velocity_y + f(cell_idx, 2, oct_idx) * dt
       prim%velocity_z = prim%velocity_z + f(cell_idx, 3, oct_idx) * dt
#else
       prim%velocity_x = prim%velocity_x + constant_gravity(1) * dt
       prim%velocity_y = prim%velocity_y + constant_gravity(2) * dt
       prim%velocity_z = prim%velocity_z + constant_gravity(3) * dt
#endif
       cons = primitive_2_conserved(prim, gamma)
       uold(cell_idx, 1, oct_idx) = cons%density
       uold(cell_idx, 2, oct_idx) = cons%momentum_x
       uold(cell_idx, 3, oct_idx) = cons%momentum_y
       uold(cell_idx, 4, oct_idx) = cons%momentum_z
       uold(cell_idx, 5, oct_idx) = cons%energy
#endif

  end subroutine sync_hydro
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine grav_hydro(uold, unew, f, constant_gravity, head_idx, num_octs, gamma, smallr, dt)
    real(kind=8), device :: constant_gravity(1:3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    real(kind=dp), intent(in), value :: gamma, smallr
    real(kind=8), intent(in), value :: dt

    integer :: block_idx, cell_idx, oct_idx
    real(kind=dp) :: rho_old_new_ratio_dt
    real(kind=dp) :: d, mx, my, mz, e_prim, fact
    type(primitive_t) :: prim
    type(conserved_t) :: cons

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

#ifdef MHD
       ! MHD: gravity source DIRECTLY on the conserved unew (CPU gravity_hydro_fine,
       ! synchro_hydro_fine.f90:177-207). emag stays inside (E - kinetic) -> not
       ! folded into pressure (D3); B is untouched; no bold needed. The dispatcher
       ! passes dt = 0.5*dtnew, so fact = d_old/d*dt == CPU d_old/d*0.5*dtnew.
       d  = max(unew(cell_idx, 1, oct_idx), smallr)
       mx = unew(cell_idx, 2, oct_idx)
       my = unew(cell_idx, 3, oct_idx)
       mz = unew(cell_idx, 4, oct_idx)
       e_prim = unew(cell_idx, 5, oct_idx) - 0.5_dp*(mx*mx + my*my + mz*mz)/d
       fact = max(uold(cell_idx, 1, oct_idx), smallr)/d * dt
#ifdef GRAV
       mx = mx + d*f(cell_idx, 1, oct_idx)*fact
       my = my + d*f(cell_idx, 2, oct_idx)*fact
       mz = mz + d*f(cell_idx, 3, oct_idx)*fact
#else
       mx = mx + d*constant_gravity(1)*fact
       my = my + d*constant_gravity(2)*fact
       mz = mz + d*constant_gravity(3)*fact
#endif
       unew(cell_idx, 2, oct_idx) = mx
       unew(cell_idx, 3, oct_idx) = my
       unew(cell_idx, 4, oct_idx) = mz
       unew(cell_idx, 5, oct_idx) = e_prim + 0.5_dp*(mx*mx + my*my + mz*mz)/d
#else
       ! Hydro: c2p -> velocity update -> p2c (unchanged).
       cons%density    = unew(cell_idx, 1, oct_idx)
       cons%momentum_x = unew(cell_idx, 2, oct_idx)
       cons%momentum_y = unew(cell_idx, 3, oct_idx)
       cons%momentum_z = unew(cell_idx, 4, oct_idx)
       cons%energy     = unew(cell_idx, 5, oct_idx)
       prim = conserved_2_primitive(cons, gamma)
       rho_old_new_ratio_dt = dt * uold(cell_idx, 1, oct_idx) / unew(cell_idx, 1, oct_idx)
#ifdef GRAV
       prim%velocity_x = prim%velocity_x + f(cell_idx, 1, oct_idx) * rho_old_new_ratio_dt
       prim%velocity_y = prim%velocity_y + f(cell_idx, 2, oct_idx) * rho_old_new_ratio_dt
       prim%velocity_z = prim%velocity_z + f(cell_idx, 3, oct_idx) * rho_old_new_ratio_dt
#else
       prim%velocity_x = prim%velocity_x + constant_gravity(1) * rho_old_new_ratio_dt
       prim%velocity_y = prim%velocity_y + constant_gravity(2) * rho_old_new_ratio_dt
       prim%velocity_z = prim%velocity_z + constant_gravity(3) * rho_old_new_ratio_dt
#endif
       cons = primitive_2_conserved(prim, gamma)
       unew(cell_idx, 1, oct_idx) = cons%density
       unew(cell_idx, 2, oct_idx) = cons%momentum_x
       unew(cell_idx, 3, oct_idx) = cons%momentum_y
       unew(cell_idx, 4, oct_idx) = cons%momentum_z
       unew(cell_idx, 5, oct_idx) = cons%energy
#endif

  end subroutine grav_hydro
  ! =========================================================================

  ! =========================================================================
  ! Comments from Guillaume:
  ! Modifying data_out, vol_loc, mass_loc, ekin_loc, eint_loc, emag_loc, dt_loc, sound_speed, grav, ctot 
  ! requires changing other files in the code. This should be done if OK for numerical accuracy.
  ! In this case, all the 'd0' should be changed to '_dp'
  attributes(global) subroutine cmpdt_kernel(grid, uold, bold, f, constant_gravity, &
      & head_idx, num_octs, data_out, dx, gamma, smallr, smallc, courant_factor, induction)
    type(oct), device :: grid(*)
    real(kind=8), device :: constant_gravity(3)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    real(kind=8), device :: data_out(*) !mass, ekin, eint, emag, dt
    real(kind=dp), value :: dx, gamma, smallr, smallc, courant_factor
    logical, value :: induction

    type(primitive_t) :: primitive
    type(conserved_t) :: conserved
#ifdef MHD
    type(primitive_mhd_t) :: prim_mhd
#endif
    integer :: info
    integer :: tid, bid ! The index of the thread and the block
    integer :: cell_idx ! The index of the cell
    integer :: oct_idx ! The index of the oct
    real(kind=8) :: vol_loc, mass_loc, ekin_loc, eint_loc, emag_loc, dt_loc
    real(kind=8) :: sound_speed, grav, ctot
    real(kind=8) :: a2, b2sq, c2v, pp, rinv

    ! Thread and block id
    tid = threadIdx%x - 1
    bid = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = ( tid + bid * blockDim%x ) / twotondim

    ! If not in block
    if (oct_idx >= num_octs) then

       dt_loc   = huge(0d0)
       mass_loc = 0d0
       ekin_loc = 0d0
       eint_loc = 0d0
       emag_loc = 0d0

    else

       oct_idx = head_idx + oct_idx

       ! Compute cell idx
       cell_idx = mod(tid, twotondim) + 1

       ! If refined
       if(grid(oct_idx)%refined(cell_idx))then

          dt_loc   = huge(0d0)
          mass_loc = 0d0
          ekin_loc = 0d0
          eint_loc = 0d0
          emag_loc = 0d0

       else

          ! Load the cell
          conserved%density    = uold(cell_idx, 1, oct_idx)
          conserved%momentum_x = uold(cell_idx, 2, oct_idx)
          conserved%momentum_y = uold(cell_idx, 3, oct_idx)
          conserved%momentum_z = uold(cell_idx, 4, oct_idx)
          conserved%energy     = uold(cell_idx, 5, oct_idx)

          vol_loc = dx*dx*dx
          mass_loc = conserved%density*vol_loc
          ekin_loc = conserved%energy*vol_loc

#ifdef MHD
             ! MHD: cell-centred B + emag-subtracted gas pressure (CPU cmpdt,
             ! godunov_utils.f90:244-305). Wave speed = |v_d| + fast magnetosonic
             ! speed per direction; sound speed (|v_d|+smallc) under induction.
             prim_mhd = mhd_conserved_2_primitive(conserved, &
                  & bold(cell_idx,1,oct_idx), bold(cell_idx,4,oct_idx), &
                  & bold(cell_idx,2,oct_idx), bold(cell_idx,5,oct_idx), &
                  & bold(cell_idx,3,oct_idx), bold(cell_idx,6,oct_idx), gamma, smallr, smallc)
             pp = max(prim_mhd%pressure, prim_mhd%density*smallc*smallc/gamma)
             b2sq = compute_bsquared(prim_mhd%Bx, prim_mhd%By, prim_mhd%Bz)
             emag_loc = 0.5d0*b2sq*vol_loc
             eint_loc = pp/(gamma-1d0)*vol_loc
             rinv = 1.0d0 / prim_mhd%density
             a2 = gamma*pp*rinv
             if (induction) then
                ctot = abs(prim_mhd%velocity_x)+abs(prim_mhd%velocity_y)+abs(prim_mhd%velocity_z) + 3d0*smallc
             else
                c2v = 0.5d0*(b2sq*rinv + a2)
                ctot = abs(prim_mhd%velocity_x) + sqrt(c2v + sqrt(c2v**2 - a2*prim_mhd%Bx**2*rinv)) &
                     & + abs(prim_mhd%velocity_y) + sqrt(c2v + sqrt(c2v**2 - a2*prim_mhd%By**2*rinv)) &
                     & + abs(prim_mhd%velocity_z) + sqrt(c2v + sqrt(c2v**2 - a2*prim_mhd%Bz**2*rinv))
             endif
#else
             ! Convert to primitive variables (hydro)
             primitive = conserved_2_primitive(conserved, gamma)
             mass_loc = primitive%density*vol_loc
             eint_loc = primitive%pressure/(gamma-1d0)*vol_loc
             emag_loc = 0_dp
             sound_speed = sqrt(gamma*primitive%pressure/primitive%density)
             ctot = (abs(primitive%velocity_x)+abs(primitive%velocity_y)+abs(primitive%velocity_z)+3d0*sound_speed)
#endif
#ifdef GRAV
          grav = abs(f(cell_idx, 1, oct_idx)) + abs(f(cell_idx, 2, oct_idx)) + abs(f(cell_idx, 3, oct_idx))
#else
          grav = abs(constant_gravity(1)) + abs(constant_gravity(2)) + abs(constant_gravity(3))
#endif
          grav = grav*dx/ctot**2
          grav = MAX(grav,0.0001d0)
          dt_loc = dx / ctot*(sqrt(1d0+2d0*courant_factor*grav)-1d0)/grav

       end if

    endif

    dt_loc   = block_reduce_min(dt_loc)
    mass_loc = block_reduce_sum(mass_loc)
    ekin_loc = block_reduce_sum(ekin_loc)
    eint_loc = block_reduce_sum(eint_loc)
    emag_loc = block_reduce_sum(emag_loc)

    if(tid == 0)then
       info = atomicadd(data_out(1),mass_loc)
       info = atomicadd(data_out(2),ekin_loc)
       info = atomicadd(data_out(3),eint_loc)
       info = atomicadd(data_out(4),emag_loc)
       info = atomicmin(data_out(5),dt_loc)
    endif

  end subroutine cmpdt_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine gather_send_buffer(uold, uold_send, idx_send, num_send)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: uold_send(*)
    integer(kind=4), device :: idx_send(*)
    integer(kind=4), intent(in), value :: num_send

    integer :: buffer_idx ! The index of the sending buffer
    integer :: block_idx ! The index of the block
    integer :: cell_idx ! The index of the cell within the oct
    integer :: oct_idx ! The index of the oct
    integer :: pos_idx ! The position in the buffer
    integer :: ivar

    block_idx = blockIdx%x - 1

    ! Compute the buffer oct idx
    buffer_idx = block_idx * blockDim%y + threadIdx%y
    if (buffer_idx > num_send) return

    ! Compute the grid oct idx
    oct_idx = idx_send(buffer_idx)

    ! Compute the cell idx
    cell_idx = threadIdx%x

    ! Compute the buffer position
    do ivar = 1, nvar
       pos_idx = cell_idx + twotondim*(ivar-1) + twotondim*nvar*(buffer_idx-1)
       uold_send(pos_idx) = uold(cell_idx, ivar, oct_idx)
    end do

  end subroutine gather_send_buffer
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine scatter_recv_buffer(uold, uold_recv, idx_recv, num_recv)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: uold_recv(*)
    integer(kind=4), device :: idx_recv(*)
    integer(kind=4), intent(in), value :: num_recv

    integer :: buffer_idx ! The index of the receiving buffer
    integer :: block_idx ! The index of the block
    integer :: cell_idx ! The index of the cell within the oct
    integer :: oct_idx ! The index of the oct
    integer :: pos_idx ! The position in the buffer
    integer :: ivar

    block_idx = blockIdx%x - 1

    ! Compute the buffer oct idx
    buffer_idx = block_idx * blockDim%y + threadIdx%y
    if (buffer_idx > num_recv) return

    ! Compute the grid oct idx
    oct_idx = idx_recv(buffer_idx)

    ! Compute the cell idx
    cell_idx = threadIdx%x

    ! Compute the buffer position
    do ivar = 1, nvar
       pos_idx = cell_idx + twotondim*(ivar-1) + twotondim*nvar*(buffer_idx-1)
       uold(cell_idx, ivar, oct_idx) = uold_recv(pos_idx)
    end do

  end subroutine scatter_recv_buffer
  ! =========================================================================

  ! =========================================================================
  !> @brief Check an array of nvar reals for NaN and print location if found
  attributes(device) subroutine check_nan(label, arr, ix, iy, iz, ivar_hint)
    character(len=1), intent(in) :: label
    real(kind=dp), intent(in) :: arr(1:nvar)
    integer, value :: ix, iy, iz, ivar_hint
    integer :: iv
    do iv = 1, nvar
      if (arr(iv) /= arr(iv)) then
        print *, label, " NaN ivar=", iv, " hint=", ivar_hint
      end if
    end do
  end subroutine check_nan
  ! =========================================================================

  ! =========================================================================
  !> @brief Load conserved variables for a cell given a subgrid and a 1-based ubsgrid index. E.g. for an oct it runs from 1 to 6
  attributes(device) function load_conserved(ix, iy, iz, uold, nbor, subgrid_idx) result(Uin)

    real(kind=dp) :: Uin(1:nvar)

    integer(kind=4), intent(in) :: ix, iy, iz
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), value :: subgrid_idx

    integer :: jx, jy, jz, nbor_idx, cell_idx, oct_idx, ivar

    jx = (ix - 1)/2 ! oct coordinates (zero based)
    jy = (iy - 1)/2
    jz = (iz - 1)/2
    nbor_idx = 1 + jx + nsubgridp2 * jy + nsubgridp2sq * jz
    cell_idx = ix - 2*jx + 2*((iy-1) - 2*jy) + 4*((iz-1) - 2*jz)
    oct_idx = nbor(nbor_idx, subgrid_idx) ! Get idx of oct to load

    ! Load the cell
    do ivar = 1, nvar
       Uin(ivar) = uold(cell_idx, ivar, oct_idx)
    end do
  end function load_conserved

  ! =========================================================================
  !> @brief Add to conserved variables for a cell given a subgrid and a 1-based ubsgrid index. E.g. for an oct it runs from 1 to 6
  attributes(device) subroutine add_conserved(ix, iy, iz, dU, idim, unew, nbor, grid, father, subgrid_idx, ngridmax, &
       & skip_refined_fluxes, coarse_update)

    integer, value, intent(in) :: ix, iy, iz, idim
    real(kind=dp), intent(in) :: dU(1:nvar)

    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer(kind=4), value :: subgrid_idx
    integer, value :: ngridmax
    logical, value :: skip_refined_fluxes, coarse_update

    integer :: jx, jy, jz, kx, ky, kz, nbor_idx, cell_idx, oct_idx, father_oct_idx, ivar, info
    integer :: nx, ny, nz, neighbor_cell_idx, neighbor_oct_idx

    jx = (ix - 1)/2 ! oct coordinates (zero based)
    jy = (iy - 1)/2
    jz = (iz - 1)/2
    nbor_idx = 1 + jx + nsubgridp2 * jy + nsubgridp2sq * jz

    kx = (ix-1) - 2*jx ! cell coordinates (zero based)
    ky = (iy-1) - 2*jy
    kz = (iz-1) - 2*jz
    cell_idx = 1 + kx + 2*ky + 4*kz

    oct_idx = nbor(nbor_idx, subgrid_idx) ! Get oct to load

    if (oct_idx <= 0 .or. oct_idx > ngridmax) return
    if (skip_refined_fluxes) then
       if (grid(oct_idx)%refined(cell_idx)) return
    endif

    nx = ix; ny = iy; nz = iz
    if (idim == 1) nx = ix - 1
    if (idim == 2) ny = iy - 1
    if (idim == 3) nz = iz - 1
    if (idim == 4) nx = ix + 1
    if (idim == 5) ny = iy + 1
    if (idim == 6) nz = iz + 1

    jx = (nx - 1)/2
    jy = (ny - 1)/2
    jz = (nz - 1)/2
    nbor_idx = 1 + jx + nsubgridp2 * jy + nsubgridp2sq * jz

    kx = (nx-1) - 2*jx
    ky = (ny-1) - 2*jy
    kz = (nz-1) - 2*jz
    neighbor_cell_idx = 1 + kx + 2*ky + 4*kz
    neighbor_oct_idx = nbor(nbor_idx, subgrid_idx)

    if (neighbor_oct_idx <= 0) return
    if (skip_refined_fluxes .and. neighbor_oct_idx <= ngridmax) then
       if (grid(neighbor_oct_idx)%refined(neighbor_cell_idx)) return
    endif

    ! Accumulate flux to the cell
    do ivar = 1, nvar
       unew(cell_idx, ivar, oct_idx) = unew(cell_idx, ivar, oct_idx) + dU(ivar)
    end do

    if (.not. coarse_update) return
    if (neighbor_oct_idx <= ngridmax) return

    father_oct_idx = father(neighbor_oct_idx)
    kx = grid(neighbor_oct_idx)%ckey(1) - 2 * grid(father_oct_idx)%ckey(1)
    ky = grid(neighbor_oct_idx)%ckey(2) - 2 * grid(father_oct_idx)%ckey(2)
    kz = grid(neighbor_oct_idx)%ckey(3) - 2 * grid(father_oct_idx)%ckey(3)
    cell_idx = 1 + kx + 2*ky + 4*kz
    do ivar = 1, nvar
       info = atomicadd(unew(cell_idx, ivar, father_oct_idx), -dU(ivar) / real(twotondim, kind=dp))
    end do
  end subroutine add_conserved

  ! ---------------------------------------------------------------------------
  ! Device subroutine: compute slopes qds(ix,iy,ivar,dir) for one (ix,iy) point
  ! qds stores the gradient dqds, including the 1/dx factor.
  ! slope_type: 0=zero, 1=minmod, 2=moncen, 3=positivity-preserving 3D unsplit
  ! q_storage layout: (1:m+4, 1:m+4, nvar, 3) with slots im(=prev), ic(=curr), ip(=next)
  ! qds layout: (2:m+3, 2:m+3, nvar, 3) with slots for X/Y/Z slopes.
  ! ---------------------------------------------------------------------------
  attributes(device) subroutine compute_slopes(q_storage, qds, ix, iy, ic, im, ip, idx, slope_type, mf, nvar)
    implicit none
    integer, value :: ix, iy, ic, im, ip, mf, nvar, slope_type
    real(kind=dp), value :: idx
    real(kind=dp), intent(in)  :: q_storage(1:mf, 1:mf, nvar, 3)
    real(kind=dp), intent(out) :: qds(2:mf-1, 2:mf-1, nvar, 3)

    integer  :: ivar
    real(kind=dp) :: dlft, drgt, dcen, dsgn, slop, dlim, dfx, dfy, dfz, dff
    real(kind=dp) :: vmin, vmax
    real(kind=dp) :: dflll,dflml,dflrl,dfmll,dfmml,dfmrl,dfrll,dfrml,dfrrl
    real(kind=dp) :: dfllm,dflmm,dflrm,dfmlm,dfmmm,dfmrm,dfrlm,dfrmm,dfrrm
    real(kind=dp) :: dfllr,dflmr,dflrr,dfmlr,dfmmr,dfmrr,dfrlr,dfrmr,dfrrr
    real(kind=dp), parameter :: half = 0.5_dp, zero = 0.0_dp, one = 1.0_dp

    select case (slope_type)

    case (0)
      do ivar = 1, nvar
        qds(ix,iy,ivar,1) = zero
        qds(ix,iy,ivar,2) = zero
        qds(ix,iy,ivar,3) = zero
      end do

    case (1)
      ! minmod: slope = min(|dlft|, |drgt|) with common sign, else 0
      do ivar = 1, nvar
        ! X
        dlft = q_storage(ix,  iy,  ivar,ic) - q_storage(ix-1,iy,  ivar,ic)
        drgt = q_storage(ix+1,iy,  ivar,ic) - q_storage(ix,  iy,  ivar,ic)
        if (dlft*drgt <= zero) then
          qds(ix,iy,ivar,1) = zero
        else if (dlft > zero) then
          qds(ix,iy,ivar,1) = min(dlft, drgt) * idx
        else
          qds(ix,iy,ivar,1) = max(dlft, drgt) * idx
        end if
        ! Y
        dlft = q_storage(ix,  iy,  ivar,ic) - q_storage(ix,  iy-1,ivar,ic)
        drgt = q_storage(ix,  iy+1,ivar,ic) - q_storage(ix,  iy,  ivar,ic)
        if (dlft*drgt <= zero) then
          qds(ix,iy,ivar,2) = zero
        else if (dlft > zero) then
          qds(ix,iy,ivar,2) = min(dlft, drgt) * idx
        else
          qds(ix,iy,ivar,2) = max(dlft, drgt) * idx
        end if
        ! Z
        dlft = q_storage(ix,  iy,  ivar,ic) - q_storage(ix,  iy,  ivar,im)
        drgt = q_storage(ix,  iy,  ivar,ip) - q_storage(ix,  iy,  ivar,ic)
        if (dlft*drgt <= zero) then
          qds(ix,iy,ivar,3) = zero
        else if (dlft > zero) then
          qds(ix,iy,ivar,3) = min(dlft, drgt) * idx
        else
          qds(ix,iy,ivar,3) = max(dlft, drgt) * idx
        end if
      end do

    case (2)
      ! moncen: slope = sign(dcen)*min(|dcen|, 2|dlft|, 2|drgt|), 0 if sign change
      do ivar = 1, nvar
        ! X
        dlft = 2.0_dp*(q_storage(ix,  iy,  ivar,ic) - q_storage(ix-1,iy,  ivar,ic))
        drgt = 2.0_dp*(q_storage(ix+1,iy,  ivar,ic) - q_storage(ix,  iy,  ivar,ic))
        dcen = half*(dlft + drgt) * half
        dsgn = sign(one, dcen)
        slop = min(abs(dlft), abs(drgt))
        dlim = merge(zero, slop, (dlft*drgt <= zero))
        qds(ix,iy,ivar,1) = dsgn * min(dlim, abs(dcen)) * idx
        ! Y
        dlft = 2.0_dp*(q_storage(ix,  iy,  ivar,ic) - q_storage(ix,  iy-1,ivar,ic))
        drgt = 2.0_dp*(q_storage(ix,  iy+1,ivar,ic) - q_storage(ix,  iy,  ivar,ic))
        dcen = half*(dlft + drgt) * half
        dsgn = sign(one, dcen)
        slop = min(abs(dlft), abs(drgt))
        dlim = merge(zero, slop, (dlft*drgt <= zero))
        qds(ix,iy,ivar,2) = dsgn * min(dlim, abs(dcen)) * idx
        ! Z
        dlft = 2.0_dp*(q_storage(ix,  iy,  ivar,ic) - q_storage(ix,  iy,  ivar,im))
        drgt = 2.0_dp*(q_storage(ix,  iy,  ivar,ip) - q_storage(ix,  iy,  ivar,ic))
        dcen = half*(dlft + drgt) * half
        dsgn = sign(one, dcen)
        slop = min(abs(dlft), abs(drgt))
        dlim = merge(zero, slop, (dlft*drgt <= zero))
        qds(ix,iy,ivar,3) = dsgn * min(dlim, abs(dcen)) * idx
      end do

    case (3)
      ! positivity-preserving 3D unsplit: uses all 27 neighbours
      do ivar = 1, nvar
        dflll = q_storage(ix-1,iy-1,ivar,im) - q_storage(ix,iy,ivar,ic)
        dflml = q_storage(ix-1,iy,  ivar,im) - q_storage(ix,iy,ivar,ic)
        dflrl = q_storage(ix-1,iy+1,ivar,im) - q_storage(ix,iy,ivar,ic)
        dfmll = q_storage(ix,  iy-1,ivar,im) - q_storage(ix,iy,ivar,ic)
        dfmml = q_storage(ix,  iy,  ivar,im) - q_storage(ix,iy,ivar,ic)
        dfmrl = q_storage(ix,  iy+1,ivar,im) - q_storage(ix,iy,ivar,ic)
        dfrll = q_storage(ix+1,iy-1,ivar,im) - q_storage(ix,iy,ivar,ic)
        dfrml = q_storage(ix+1,iy,  ivar,im) - q_storage(ix,iy,ivar,ic)
        dfrrl = q_storage(ix+1,iy+1,ivar,im) - q_storage(ix,iy,ivar,ic)

        dfllm = q_storage(ix-1,iy-1,ivar,ic) - q_storage(ix,iy,ivar,ic)
        dflmm = q_storage(ix-1,iy,  ivar,ic) - q_storage(ix,iy,ivar,ic)
        dflrm = q_storage(ix-1,iy+1,ivar,ic) - q_storage(ix,iy,ivar,ic)
        dfmlm = q_storage(ix,  iy-1,ivar,ic) - q_storage(ix,iy,ivar,ic)
        dfmmm = zero
        dfmrm = q_storage(ix,  iy+1,ivar,ic) - q_storage(ix,iy,ivar,ic)
        dfrlm = q_storage(ix+1,iy-1,ivar,ic) - q_storage(ix,iy,ivar,ic)
        dfrmm = q_storage(ix+1,iy,  ivar,ic) - q_storage(ix,iy,ivar,ic)
        dfrrm = q_storage(ix+1,iy+1,ivar,ic) - q_storage(ix,iy,ivar,ic)

        dfllr = q_storage(ix-1,iy-1,ivar,ip) - q_storage(ix,iy,ivar,ic)
        dflmr = q_storage(ix-1,iy,  ivar,ip) - q_storage(ix,iy,ivar,ic)
        dflrr = q_storage(ix-1,iy+1,ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfmlr = q_storage(ix,  iy-1,ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfmmr = q_storage(ix,  iy,  ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfmrr = q_storage(ix,  iy+1,ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfrlr = q_storage(ix+1,iy-1,ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfrmr = q_storage(ix+1,iy,  ivar,ip) - q_storage(ix,iy,ivar,ic)
        dfrrr = q_storage(ix+1,iy+1,ivar,ip) - q_storage(ix,iy,ivar,ic)

        vmin = min(dflll,dflml,dflrl,dfmll,dfmml,dfmrl,dfrll,dfrml,dfrrl, &
                   dfllm,dflmm,dflrm,dfmlm,dfmmm,dfmrm,dfrlm,dfrmm,dfrrm, &
                   dfllr,dflmr,dflrr,dfmlr,dfmmr,dfmrr,dfrlr,dfrmr,dfrrr)
        vmax = max(dflll,dflml,dflrl,dfmll,dfmml,dfmrl,dfrll,dfrml,dfrrl, &
                   dfllm,dflmm,dflrm,dfmlm,dfmmm,dfmrm,dfrlm,dfrmm,dfrrm, &
                   dfllr,dflmr,dflrr,dfmlr,dfmmr,dfmrr,dfrlr,dfrmr,dfrrr)

        dfx = half*(q_storage(ix+1,iy,  ivar,ic) - q_storage(ix-1,iy,  ivar,ic))
        dfy = half*(q_storage(ix,  iy+1,ivar,ic) - q_storage(ix,  iy-1,ivar,ic))
        dfz = half*(q_storage(ix,  iy,  ivar,ip) - q_storage(ix,  iy,  ivar,im))
        dff = half*(abs(dfx) + abs(dfy) + abs(dfz))

        if (dff > zero) then
          slop = min(one, min(abs(vmin), abs(vmax)) / dff)
        else
          slop = one
        end if

        qds(ix,iy,ivar,1) = slop * dfx * idx
        qds(ix,iy,ivar,2) = slop * dfy * idx
        qds(ix,iy,ivar,3) = slop * dfz * idx
      end do

    end select
  end subroutine compute_slopes


   ! =========================================================================
#ifdef PAPER
   ! > @brief Paper hydro kernel solves HD in planes to minimise usage of shared memory without recomputing anything.
  attributes(global) subroutine hydro_integrator_paper_kernel(grid, uold, unew, f, father, nbor, &
       & head_idx, num_subgrids, ngridmax, ilevel, levelmin, levelmax, &
       & gamma, dt, dx, slope, riemann, constant_gravity)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, device :: nbor(1:subgridsize,*)
    real(kind=8), device :: constant_gravity(1:3)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    integer, intent(in), value :: ngridmax
    integer, intent(in), value :: ilevel, levelmin, levelmax
    real(kind=dp), intent(in), value :: gamma
    real(kind=dp), intent(in), value :: dt
    real(kind=dp), intent(in), value :: dx
    integer, intent(in), value :: slope
    integer, intent(in), value :: riemann

    ! Local variables
    integer :: thread_idx, block_idx, subgrid_idx
    integer, dimension(3), parameter :: mult = (/ 1, nsubgridp2, nsubgridp2sq /)
    integer, parameter :: i_rho = 1, i_px = 2, i_py = 3, i_pz = 4, i_ene = 5

    ! ifwd gives the index mapping for transformation of variables
    integer, parameter :: ifwd(nvar,3) = reshape( (/ i_rho, i_px, i_py, i_pz, i_ene, &
                                                     i_rho, i_py, i_pz, i_px, i_ene, &
                                                     i_rho, i_pz, i_px, i_py, i_ene /), (/ nvar,3 /) )

    ! Size of local stencil without ghost cells
    integer, parameter :: m = 2 * nsubgrid
    integer, parameter :: nb = 2 ! number of ghost cells == 1 oct
    integer, parameter :: mf = m + 2*nb ! size of local stencil incl ghost cells
    integer, parameter :: mf2 = mf**2   ! 2D size of local stencil incl ghost cells

    ! Density and pressure floors
    real(kind=dp), parameter :: smallr = 1d-10
    real(kind=dp), parameter :: smallc_squared = (1d-10)**2
    real(kind=dp), parameter :: smallp = smallr * smallc_squared

    ! Local device arrays (shared memory)
    real(dp), shared :: q_storage(1:m+4,1:m+4,nvar,3)
    real(dp), shared :: qds(2:m+3,2:m+3,nvar,3)
    real(dp), shared :: qdt(2:m+3,2:m+3,nvar)
    real(dp), shared :: qL(2:m+3,2:m+3,nvar)
    real(dp), shared :: qR(2:m+3,2:m+3,nvar)

    ! Total memory usage: ((m+4)**2*3 + (m+2)**2*7) * nvar * (4: single, 8: double) bytes
    ! m = 2*nsubgrid
    ! m= 2:  4 kB (FP32)   9 kB (FP64)
    ! m= 4:  9 kB (FP32)  17 kB (FP64)
    ! m= 8: 22 kB (FP32)  44 kB (FP64)
    ! m=16: 68 kB (FP32) 135 kB (FP64)

    ! Thread-private variables
    integer(kind=4) :: ix, iy, iz, ivar, im, ic, ip
    real(dp), value :: Uin(nvar), dU(nvar), invD, Ekin, div_v, hdx, dtdx, idx
    type(primitive_t) :: left_state, right_state
    type(conserved_t) :: flux_result

    thread_idx = threadIdx%x - 1       ! Thread index in x dimension (0 to blockDim%x-1)
    block_idx = blockIdx%x - 1         ! Block index in x dimension (0 to num_subgrids-1)
    subgrid_idx = head_idx + block_idx ! Get subgrid index for this block

    ! Get thread and block indices
    iy = thread_idx / mf + 1
    ix = 1 + thread_idx - (iy - 1) * mf
    subgrid_idx = head_idx + block_idx ! Get subgrid index

    ! FIXME: if nsubgrid is large (=>4) and this is an MHD kernel
    ! FIXME: to minimise shared memory load we may want to tile the ix-iy plane as well
    ! FIXME: and let different blocks work on different tiles. This keeps a long z-direciton
    ! FIXME: but minimise shared memory usage

    ! Initialize constants
    dtdx = dt / dx
    hdx = 0.5_dp*dx
    idx = 1.0_dp / dx

    ! Main iz loop over subgrid
    do iz = 0, m+3
       ! 1) update slot position
       im = mod(iz+1,3)+1
       ic = mod(iz+2,3)+1
       ip = mod(iz+3,3)+1

       associate(flux => q_storage(:,:, :,im))  ! Reuse q_storage for fluxes to save shared memory

       ! 2) compute primitive variables at cell centers for iz+1 (qp)
       if (ix <= m+4 .and. iy <= m+4) then
          Uin = load_conserved(ix, iy, iz+1, uold, nbor, subgrid_idx) ! load conserved variables for iz+1 into registers
          invD = 1.0_dp / Uin(i_rho)
          q_storage(ix,iy,i_rho,ip) = Uin(i_rho)
          q_storage(ix,iy,i_px,ip)  = Uin(i_px) * invD
          q_storage(ix,iy,i_py,ip)  = Uin(i_py) * invD
          q_storage(ix,iy,i_pz,ip)  = Uin(i_pz) * invD
          Ekin = 0.5_dp * ( Uin(i_px) * q_storage(ix,iy,i_px,ip) + &
               Uin(i_py) * q_storage(ix,iy,i_py,ip) + &
               Uin(i_pz) * q_storage(ix,iy,i_pz,ip) )
          q_storage(ix,iy,i_ene,ip) = (gamma - 1.0_dp)*(Uin(i_ene) - Ekin)
       end if

       if (iz <= 1) cycle ! no slopes or fluxes to compute yet
       call syncthreads()

       ! 3) compute slopes qds at cell centers for index iz
       if (ix >= 2 .and. ix <= m+3 .and. iy >= 2 .and. iy <= m+3) then
          do ivar = 1, nvar
             ! X direction
             qds(ix,iy,ivar,1) = slope_moncen(q_storage(ix-1,iy,ivar,ic), q_storage(ix,iy,ivar,ic), q_storage(ix+1,iy,ivar,ic), slope) * idx

             ! Y direction
             qds(ix,iy,ivar,2) = slope_moncen(q_storage(ix,iy-1,ivar,ic), q_storage(ix,iy,ivar,ic), q_storage(ix,iy+1,ivar,ic), slope) * idx

             ! Z direction
             qds(ix,iy,ivar,3) = slope_moncen(q_storage(ix,iy,ivar,im), q_storage(ix,iy,ivar,ic), q_storage(ix,iy,ivar,ip), slope) * idx
          end do
        ! FIXME, other slopes ideally inlined, and at the very least cleaned up to lessen register pressure and branches
        ! FIXME see how this is done in the code above
        !call compute_slopes(q_storage, qds, ix, iy, ic, im, ip, idx, slope, mf, nvar)
       end if
       !call syncthreads()

       ! 4) compute time prediction qdt at cell centers for index iz
       ! FIXME: we need to add external forces and/or constant gravity source terms here as well
       if (ix >= 2 .and. ix <= m+3 .and. iy >= 2 .and. iy <= m+3) then
          ! div_v = dv_x/dx + dv_y/dy + dv_z/dz
          div_v = qds(ix,iy,i_px,1) + qds(ix,iy,i_py,2) + qds(ix,iy,i_pz,3)
          ! drhodt = - v.grad(rho) - rho div(v)
          qdt(ix,iy,i_rho) = q_storage(ix,iy,i_rho,ic) - 0.5_dp*dt*( &
               q_storage(ix,iy,i_px,ic)*qds(ix,iy,i_rho,1) + q_storage(ix,iy,i_py,ic)*qds(ix,iy,i_rho,2) + &
               q_storage(ix,iy,i_pz,ic)*qds(ix,iy,i_rho,3) + q_storage(ix,iy,i_rho,ic)*div_v )
          ! dP/dt = -v*grad(P) - gamma*P*div(v)
          qdt(ix,iy,i_ene) = q_storage(ix,iy,i_ene,ic) - 0.5_dp*dt*( &
               q_storage(ix,iy,i_px,ic)*qds(ix,iy,i_ene,1) + q_storage(ix,iy,i_py,ic)*qds(ix,iy,i_ene,2) + &
               q_storage(ix,iy,i_pz,ic)*qds(ix,iy,i_ene,3) + gamma*q_storage(ix,iy,i_ene,ic)*div_v )
          ! dv_i/dt = - v.grad(v_i) - 1/rho grad(P)
          invD = 1.0_dp / q_storage(ix,iy,i_rho,ic)
          qdt(ix,iy,i_px) = q_storage(ix,iy,i_px,ic) - 0.5_dp*dt*( &
               q_storage(ix,iy,i_px,ic)*qds(ix,iy,i_px,1) + q_storage(ix,iy,i_py,ic)*qds(ix,iy,i_px,2) + &
               q_storage(ix,iy,i_pz,ic)*qds(ix,iy,i_px,3) + invD*qds(ix,iy,i_ene,1) )
          qdt(ix,iy,i_py) = q_storage(ix,iy,i_py,ic) - 0.5_dp*dt*( &
               q_storage(ix,iy,i_px,ic)*qds(ix,iy,i_py,1) + q_storage(ix,iy,i_py,ic)*qds(ix,iy,i_py,2) + &
               q_storage(ix,iy,i_pz,ic)*qds(ix,iy,i_py,3) + invD*qds(ix,iy,i_ene,2) )
          qdt(ix,iy,i_pz) = q_storage(ix,iy,i_pz,ic) - 0.5_dp*dt*( &
               q_storage(ix,iy,i_px,ic)*qds(ix,iy,i_pz,1) + q_storage(ix,iy,i_py,ic)*qds(ix,iy,i_pz,2) + &
               q_storage(ix,iy,i_pz,ic)*qds(ix,iy,i_pz,3) + invD*qds(ix,iy,i_ene,3) )
       end if

       ! 5) Z-direction flux and update
       if (iz > 2) then
          !call syncthreads()
          ! Compute qR for z-direction
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+2) then
             do ivar = 1, nvar
                qR(ix,iy,ivar) = qdt(ix,iy,ifwd(ivar,3)) - hdx * qds(ix,iy,ifwd(ivar,3),3)
                if (ivar == i_rho) then
                   if (qR(ix,iy,i_rho) < smallr) qR(ix,iy,i_rho) = q_storage(ix,iy,i_rho,ic)
                else if (ivar == i_ene) then
                   if (qR(ix,iy,i_ene) < smallp) qR(ix,iy,i_ene) = q_storage(ix,iy,i_ene,ic)
                end if
             end do
          end if
          !call syncthreads()

          ! Compute flux for z-direction
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+2) then
             left_state%density    = qL(ix,iy,i_rho)
             left_state%velocity_x = qL(ix,iy,i_px)
             left_state%velocity_y = qL(ix,iy,i_py)
             left_state%velocity_z = qL(ix,iy,i_pz)
             left_state%pressure   = qL(ix,iy,i_ene)

             right_state%density    = qR(ix,iy,i_rho)
             right_state%velocity_x = qR(ix,iy,i_px)
             right_state%velocity_y = qR(ix,iy,i_py)
             right_state%velocity_z = qR(ix,iy,i_pz)
             right_state%pressure   = qR(ix,iy,i_ene)

             flux_result = riemann_fluxes(left_state, right_state, gamma, riemann)

             flux(ix,iy,i_rho) = flux_result%density
             flux(ix,iy,i_pz ) = flux_result%momentum_x
             flux(ix,iy,i_px ) = flux_result%momentum_y
             flux(ix,iy,i_py ) = flux_result%momentum_z
             flux(ix,iy,i_ene) = flux_result%energy
          end if
          !call syncthreads()

          ! Update Uout from z-direction flux
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+2) then
             if (iz == 3) then
                do ivar = 1, nvar
                   dU(ivar) = dtdx*flux(ix,iy,ivar)
                end do
                call add_conserved(ix,iy,iz,dU,3,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                     & ilevel < levelmax, ilevel > levelmin)
             else if (iz == m+3) then
                do ivar = 1, nvar
                   dU(ivar) = - dtdx*flux(ix,iy,ivar)
                end do
                call add_conserved(ix,iy,iz-1,dU,6,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                     & ilevel < levelmax, ilevel > levelmin)
             else ! 3 < iz <= m+2
                do ivar = 1, nvar
                   dU(ivar) = - dtdx*flux(ix,iy,ivar)
                end do
                call add_conserved(ix,iy,iz-1,dU,6,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                     & ilevel < levelmax, ilevel > levelmin)
                do ivar = 1, nvar
                   dU(ivar) = dtdx*flux(ix,iy,ivar)
                end do
                call add_conserved(ix,iy,iz,dU,3,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                     & ilevel < levelmax, ilevel > levelmin)
             end if
          end if
       end if
       call syncthreads()

       ! X-direction and Y-direction (iz >= 3 .and. iz <= m+2)
       if (iz >= 3 .and. iz <= m+2) then
          ! Compute qL and qR for x-direction
          if (ix >= 3 .and. ix <= m+3 .and. iy >= 3 .and. iy <= m+2) then
             do ivar = 1, nvar
                qL(ix,iy,ivar) = qdt(ix-1,iy,ivar) + hdx * qds(ix-1,iy,ivar,1)
                qR(ix,iy,ivar) = qdt(ix  ,iy,ivar) - hdx * qds(ix  ,iy,ivar,1)
                if (ivar == i_rho) then
                   if (qL(ix,iy,i_rho) < smallr) qL(ix,iy,i_rho) = q_storage(ix-1,iy,i_rho,ic)
                   if (qR(ix,iy,i_rho) < smallr) qR(ix,iy,i_rho) = q_storage(ix,iy,i_rho,ic)
                else if (ivar == i_ene) then
                   if (qL(ix,iy,i_ene) < smallp) qL(ix,iy,i_ene) = q_storage(ix-1,iy,i_ene,ic)
                   if (qR(ix,iy,i_ene) < smallp) qR(ix,iy,i_ene) = q_storage(ix,iy,i_ene,ic)
                end if
             end do
          end if
          !call syncthreads()

          ! Compute flux for x-direction
          if (ix >= 3 .and. ix <= m+3 .and. iy >= 3 .and. iy <= m+2) then
             left_state%density    = qL(ix,iy,i_rho)
             left_state%velocity_x = qL(ix,iy,i_px)
             left_state%velocity_y = qL(ix,iy,i_py)
             left_state%velocity_z = qL(ix,iy,i_pz)
             left_state%pressure   = qL(ix,iy,i_ene)

             right_state%density    = qR(ix,iy,i_rho)
             right_state%velocity_x = qR(ix,iy,i_px)
             right_state%velocity_y = qR(ix,iy,i_py)
             right_state%velocity_z = qR(ix,iy,i_pz)
             right_state%pressure   = qR(ix,iy,i_ene)

             flux_result = riemann_fluxes(left_state, right_state, gamma, riemann)

             flux(ix,iy,i_rho) = flux_result%density
             flux(ix,iy,i_px ) = flux_result%momentum_x
             flux(ix,iy,i_py ) = flux_result%momentum_y
             flux(ix,iy,i_pz ) = flux_result%momentum_z
             flux(ix,iy,i_ene) = flux_result%energy
          end if
          call syncthreads()

          ! Update Uout from x-direction flux
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+2) then
             do ivar = 1, nvar
                dU(ivar) = dtdx*flux(ix,iy,ivar)
             end do
             call add_conserved(ix,iy,iz,dU,1,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                  & ilevel < levelmax, ilevel > levelmin)
             do ivar = 1, nvar
                dU(ivar) = - dtdx*flux(ix+1,iy,ivar)
             end do
             call add_conserved(ix,iy,iz,dU,4,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                  & ilevel < levelmax, ilevel > levelmin)
          end if
          call syncthreads()

          ! Compute qL and qR for y-direction
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+3) then
             do ivar = 1, nvar
                qL(ix,iy,ivar) = qdt(ix,iy-1,ifwd(ivar,2)) + hdx * qds(ix,iy-1,ifwd(ivar,2),2)
                qR(ix,iy,ivar) = qdt(ix,iy  ,ifwd(ivar,2)) - hdx * qds(ix,iy  ,ifwd(ivar,2),2)
                if (ivar == i_rho) then
                   if (qL(ix,iy,i_rho) < smallr) qL(ix,iy,i_rho) = q_storage(ix,iy-1,i_rho,ic)
                   if (qR(ix,iy,i_rho) < smallr) qR(ix,iy,i_rho) = q_storage(ix,iy,i_rho,ic)
                else if (ivar == i_ene) then
                   if (qL(ix,iy,i_ene) < smallp) qL(ix,iy,i_ene) = q_storage(ix,iy-1,i_ene,ic)
                   if (qR(ix,iy,i_ene) < smallp) qR(ix,iy,i_ene) = q_storage(ix,iy,i_ene,ic)
                end if
             end do
          end if
          !call syncthreads()

          ! Compute flux for y-direction
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+3) then
             left_state%density    = qL(ix,iy,i_rho)
             left_state%velocity_x = qL(ix,iy,i_px)
             left_state%velocity_y = qL(ix,iy,i_py)
             left_state%velocity_z = qL(ix,iy,i_pz)
             left_state%pressure   = qL(ix,iy,i_ene)

             right_state%density    = qR(ix,iy,i_rho)
             right_state%velocity_x = qR(ix,iy,i_px)
             right_state%velocity_y = qR(ix,iy,i_py)
             right_state%velocity_z = qR(ix,iy,i_pz)
             right_state%pressure   = qR(ix,iy,i_ene)

             flux_result = riemann_fluxes(left_state, right_state, gamma, riemann)

             flux(ix,iy,i_rho) = flux_result%density
             flux(ix,iy,i_py ) = flux_result%momentum_x
             flux(ix,iy,i_pz ) = flux_result%momentum_y
             flux(ix,iy,i_px ) = flux_result%momentum_z
             flux(ix,iy,i_ene) = flux_result%energy
          end if
          call syncthreads()

          ! Update Uout from y-direction flux
          if (ix >= 3 .and. ix <= m+2 .and. iy >= 3 .and. iy <= m+2) then
             do ivar = 1, nvar
                dU(ivar) = dtdx*flux(ix,iy,ivar)
             end do
             call add_conserved(ix,iy,iz,dU,2,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                  & ilevel < levelmax, ilevel > levelmin)
             do ivar = 1, nvar
                dU(ivar) = - dtdx*flux(ix,iy+1,ivar)
             end do
             call add_conserved(ix,iy,iz,dU,5,unew,nbor,grid,father,subgrid_idx,ngridmax, &
                  & ilevel < levelmax, ilevel > levelmin)
          end if
          call syncthreads()
       end if

       ! Compute left face for z-direction for next iteration
       if (iz >= 2 .and. iz <= m+2) then
          if (ix >= 3 .and. ix <= m+3 .and. iy >= 3 .and. iy <= m+3) then
             do ivar = 1, nvar
                qL(ix,iy,ivar) = qdt(ix,iy,ifwd(ivar,3)) + hdx * qds(ix,iy,ifwd(ivar,3),3)
                if (ivar == i_rho) then
                   if (qL(ix,iy,i_rho) < smallr) qL(ix,iy,i_rho) = q_storage(ix,iy,i_rho,ic)
                else if (ivar == i_ene) then
                   if (qL(ix,iy,i_ene) < smallp) qL(ix,iy,i_ene) = q_storage(ix,iy,i_ene,ic)
                end if
             end do
          end if
          !call syncthreads()
       end if

       end associate

    end do ! iz loop

  end subroutine hydro_integrator_paper_kernel
#endif
  ! =========================================================================

end module hydro_device
