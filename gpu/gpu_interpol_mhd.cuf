! =========================================================================
! Stage D4 -- divB-preserving constrained prolongation (interpol_mhd) on the
! device.  Faithful NDIM=3 transliteration of the CPU host routines in
! hydro/interpol_hydro.f90 (interpol_mhd / interpol_mag / interpol_faces /
! copy_from_refined_faces / cmp_central_faces / compute_2d_tvd and the cell
! limiters) plus a device port of the parent-stencil gather in
! amr/refine_utils.f90:859-941 (get_twondim_nbor_parent_cell + refined-sibling
! b3 lookup).  Included into module refine_device under #ifdef MHD; replaces the
! Stage A2 straight-injection placeholder in make_new_oct / make_cache_octs.
!
! Conventions kept verbatim from the host (Balsara 2001 constrained interp):
!   B1(0:twondim,1:6)            -- 7-point coarse face-B stencil (central + 6 nbors)
!   B2(1:twotondim,1:6)          -- 8 child face-B (comps 1-3 low x/y/z, 4-6 high)
!   B3(1:twondim,1:twotondim,1:6)-- refined-neighbour child face-B
!   refined(1:twondim)           -- which coarse face-nbr cell is refined (sibling)
!   u(-1:1,0:1,0:1) / v(0:1,-1:1,0:1) / w(0:1,0:1,-1:1) -- fine faces of the cube
! Cell-centred B is NOT interpolated in this loop in 3D (CPU loop bound
! nvar+3-ndim == nvar); the full face-B comes from interpol_mag.
! =========================================================================

! -------------------------------------------------------------------------
! MinMod cell-centred slope limiter (CPU compute_limiter_minmod).
attributes(device) subroutine compute_limiter_minmod_d(a, w)
  implicit none
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: w(1:ndim)
  integer :: idim
  real(kind=dp) :: diff_left, diff_right, minmod
  do idim = 1, ndim
     diff_left  = 0.5_dp*(a(2*idim)-a(0))
     diff_right = 0.5_dp*(a(0)-a(2*idim-1))
     if (diff_left*diff_right <= 0.0_dp) then
        minmod = 0.0_dp
     else
        minmod = min(abs(diff_left),abs(diff_right))*diff_left/abs(diff_left)
     end if
     w(idim) = minmod
  end do
end subroutine compute_limiter_minmod_d

! -------------------------------------------------------------------------
! Monotonized-central cell-centred slope limiter (CPU compute_limiter_central).
attributes(device) subroutine compute_limiter_central_d(a, w)
  implicit none
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: w(1:ndim)
  integer :: j, idim, ind, ix, iy, iz
  real(kind=dp) :: xc(1:twotondim,1:3)
  real(kind=dp) :: xxc
  real(kind=dp) :: ac(1:twotondim)
  real(kind=dp) :: corner, kernel, diff_corner, diff_kernel
  real(kind=dp) :: max_limiter, min_limiter, limiter

  ! Set position of cell centers relative to grid center
  do ind = 1, twotondim
     iz = (ind-1)/4
     iy = (ind-1-4*iz)/2
     ix = (ind-1-2*iy-4*iz)
     xc(ind,1) = (real(ix,kind=dp)-0.5_dp)
     xc(ind,2) = (real(iy,kind=dp)-0.5_dp)
     xc(ind,3) = (real(iz,kind=dp)-0.5_dp)
  end do

  ! Second order central slope
  do idim = 1, ndim
     w(idim) = 0.25_dp*(a(2*idim)-a(2*idim-1))
  end do

  ! Compute corner interpolated values
  do ind = 1, twotondim
     ac(ind) = a(0)
  end do
  do idim = 1, ndim
     do ind = 1, twotondim
        xxc = xc(ind,idim)
        corner = ac(ind) + 2.0_dp*w(idim)*xxc
        ac(ind) = corner
     end do
  end do

  ! Compute max of corners
  corner = ac(1)
  do j = 2, twotondim
     corner = max(corner, ac(j))
  end do
  ! Compute max of gradient kernel
  kernel = a(1)
  do j = 2, twondim
     kernel = max(kernel, a(j))
  end do
  diff_kernel = a(0) - kernel
  diff_corner = a(0) - corner
  max_limiter = 0.0_dp
  if (diff_kernel*diff_corner > 0.0_dp) then
     max_limiter = min(1.0_dp, diff_kernel/diff_corner)
  end if

  ! Compute min of corners
  corner = ac(1)
  do j = 2, twotondim
     corner = min(corner, ac(j))
  end do
  ! Compute min of gradient kernel
  kernel = a(1)
  do j = 2, twondim
     kernel = min(kernel, a(j))
  end do
  diff_kernel = a(0) - kernel
  diff_corner = a(0) - corner
  min_limiter = 0.0_dp
  if (diff_kernel*diff_corner > 0.0_dp) then
     min_limiter = min(1.0_dp, diff_kernel/diff_corner)
  end if

  ! Compute limiter and correct gradient
  limiter = min(min_limiter, max_limiter)
  do idim = 1, ndim
     w(idim) = w(idim)*limiter
  end do
end subroutine compute_limiter_central_d

! -------------------------------------------------------------------------
! Unlimited central cell-centred slope (CPU compute_central).
attributes(device) subroutine compute_central_d(a, w)
  implicit none
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: w(1:ndim)
  integer :: idim
  do idim = 1, ndim
     w(idim) = 0.25_dp*(a(2*idim)-a(2*idim-1))
  end do
end subroutine compute_central_d

! -------------------------------------------------------------------------
! 2D TVD face-slope limiter (CPU compute_2d_tvd).  interpol_type doubles as the
! slope mode (1=MinMod, 2=MonCen, 3=unlimited) and the (1/2) divisor exactly as
! on the host.
attributes(device) subroutine compute_2d_tvd_d(b, s, interpol_type)
  implicit none
  real(kind=dp) :: b(0:4)
  real(kind=dp) :: s(1:2)
  integer, value :: interpol_type
  real(kind=dp) :: dsgn, dlim, dcen, dlft, drgt, slop, rtype

  if (interpol_type == 3) then
     dlft = 0.5_dp*(b(0) - b(1))
     drgt = 0.5_dp*(b(2) - b(0))
     s(1) = dlft + drgt
     dlft = 0.5_dp*(b(0) - b(3))
     drgt = 0.5_dp*(b(4) - b(0))
     s(2) = dlft + drgt
     return
  end if

  rtype = real(interpol_type, kind=dp)

  dlft = rtype*(b(0) - b(1))
  drgt = rtype*(b(2) - b(0))
  dcen = 0.5_dp*(dlft+drgt)/rtype
  dsgn = sign(1.0_dp, dcen)
  slop = min(abs(dlft),abs(drgt))
  dlim = slop
  if ((dlft*drgt) <= 0.0_dp) dlim = 0.0_dp
  s(1) = dsgn*min(dlim,abs(dcen))

  dlft = rtype*(b(0) - b(3))
  drgt = rtype*(b(4) - b(0))
  dcen = 0.5_dp*(dlft+drgt)/rtype
  dsgn = sign(1.0_dp, dcen)
  slop = min(abs(dlft),abs(drgt))
  dlim = slop
  if ((dlft*drgt) <= 0.0_dp) dlim = 0.0_dp
  s(2) = dsgn*min(dlim,abs(dcen))
end subroutine compute_2d_tvd_d

! -------------------------------------------------------------------------
! TVD interpolation of the fine B onto the coarse side faces (CPU
! interpol_faces, NDIM==3 branches only).
attributes(device) subroutine interpol_faces_d(B1, u, v, w, interpol_type)
  implicit none
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer, value :: interpol_type
  integer :: i, j, k
  real(kind=dp) :: b(0:4)
  real(kind=dp) :: s(1:2)

  ! Left face along direction x (interpolate Bx)
  b(0) = B1(0,1); b(1) = B1(3,1); b(2) = B1(4,1); b(3) = B1(5,1); b(4) = B1(6,1)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do j = 0, 1
  do k = 0, 1
     u(-1,j,k) = b(0) + 0.5_dp*s(1)*(real(j,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction x (interpolate Bx)
  b(0) = B1(0,4); b(1) = B1(3,4); b(2) = B1(4,4); b(3) = B1(5,4); b(4) = B1(6,4)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do j = 0, 1
  do k = 0, 1
     u(+1,j,k) = b(0) + 0.5_dp*s(1)*(real(j,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Left face along direction y (interpolate By)
  b(0) = B1(0,2); b(1) = B1(1,2); b(2) = B1(2,2); b(3) = B1(5,2); b(4) = B1(6,2)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do k = 0, 1
     v(i,-1,k) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction y (interpolate By)
  b(0) = B1(0,5); b(1) = B1(1,5); b(2) = B1(2,5); b(3) = B1(5,5); b(4) = B1(6,5)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do k = 0, 1
     v(i,+1,k) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Left face along direction z (interpolate Bz)
  b(0) = B1(0,3); b(1) = B1(1,3); b(2) = B1(2,3); b(3) = B1(3,3); b(4) = B1(4,3)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do j = 0, 1
     w(i,j,-1) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(j,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction z (interpolate Bz)
  b(0) = B1(0,6); b(1) = B1(1,6); b(2) = B1(2,6); b(3) = B1(3,6); b(4) = B1(4,6)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do j = 0, 1
     w(i,j,+1) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(j,kind=dp)-0.5_dp)
  end do
  end do
end subroutine interpol_faces_d

! -------------------------------------------------------------------------
! Overwrite the coarse side faces shared with an already-refined neighbour by
! that neighbour's stored fine face-B (CPU copy_from_refined_faces, NDIM==3).
! This is the divB-preserving face-redundancy enforcement: cell A's high face
! equals neighbour B's low face.
attributes(device) subroutine copy_from_refined_faces_d(B3, refined, u, v, w)
  implicit none
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer :: i, j, k, ind

  ! Left face along direction x
  do j = 0, 1
  do k = 0, 1
     ind = 1 + 1 + j*2 + k*4
     if (refined(1)) u(-1,j,k) = B3(1,ind,4)
  end do
  end do
  ! Right face along direction x
  do j = 0, 1
  do k = 0, 1
     ind = 1 + 0 + j*2 + k*4
     if (refined(2)) u(+1,j,k) = B3(2,ind,1)
  end do
  end do

  ! Left face along direction y
  do i = 0, 1
  do k = 0, 1
     ind = 1 + i + 1*2 + k*4
     if (refined(3)) v(i,-1,k) = B3(3,ind,5)
  end do
  end do
  ! Right face along direction y
  do i = 0, 1
  do k = 0, 1
     ind = 1 + i + 0*2 + k*4
     if (refined(4)) v(i,+1,k) = B3(4,ind,2)
  end do
  end do

  ! Left face along direction z
  do i = 0, 1
  do j = 0, 1
     ind = 1 + i + j*2 + 1*4
     if (refined(5)) w(i,j,-1) = B3(5,ind,6)
  end do
  end do
  ! Right face along direction z
  do i = 0, 1
  do j = 0, 1
     ind = 1 + i + j*2 + 0*4
     if (refined(6)) w(i,j,+1) = B3(6,ind,3)
  end do
  end do
end subroutine copy_from_refined_faces_d

! -------------------------------------------------------------------------
! Reconstruct the fine B on the central (interior) faces so that div B = 0 in
! every fine cell (CPU cmp_central_faces, NDIM==3).
attributes(device) subroutine cmp_central_faces_d(u, v, w)
  implicit none
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer :: i, j, k, ii, jj, kk
  real(kind=dp) :: UXX, VYY, WZZ, UXYZ, VXYZ, WXYZ

  UXX = 0.0_dp; VYY = 0.0_dp; WZZ = 0.0_dp
  UXYZ = 0.0_dp; VXYZ = 0.0_dp; WXYZ = 0.0_dp

  do i = 0, 1
  do j = 0, 1
  do k = 0, 1
     ii = 2*i-1
     jj = 2*j-1
     kk = 2*k-1
     UXX  = UXX  + (real(ii*jj,kind=dp)*v(i,jj,k)+real(ii*kk,kind=dp)*w(i,j,kk))*0.125_dp
     VYY  = VYY  + (real(jj*kk,kind=dp)*w(i,j,kk)+real(ii*jj,kind=dp)*u(ii,j,k))*0.125_dp
     WZZ  = WZZ  + (real(ii*kk,kind=dp)*u(ii,j,k)+real(jj*kk,kind=dp)*v(i,jj,k))*0.125_dp
     UXYZ = UXYZ + (real(ii*jj*kk,kind=dp)*u(ii,j,k))*0.125_dp
     VXYZ = VXYZ + (real(ii*jj*kk,kind=dp)*v(i,jj,k))*0.125_dp
     WXYZ = WXYZ + (real(ii*jj*kk,kind=dp)*w(i,j,kk))*0.125_dp
  end do
  end do
  end do

  ! Bx on central faces
  do j = 0, 1
  do k = 0, 1
     u(0,j,k) = 0.5_dp*(u(-1,j,k)+u(+1,j,k)) + UXX &
          &   + (real(k,kind=dp)-0.5_dp)*VXYZ + (real(j,kind=dp)-0.5_dp)*WXYZ
  end do
  end do
  ! By on central faces
  do i = 0, 1
  do k = 0, 1
     v(i,0,k) = 0.5_dp*(v(i,-1,k)+v(i,+1,k)) + VYY &
          &   + (real(i,kind=dp)-0.5_dp)*WXYZ + (real(k,kind=dp)-0.5_dp)*UXYZ
  end do
  end do
  ! Bz on central faces
  do i = 0, 1
  do j = 0, 1
     w(i,j,0) = 0.5_dp*(w(i,j,-1)+w(i,j,+1)) + WZZ &
          &   + (real(j,kind=dp)-0.5_dp)*UXYZ + (real(i,kind=dp)-0.5_dp)*VXYZ
  end do
  end do
end subroutine cmp_central_faces_d

! -------------------------------------------------------------------------
! Balsara-constrained face-centred B prolongation (CPU interpol_mag, NDIM==3).
attributes(device) subroutine interpol_mag_d(B1, B2, B3, refined, interpol_type)
  implicit none
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: B2(1:twotondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  integer, value :: interpol_type
  integer :: i, j, k, ind
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)

  ! Compute interpolated fine B over coarse side faces
  call interpol_faces_d(B1, u, v, w, interpol_type)
  ! Get fine B from refined faces, if any
  call copy_from_refined_faces_d(B3, refined, u, v, w)
  ! Compute interpolated fine B inside coarse cell
  call cmp_central_faces_d(u, v, w)

  ! Scatter results onto the 8 children's 6 face-B slots
  do i = 0, 1
  do j = 0, 1
  do k = 0, 1
     ind = 1 + i + 2*j + 4*k
     B2(ind,1) = u(i-1,j,k)
     B2(ind,4) = u(i,j,k)
     B2(ind,2) = v(i,j-1,k)
     B2(ind,5) = v(i,j,k)
     B2(ind,3) = w(i,j,k-1)
     B2(ind,6) = w(i,j,k)
  end do
  end do
  end do
end subroutine interpol_mag_d

! -------------------------------------------------------------------------
! Top-level constrained MHD prolongation (CPU interpol_mhd, NDIM==3).  Fills the
! 8 children's hydro state u2(1:twotondim,1:nvar) and face-B B2(1:twotondim,1:6).
attributes(device) subroutine interpol_mhd_d(u1, u2, B1, B2, B3, refined, &
     & interpol_var, interpol_type, smallr)
  implicit none
  real(kind=dp) :: u1(0:twondim,1:nvar)
  real(kind=dp) :: u2(1:twotondim,1:nvar)
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: B2(1:twotondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  integer, value :: interpol_var, interpol_type
  real(kind=dp), value :: smallr
  integer :: irad
  integer :: j, ivar, idim, ind, ix, iy, iz
  real(kind=dp) :: xc(1:twotondim,1:3)
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: ww(1:ndim)
  real(kind=dp) :: ekin, emag, erad

  ! Set position of cell centers relative to grid center
  do ind = 1, twotondim
     iz = (ind-1)/4
     iy = (ind-1-4*iz)/2
     ix = (ind-1-2*iy-4*iz)
     xc(ind,1) = (real(ix,kind=dp)-0.5_dp)
     xc(ind,2) = (real(iy,kind=dp)-0.5_dp)
     xc(ind,3) = (real(iz,kind=dp)-0.5_dp)
  end do

  ! If necessary, convert father total energy into internal energy
  if (interpol_var == 1) then
     do j = 0, twondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u1(j,idim+1)**2/max(u1(j,1),smallr)
        end do
        emag = 0.0_dp
        do idim = 1, 3
           emag = emag + 0.125_dp*(B1(j,idim)+B1(j,idim+3))**2
        end do
        erad = 0.0_dp
        do irad = 1, nener
           erad = erad + u1(j,5+irad)
        end do
        u1(j,5) = u1(j,5) - ekin - emag - erad
     end do
  end if

  ! Loop over cell-centred interpolation variables.  In 3D the CPU loop bound
  ! nvar+3-ndim collapses to nvar, so only the hydro slots (and passive
  ! scalars) are interpolated here; cell-centred B comes from interpol_mag.
  do ivar = 1, nvar
     ! Load father variable
     do j = 0, twondim
        a(j) = u1(j,ivar)
     end do
     ! Reset gradient
     ww(1:ndim) = 0.0_dp
     ! Compute gradient with chosen limiter
     if (interpol_type == 1) call compute_limiter_minmod_d(a, ww)
     if (interpol_type == 2) call compute_limiter_central_d(a, ww)
     if (interpol_type == 3) call compute_central_d(a, ww)
     ! Interpolate over children cells
     do ind = 1, twotondim
        u2(ind,ivar) = a(0)
        do idim = 1, ndim
           u2(ind,ivar) = u2(ind,ivar) + ww(idim)*xc(ind,idim)
        end do
     end do
  end do

  ! Interpolate face-centred MHD variables (Balsara constrained)
  call interpol_mag_d(B1, B2, B3, refined, interpol_type)

  ! If necessary, convert children internal energy into total energy
  if (interpol_var == 1) then
     do ind = 1, twotondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u2(ind,idim+1)**2/max(u2(ind,1),smallr)
        end do
        emag = 0.0_dp
        do idim = 1, 3
           emag = emag + 0.125_dp*(B2(ind,idim)+B2(ind,idim+3))**2
        end do
        erad = 0.0_dp
        do irad = 1, nener
           erad = erad + u2(ind,5+irad)
        end do
        u2(ind,5) = u2(ind,5) + ekin + emag + erad
     end do
  end if
end subroutine interpol_mhd_d

! -------------------------------------------------------------------------
! Device port of CPU get_twondim_nbor_parent_cell (amr/nbors_utils.f90:149) plus
! the refined-sibling b3 lookup of make_new_oct (amr/refine_utils.f90:892-922),
! for one child oct identified by (ilev_child, chkey).  Fills the 7-point coarse
! stencil u1/B1, the refined() mask and the refined-neighbour face-B b3, using
! the same hash-table + periodic-wrap navigation as the rest of gpu_refine.
!
! Gotcha 5 (best-effort siblings): make_new_oct runs BEFORE insert_hash_kernel,
! so child octs created in the SAME refine pass are not yet hash-visible.  A
! refined coarse neighbour whose child oct is missing from the hash is treated
! as not-refined (refined=.false.), so its faces fall back to the coarse
! interpolation -- matching the CPU only for neighbours refined in an EARLIER
! pass (the divB-load-bearing case), best-effort otherwise.
attributes(device) subroutine gather_twondim_parent_stencil( &
     & grid, uold, bold, hash_key, hash_val, hash_size, ckey_max, key_off, &
     & box_ckey_min, box_ckey_max, periodic, ilev_child, chkey, u1, B1, B3, refined)
  implicit none
  type(oct), device :: grid(*)
  real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
  real(kind=dp), device :: bold(1:twotondim,1:6,*)
  integer(kind=8), device :: hash_key(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4), device :: box_ckey_min(1:ndim,*)
  integer(kind=4), device :: box_ckey_max(1:ndim,*)
  logical, device :: periodic(1:3)
  integer(kind=4), value :: ilev_child
  integer(kind=4) :: chkey(1:ndim)
  real(kind=dp) :: u1(0:twondim,1:nvar)
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)

  integer(kind=8) :: key, offset, ix, iy, iz, nx
  integer :: inbor, idim, idn, ivar, ib, ind, pidx, cidx, pcell, ilev_par
  integer :: nkey(1:ndim), fkey(1:ndim), bit(1:ndim)

  ilev_par = ilev_child - 1

  ! --- Central parent cell (inbor=0): the father cell being refined ---
  do idim = 1, ndim
     fkey(idim) = chkey(idim)/2
     bit(idim)  = chkey(idim) - 2*fkey(idim)
  end do
  pcell = 1 + bit(1) + 2*bit(2) + 4*bit(3)
  ix = int(fkey(1),kind=8); iy = int(fkey(2),kind=8); iz = int(fkey(3),kind=8)
  nx = int(ckey_max(ilev_par),kind=8); offset = key_off(ilev_par)
  key = offset + ix + iy*nx + iz*nx*nx
  pidx = hash_get(hash_key, hash_val, hash_size, key)
  do ivar = 1, nvar
     u1(0,ivar) = uold(pcell,ivar,pidx)
  end do
  do ib = 1, 6
     B1(0,ib) = bold(pcell,ib,pidx)
  end do

  ! --- Neighbouring father cells (inbor=1..twondim) + refined-sibling b3 ---
  ! shift(:,inbor): 1->(-1,0,0) 2->(+1,0,0) 3->(0,-1,0) 4->(0,+1,0) 5->(0,0,-1)
  ! 6->(0,0,+1) -- the CPU "shift" reshape, computed branch-free.
  do inbor = 1, twondim
     refined(inbor) = .false.
     do idim = 1, ndim
        nkey(idim) = chkey(idim)
     end do
     idn = (inbor+1)/2
     if (mod(inbor,2) == 1) then
        nkey(idn) = chkey(idn) - 1
     else
        nkey(idn) = chkey(idn) + 1
     end if
     ! Periodic boundary conditions at the child level
     do idim = 1, ndim
        if (periodic(idim)) then
           if (nkey(idim) <  box_ckey_min(idim,ilev_child)) nkey(idim) = box_ckey_max(idim,ilev_child) - 1
           if (nkey(idim) >= box_ckey_max(idim,ilev_child)) nkey(idim) = box_ckey_min(idim,ilev_child)
        end if
     end do
     do idim = 1, ndim
        fkey(idim) = nkey(idim)/2
        bit(idim)  = nkey(idim) - 2*fkey(idim)
     end do
     pcell = 1 + bit(1) + 2*bit(2) + 4*bit(3)
     ix = int(fkey(1),kind=8); iy = int(fkey(2),kind=8); iz = int(fkey(3),kind=8)
     nx = int(ckey_max(ilev_par),kind=8); offset = key_off(ilev_par)
     key = offset + ix + iy*nx + iz*nx*nx
     pidx = hash_get(hash_key, hash_val, hash_size, key)
     if (pidx > 0) then
        do ivar = 1, nvar
           u1(inbor,ivar) = uold(pcell,ivar,pidx)
        end do
        do ib = 1, 6
           B1(inbor,ib) = bold(pcell,ib,pidx)
        end do
        ! Refined-neighbour child oct (if already in the hash table)
        if (grid(pidx)%refined(pcell)) then
           ix = int(nkey(1),kind=8); iy = int(nkey(2),kind=8); iz = int(nkey(3),kind=8)
           nx = int(ckey_max(ilev_child),kind=8); offset = key_off(ilev_child)
           key = offset + ix + iy*nx + iz*nx*nx
           cidx = hash_get(hash_key, hash_val, hash_size, key)
           if (cidx > 0) then
              refined(inbor) = .true.
              do ib = 1, 6
                 do ind = 1, twotondim
                    B3(inbor,ind,ib) = bold(ind,ib,cidx)
                 end do
              end do
           end if
        end if
     else
        ! Defensive: a missing neighbour father reuses the central cell value
        ! (zero gradient in that direction); the CPU aborts here instead.
        do ivar = 1, nvar
           u1(inbor,ivar) = u1(0,ivar)
        end do
        do ib = 1, 6
           B1(inbor,ib) = B1(0,ib)
        end do
     end if
  end do
end subroutine gather_twondim_parent_stencil
