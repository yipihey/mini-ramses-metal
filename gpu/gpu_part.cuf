!> GPU split_part.
subroutine gpu_split_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev, leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%npartmax

  if (num_parts <= 0) then
     sim%p%tailp(ilevel) = sim%p%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
        sim%p%tailp(ilev) = sim%p%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call nvtxEndRange()

  ! Initialize prefix sum using swap table sortp
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, sortp, prefix_sum, head_idx, num_parts)
  call nvtxEndRange()

  ! Compute prefix sum
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call gpu_scan(head_idx, num_parts, n_fine_dev)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call write_swap_global_hilbert_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, sortp, prefix_sum, &
       & head_idx, num_parts, n_coarse)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(sortp, isp_swap, &
       & head_idx, num_parts)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_part", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, xp, &
          & sortp, head_idx, num_parts, leading, idim)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, vp, &
          & sortp, head_idx, num_parts, leading, idim)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, mp, &
       & sortp, head_idx, num_parts)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(mp, xp_swap, &
       & head_idx, num_parts)

  ! Potential
  if (allocated(phip)) then
     call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, phip, &
          & sortp, head_idx, num_parts)
     call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(phip, xp_swap, &
          & head_idx, num_parts)
  endif

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, levelp, &
       & sortp, head_idx, num_parts)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(levelp, isp_swap, &
       & head_idx, num_parts)

  ! Particle ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, idp, &
       & sortp, head_idx, num_parts)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, isp_swap, &
       & head_idx, num_parts)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idp, &
       & sortp, head_idx, num_parts)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, idp_swap, &
       & head_idx, num_parts)
#endif
  call nvtxEndRange()

  ! Bookkeeping
  sim%p%tailp(ilevel) = sim%p%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
     sim%p%tailp(ilev) = sim%p%npart
  end do

end subroutine gpu_split_part

attributes(global) subroutine compute_hkey_part_kernel(xp, hkey_part_d, &
     & skip1, skip2, skip3, dx_inv, head_idx, num_parts, leading, level)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp(*)
  integer(kind=8), device :: hkey_part_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3
  real(kind=8), intent(in), value :: dx_inv
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: level

  integer :: thread_idx, block_idx, idx, ipart, idim
  integer(kind=4) :: ix(1:ndim)
  real(kind=8) :: skip(1:3), xs

  thread_idx = threadIdx%x - 1
  block_idx = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  do idim = 1, ndim
     xs = xp(ipart + (idim-1)*leading) + skip(idim)
     ix(idim) = floor(xs * dx_inv)
  end do

  hkey_part_d(ipart) = hilbert_key(ix, level)

end subroutine compute_hkey_part_kernel

!> One radix digit of hkey_part for the LSD sort.
attributes(global) subroutine init_prefix_sum_part_bit(hkey_part_d, swap_global_d, &
     & prefix_sum_d, head_idx, num_parts, ibit)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: ibit

  integer :: thread_idx, block_idx, idx, old_idx

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx

  old_idx = swap_global_d(idx)
  prefix_sum_d(idx) = int(ibits(hkey_part_d(old_idx), ibit, 1), kind=4)

end subroutine init_prefix_sum_part_bit

attributes(global) subroutine write_sortp_part(sortp_d, swap_global_d, &
     & head_idx, num_parts)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  sortp_d(idx) = swap_global_d(idx)
end subroutine write_sortp_part

!> GPU sort_part.
subroutine gpu_sort_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, skip1, skip2, skip3
  character(len=32) :: nvtx_lbl

  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  level = ilevel
  dx = sim%r%boxlen/2**level
  dx_inv = 1.0_dp / dx
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  call nvtxStartRange("gpu_sort_part", color=4) ! purple

  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_part:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(xp, idp_swap, &
       & skip1, skip2, skip3, dx_inv, head_idx, num_parts, sim%r%npartmax, level)
  call nvtxEndRange()

  ! Init sortp
  call nvtxStartRange("gpu_sort_part:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(sortp, &
       & head_idx, num_parts)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1
     write(nvtx_lbl, '(A,I0)') 'gpu_sort_part:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & sortp, prefix_sum, head_idx, num_parts, ibit)

     ! Compute prefix sum
     call gpu_scan(head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & sortp, prefix_sum, head_idx, num_parts)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(sortp, &
          & isp_swap, head_idx, num_parts)

     call nvtxEndRange()
  end do

  call nvtxEndRange()

end subroutine gpu_sort_part

!> Multipole reduction over [1, npart]: q(1)=sum(mp), q(idim+1)=sum(mp*xp).
attributes(global) subroutine multipole_q_kernel(xp_d, mp_d, multipole_q_d, &
     & head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading, num_parts, head_idx
  real(kind=dp), device :: xp_d(*)
  real(kind=dp), device :: mp_d(*)
  real(kind=8), device :: multipole_q_d(1:ndim+1)

  integer :: thread_idx, block_idx, ipart, idim, info
  real(kind=8) :: q_loc(1:ndim+1)

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  ipart = head_idx + thread_idx + block_idx * blockDim%x

  q_loc = 0.0_dp
  if (ipart <= num_parts) then
     q_loc(1) = mp_d(ipart)
     do idim = 1, ndim
        q_loc(idim+1) = mp_d(ipart) * xp_d(ipart + (idim-1)*leading)
     end do
  endif

  do idim = 1, ndim+1
     q_loc(idim) = block_reduce_sum(q_loc(idim))
  end do

  if (threadIdx%x == 1) then
     do idim = 1, ndim+1
        info = atomicadd(multipole_q_d(idim), q_loc(idim))
     end do
  endif

end subroutine multipole_q_kernel

!> Per-level reduction of particle velocities for the Courant condition:
!> vmax = MAX |vp|, ekin = SUM 0.5 * mp * |vp|^2 over ipart in
!> [head_idx, head_idx+num_parts-1].
attributes(global) subroutine gpu_newdt_part_kernel(vp_d, mp_d, &
     & vmax_d, ekin_d, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: head_idx, num_parts, leading
  real(kind=dp),   device :: vp_d(*), mp_d(*)
  real(kind=8),    device :: vmax_d
  real(kind=8),    device :: ekin_d

  integer :: thread_idx, block_idx, ipart, idim, info
  real(kind=8) :: vmax_local, ekin_local, v, av, mi

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  ipart = head_idx + thread_idx + block_idx * blockDim%x

  vmax_local = 0.0_dp
  ekin_local = 0.0_dp
  if (ipart <= head_idx + num_parts - 1) then
     mi = mp_d(ipart)
     do idim = 1, ndim
        v  = vp_d(ipart + (idim-1)*leading)
        av = abs(v)
        if (av > vmax_local) vmax_local = av
        ekin_local = ekin_local + 0.5_dp * mi * v * v
     end do
  endif

  ! Block reductions: every thread in the block must reach these calls
  ! (they call syncthreads() internally). Threads past num_parts have
  ! contributed the neutral elements (0.0_dp) above and don't read OOB.
  vmax_local = block_reduce_max(vmax_local)
  ekin_local = block_reduce_sum(ekin_local)

  if (threadIdx%x == 1) then
     info = atomicadd(ekin_d, ekin_local)
     info = atomicmax(vmax_d, vmax_local)
  endif

end subroutine gpu_newdt_part_kernel

!> CIC mass deposit over sortp(head_idx:head_idx+num_parts-1).
!>
!> gpu_sort_part has sorted this range at depth ilevel, so particles sharing a
!> source cell appear in contiguous runs of sortp. The kernel is launched at
!> 256 threads/block = 8 warps/block, so each warp owns 32 consecutive slots
!> of the sorted window. Inside a warp, lanes split into "segments" -- maximal
!> runs of adjacent lanes whose source-cell key (the packed combined word each
!> lane builds at the top of the kernel) agrees. A uniform warp is one 32-lane
!> segment; a warp straddling a cell boundary contains two; OOD/OOB lanes
!> (combined == 0) cluster into a zero-segment that contributes nothing.
!>
!> For each of the threetondim = 3^ndim stencil offsets k:
!>   1) each lane forms its own CIC contribution (mp * w / vol_loc for rho;
!>      w for nref) from its fractional position -- no hashing here;
!>   2) an inclusive segmented Hillis-Steele scan along the warp accumulates
!>      each segment's contributions so the tail lane holds the segment sum;
!>   3) the tail lane hashes the segment's (shared) destination cell -- once,
!>      not once per lane -- and emits one atomicAdd per segment with
!>      non-zero, in-domain contribution.
!>
!> The result: one atomic per (warp, segment, stencil-offset) -- typically
!> just one atomic per warp per offset, because most warps are uniform.
!>
!> Note on the stencil width. The host's CIC uses a 2-cell stencil per axis
!> (left or right neighbour depending on the fractional position). The GPU
!> expresses it as a 3-cell stencil per axis with the "wrong-side" cell
!> carrying weight zero. That removes per-lane branching and lets the
!> zero-weight lanes drop out of the segmented scan silently.
attributes(global) subroutine cic_part_warp_kernel(sortp_d, &
     & head_idx, num_parts, &
     & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & box_ckey_min_d, box_ckey_max_d, periodic_d, &
     & xp_d, mp_d, rho_d, nref_d, &
     & skip1, skip2, skip3, dx_loc, vol_loc, &
     & m_refine_at_level, mass_cut_refine, ilevel, leading)
  integer(kind=4), intent(in), value :: head_idx, num_parts, leading, ilevel
  integer(kind=4), device :: sortp_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  logical,         device :: periodic_d(1:3)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level, mass_cut_refine

  integer :: tid_local, lane, warp_local, warps_per_block, warp_global, slot_global
  integer :: ipart, idim, k, info
  integer :: icell_src_lane, igrid_src_lane
  integer :: ox, oy, oz, dst_igrid_lane, dst_icell_lane
  integer(kind=4) :: combined, prev_combined, next_combined
  integer(kind=4) :: head_acc, other_head, scan_iter, scan_offset
  integer(kind=4) :: src_full_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, hkey_offset, key, ix8, iy8, iz8
  logical :: valid_lane, in_domain, is_head, is_tail
  real(kind=8) :: my_rho, my_nref, mp_i, other_rho, other_nref
  real(kind=8) :: skip(1:3), xs, frac(1:3)
  real(kind=8) :: wx(0:2), wy(0:2), wz(0:2), w

  ! ------------------------------------------------------------------
  ! Lane bookkeeping: map (block, thread) -> (warp, lane, slot_global).
  ! slot_global is 1-based into the sortp(head_idx..) window (Fortran
  ! convention). valid_lane is .false. for lanes past num_parts.
  ! ------------------------------------------------------------------
  tid_local       = threadIdx%x - 1
  warps_per_block = blockDim%x / warpsize        ! 256 / 32 = 8
  warp_local      = tid_local / warpsize
  lane            = mod(tid_local, warpsize)
  warp_global     = (blockIdx%x - 1) * warps_per_block + warp_local
  slot_global     = warp_global * warpsize + lane + 1

  valid_lane = (slot_global <= num_parts)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  ! Hash geometry at level ilevel (grid(:) stores the parent octs there).
  nx          = int(ckey_max_d(ilevel), kind=8)
  hkey_offset = key_off_d(ilevel)

  ! ------------------------------------------------------------------
  ! Per-lane source-cell geometry (fused from the former build_src_part_kernel
  ! pass). Each lane reads its own particle through sortp -- no isp_swap round
  ! trip -- and derives everything the deposit needs straight from xp:
  !   * src_full_ckey = floor((xp+skip)/dx_loc), the level-ilevel source cell;
  !   * frac, the in-cell fractional position that sets the CIC weights;
  !   * combined = packed (igrid, icell) of the parent oct, from a single
  !     hash_get, which both identifies the source cell for segment detection
  !     and carries the out-of-domain sentinel.
  ! Folding the build pass in here removes a whole kernel launch plus the
  ! isp_swap global write/read, and lets us take src_full_ckey directly from
  ! the position instead of reading back grid(igrid)%ckey. combined == 0 marks
  ! an out-of-domain particle (hash miss); OOD lanes and out-of-bounds (OOB)
  ! tail lanes share that zero word and group into one zero-segment.
  ! ------------------------------------------------------------------
  ipart          = 0
  combined       = 0
  icell_src_lane = 0
  igrid_src_lane = 0
  mp_i           = 0.0_dp
  frac           = 0.0_dp
  src_full_ckey  = 0
  if (valid_lane) then
     ipart = sortp_d(head_idx + slot_global - 1)
     mp_i  = mp_d(ipart)

     ! Level-ilevel source cell key and the in-cell fractional position. This
     ! is the same level-ilevel cell the old build pass found, but taken
     ! straight from the position rather than rebuilt from grid(igrid)%ckey.
     do idim = 1, ndim
        xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
        src_full_ckey(idim) = floor(xs)
        frac(idim) = xs - src_full_ckey(idim)
     end do

     ! Split the source cell into (parent oct ckey, in-oct cell) and hash the
     ! parent oct -- the same decomposition the deposit uses for destinations.
     father_ckey = src_full_ckey / 2
     ii          = src_full_ckey - 2 * father_ckey
     icell_src_lane = 1
     do idim = 1, ndim
        icell_src_lane = icell_src_lane + ii(idim) * (2**(idim-1))
     end do
     ix8 = int(father_ckey(1), kind=8)
     iy8 = int(father_ckey(2), kind=8)
     iz8 = int(father_ckey(3), kind=8)
     key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
     igrid_src_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

     if (igrid_src_lane == 0) then
        ! Parent oct not materialised on this rank: drop the lane into the
        ! zero-segment (matches the old build pass writing the 0 sentinel).
        valid_lane    = .false.
        mp_i          = 0.0_dp
        frac          = 0.0_dp
        src_full_ckey = 0
     else
        combined = ior(ishft(igrid_src_lane, 5), icell_src_lane)
     endif
  endif

  ! ------------------------------------------------------------------
  ! 1D CIC weights expressed on a 3-cell stencil per axis. For f in [0, 1):
  !   f < 1/2:  w(-1) = 1/2 - f,  w(0) = 1/2 + f,  w(+1) = 0
  !   f >= 1/2: w(-1) = 0,        w(0) = 3/2 - f,  w(+1) = f - 1/2
  ! This is the textbook 2-cell CIC with the "wrong-side" cell zero-padded,
  ! so we can loop over all 3^ndim offsets unconditionally and let zero
  ! weights silently drop those lanes from the segmented scan.
  ! Unused dimensions keep wy(1) = wz(1) = 1 so the 3D product also works
  ! correctly for ndim = 1 or 2.
  ! ------------------------------------------------------------------
  wx(0) = max(0.0_dp, 0.5_dp - frac(1))
  wx(1) = 1.0_dp - abs(frac(1) - 0.5_dp)
  wx(2) = max(0.0_dp, frac(1) - 0.5_dp)
  wy = 0.0_dp
  wz = 0.0_dp
  wy(1) = 1.0_dp
  wz(1) = 1.0_dp
  if (ndim >= 2) then
     wy(0) = max(0.0_dp, 0.5_dp - frac(2))
     wy(1) = 1.0_dp - abs(frac(2) - 0.5_dp)
     wy(2) = max(0.0_dp, frac(2) - 0.5_dp)
  endif
  if (ndim >= 3) then
     wz(0) = max(0.0_dp, 0.5_dp - frac(3))
     wz(1) = 1.0_dp - abs(frac(3) - 0.5_dp)
     wz(2) = max(0.0_dp, frac(3) - 0.5_dp)
  endif

  ! ------------------------------------------------------------------
  ! Per-level box bounds. box_min/box_max bound the local tile at the deposit
  ! level (level ilevel) and drive periodic wrap / OOB rejection below. Note
  ! the box arrays store these level-ilevel cell coordinates in slot ilevel+1
  ! -- an array-indexing convention, not a finer AMR level. (nx / hkey_offset
  ! for the oct hash were set with the source geometry above.)
  ! ------------------------------------------------------------------
  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  ! ------------------------------------------------------------------
  ! Segment boundary detection. Adjacent-lane equality of `combined` is
  ! enough: lane L is a segment head iff its left neighbour disagrees (or
  ! it is lane 0); lane L is a tail iff its right neighbour disagrees (or
  ! it is lane warpsize-1). The detection is done once per warp because
  ! `combined` does not depend on the stencil offset k.
  ! __shfl_up / __shfl_down read from lane L-1 / L+1 within the warp;
  ! the explicit (lane == 0) / (lane == warpsize-1) clauses cover the
  ! out-of-range boundaries.
  ! ------------------------------------------------------------------
  prev_combined = __shfl_up  (combined, 1)
  next_combined = __shfl_down(combined, 1)
  is_head = (lane == 0)              .or. (combined /= prev_combined)
  is_tail = (lane == warpsize - 1)   .or. (combined /= next_combined)

  ! ------------------------------------------------------------------
  ! Stencil loop: iterate over the 3^ndim offsets (ox, oy, oz) in {-1, 0, +1}.
  ! Per offset: each lane computes its own destination + contribution, the
  ! warp runs a segmented inclusive scan, and each segment's tail emits at
  ! most one atomicAdd into rho (and one into nref, if gated).
  do k = 1, threetondim
     ! Decode the linear index k = 1..27 into mixed-radix-3 offsets.
     ox = mod(k - 1, 3) - 1
     oy = mod((k - 1) / 3, 3) - 1
     oz = (k - 1) / 9 - 1

     ! Per-lane CIC contribution for this stencil offset. The weight depends
     ! on each lane's own fractional position, so every valid lane computes
     ! it; invalid lanes keep my_rho = my_nref = 0 and drop out of the scan.
     ! No destination gate here: if a lane's segment lands on an off-rank or
     ! out-of-domain cell, its accumulated contribution is simply never
     ! emitted, because emission is gated on the (segment-uniform) tail lookup.
     my_rho  = 0.0_dp
     my_nref = 0.0_dp
     if (valid_lane) then
        ! CIC weight = product of 1D weights at offset (ox, oy, oz). Only
        ! 2**ndim of the 3**ndim offsets are non-zero for a given particle
        ! (8 of 27 in 3D); zero-weight lanes join the scan contributing nothing.
        w = wx(ox+1) * wy(oy+1) * wz(oz+1)
        if (w > 0.0_dp) then
           my_rho = mp_i * w / vol_loc
           if (m_refine_at_level >= 0.0_dp) then
              ! nref follows the host refinement gate: either all masses count
              ! (mass_cut_refine <= 0), or only particles below mass_cut_refine.
              if (mass_cut_refine > 0.0_dp) then
                 if (mp_i < mass_cut_refine) then
                    my_nref = w
                 endif
              else
                 my_nref = w
              endif
           endif
        endif
     endif

     ! Destination cell. Lanes in one segment share the source cell, so at a
     ! fixed offset k they all map to the SAME destination oct -- the hash is
     ! segment-uniform. Only the tail lane emits the segment's atomic, so only
     ! the tail needs the destination: hash on the tail alone and skip the
     ! expensive hash_get on the segment's other (up to warpsize-1) lanes.
     dst_igrid_lane = 0
     dst_icell_lane = 0
     if (is_tail .and. valid_lane) then
        ! Target cell key at level ilevel = source key + stencil offset.
        target_ckey = 0
        target_ckey(1) = src_full_ckey(1) + ox
        if (ndim >= 2) target_ckey(2) = src_full_ckey(2) + oy
        if (ndim >= 3) target_ckey(3) = src_full_ckey(3) + oz

        ! Boundary handling. Periodic axes wrap within the deposit-level box;
        ! a non-periodic out-of-bounds target leaves dst_igrid_lane = 0, which
        ! suppresses the atomic via the dst_igrid_lane /= 0 guard below.
        in_domain = .true.
        do idim = 1, ndim
           if (periodic_d(idim)) then
              if (target_ckey(idim) < box_min(idim))  target_ckey(idim) = box_max(idim) - 1
              if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
           else
              if (target_ckey(idim) < box_min(idim))  in_domain = .false.
              if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
           endif
        end do
        if (in_domain) then
           ! Same decomposition as for the source cell above: pull the parent
           ! oct's ckey and the in-oct child index out of the level-ilevel
           ! target ckey, then hash the parent oct.
           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           dst_icell_lane = 1
           do idim = 1, ndim
              dst_icell_lane = dst_icell_lane + ii(idim) * (2**(idim-1))
           end do
           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
           ! hash_get returns 0 if the destination oct is not present on this
           ! rank, which again suppresses the atomic for this segment.
           dst_igrid_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
        endif
     endif

     ! ---------------------------------------------------------------
     ! Segmented inclusive Hillis-Steele scan along the warp.
     !
     ! head_acc starts at 1 on segment heads, 0 elsewhere, and is OR'd up
     ! the warp via __shfl_up in lock-step with the values. At iteration s
     ! (scan_offset = 2^s), each lane looks back 2^s positions:
     !   - if its lookback has not yet crossed a head (head_acc == 0), the
     !     value 2^s back is still inside this segment -- fold it in;
     !   - once a head is encountered (head_acc flips to 1), further
     !     additions are skipped: the lane has summed from its segment's
     !     head through itself and is done.
     ! After 5 iterations (covering offsets 1, 2, 4, 8, 16) every lane in
     ! a warp holds the inclusive segment sum from its segment's head up
     ! through itself; in particular, the segment tail holds the total.
     ! The (lane >= scan_offset) guard handles low-lane positions whose
     ! __shfl_up source would be out of warp range.
     ! ---------------------------------------------------------------
     if (is_head) then
        head_acc = 1
     else
        head_acc = 0
     endif
     do scan_iter = 0, 4
        scan_offset = ishft(1, scan_iter)        ! 1, 2, 4, 8, 16
        other_rho  = __shfl_up(my_rho,   scan_offset)
        other_nref = __shfl_up(my_nref,  scan_offset)
        other_head = __shfl_up(head_acc, scan_offset)
        if (lane >= scan_offset) then
           if (head_acc == 0) then
              my_rho  = my_rho  + other_rho
              my_nref = my_nref + other_nref
           endif
           head_acc = ior(head_acc, other_head)
        endif
     end do

     ! ---------------------------------------------------------------
     ! Tail emission: one atomicAdd per segment per stencil offset.
     ! The triple guard is sharp:
     !   is_tail            -- exactly one lane per segment;
     !   valid_lane         -- skip OOD / OOB zero-segments;
     !   dst_igrid_lane /= 0 -- skip off-rank destinations.
     ! The my_rho / my_nref != 0 checks save no-op atomics on segments
     ! whose total at this k is identically zero (e.g. an entire segment
     ! sitting on the wrong side of the stencil).
     ! ---------------------------------------------------------------
     if (is_tail .and. valid_lane .and. dst_igrid_lane /= 0) then
        if (my_rho /= 0.0_dp) then
           info = atomicadd(rho_d(dst_icell_lane, dst_igrid_lane), real(my_rho, kind=dp))
        endif
        if (m_refine_at_level >= 0.0_dp .and. my_nref /= 0.0_dp) then
           info = atomicadd(nref_d(dst_icell_lane, dst_igrid_lane), real(my_nref, kind=dp))
        endif
     endif
  end do

end subroutine cic_part_warp_kernel

!> Host dispatcher for the GPU CIC mass deposit at level ilevel.
!>
!> Pipeline:
!>   1. If rtype is not 0 or 1, bail out (matches the host's deposition guard).
!>   2. On the coarsest active level only, launch multipole_q_kernel to
!>      accumulate the global monopole and dipole (q_0 = sum mp, q_alpha =
!>      sum mp * xp_alpha) over the full particle table.
!>   3. Launch cic_part_warp_kernel over sortp(head_idx..head_idx+num_parts-1)
!>      to deposit into rho and nref via a per-warp segmented Hillis-Steele
!>      scan. Each lane builds its own source map (parent-oct hash + packed
!>      (igrid, icell)) from xp at the top of the kernel -- the former separate
!>      build_src_part_kernel pass and its isp_swap source map are folded in.
!>
!> Preconditions:
!>   - gpu_sort_part has just run at depth ilevel, so sortp groups particles
!>     that share a source cell into contiguous runs. The deposit kernel does
!>     not re-sort -- it relies on this grouping to keep most warps uniform
!>     (one segment, one atomic per stencil offset).
!>   - The deposit cells are at level ilevel (side dx_loc = boxlen/2**ilevel),
!>     where the CIC weights are formed -- the same level the host cic_part
!>     uses. (The per-level box arrays index these cell coordinates at slot
!>     ilevel+1, an array convention only.) Particle ownership runs from
!>     head_idx = p%headp(ilevel) through p%tailp(nlevelmax), so the range
!>     covers every particle at or below ilevel (matching the host cic_part
!>     loop bounds).
subroutine gpu_cic_part(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! rtype gate: matches the host's "deposit DM into rho" branch.
  if (rtype /= 0 .and. rtype /= 1) then
     return
  endif

  call nvtxStartRange("gpu_cic_part", color=4) ! purple

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_part:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, q_d, &
          & 1, sim%p%npart, sim%r%npartmax)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) then
     call nvtxEndRange()
     return
  endif

  ! Geometry. dx_loc = boxlen/2**ilevel is the deposit CELL side at level
  ! ilevel (the host's "mesh spacing at level ilevel"); the parent oct spans
  ! 2*dx_loc. vol_loc = dx_loc**ndim is the level-ilevel cell volume used to
  ! convert mass to density. skip(:) recentres positions on this rank's tile.
  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Single-pass warp-segmented CIC deposit. 256 threads/block = 8 warps/block;
  ! each warp owns 32 contiguous slots of sortp and emits roughly one
  ! atomicAdd per stencil offset (more on cell boundaries). The former build
  ! pass (which hashed each particle's parent oct into the isp_swap source map)
  ! is now folded into this kernel: every lane derives its source cell, frac
  ! position, and packed (igrid, icell) directly from xp, so no isp_swap
  ! write/read round trip or grid(igrid)%ckey read is needed.
  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_part:deposit", color=4)
  call cic_part_warp_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & xp, mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, sim%r%npartmax)
  call nvtxEndRange()

  call nvtxEndRange()

end subroutine gpu_cic_part

!> Per-level particle Courant reduction. Computes vmax = MAX|vp| and
!> ekin = SUM 0.5*mp*|vp|^2 over particles in level ilevel from device vp/mp
!> and combines them into the inout host scalars
subroutine gpu_newdt_part(sim, ilevel, vmax, ekin)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  real(kind=8), intent(inout) :: vmax, ekin

  integer(kind=4) :: head_idx, num_parts, leading
  integer :: num_threads, num_blocks
  real(kind=8), device :: vmax_dev
  real(kind=8), device :: ekin_dev
  real(kind=8) :: vmax_host, ekin_host

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(ilevel) - head_idx + 1

  if (num_parts <= 0) return

  leading = sim%r%npartmax
  vmax_dev = 0.0_dp
  ekin_dev = 0.0_dp

  num_threads = 256
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  call nvtxStartRange("gpu_newdt_part", color=4) ! purple
  call gpu_newdt_part_kernel<<<num_blocks, num_threads>>>(vp, mp, &
       & vmax_dev, ekin_dev, head_idx, num_parts, leading)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)
  call nvtxEndRange()

  vmax_host = vmax_dev   ! D->H
  ekin_host = ekin_dev   ! D->H

  vmax = MAX(vmax, vmax_host)
  ekin = ekin + ekin_host

end subroutine gpu_newdt_part

attributes(device) subroutine gather_cic_force_part(f_d, hash_key_d, hash_val_d, &
     hash_size_d, ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
     ngridmax, x_in, cell_level, grid_level, ff, ok_level)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  logical,         device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: ngridmax
  real(kind=8) :: x_in(1:3), ff(1:3)
  integer(kind=4), intent(in), value :: cell_level, grid_level
  logical :: ok_level

  integer :: idim, bx, by, bz, igrid, icell
  integer(kind=4) :: il(1:3), ir(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=8) :: dr(1:3), dl(1:3), weight
  logical :: in_domain

  ok_level = .true.
  ff = 0.0_dp
  if (grid_level < 1) then
     ok_level = .false.
     return
  endif

  il = 0
  ir = 0
  dr = 0.0_dp
  dl = 1.0_dp
  box_min = 0
  box_max = 0

  do idim = 1, ndim
     dr(idim) = x_in(idim) + 0.5_dp
     ir(idim) = int(dr(idim))
     dr(idim) = dr(idim) - ir(idim)
     dl(idim) = 1.0_dp - dr(idim)
     il(idim) = ir(idim) - 1
     box_min(idim) = box_ckey_min_d(idim, cell_level)
     box_max(idim) = box_ckey_max_d(idim, cell_level)
     if (periodic_d(idim)) then
        if (il(idim) <  box_min(idim)) il(idim) = box_max(idim) - 1
        if (ir(idim) >= box_max(idim)) ir(idim) = box_min(idim)
     endif
  end do

  do bz = 0, 1
     do by = 0, 1
        do bx = 0, 1

           target_ckey = 0
           target_ckey(1) = merge(ir(1), il(1), bx == 1)
           weight = merge(dr(1), dl(1), bx == 1)
           target_ckey(2) = merge(ir(2), il(2), by == 1)
           weight = weight * merge(dr(2), dl(2), by == 1)
           target_ckey(3) = merge(ir(3), il(3), bz == 1)
           weight = weight * merge(dr(3), dl(3), bz == 1)

           in_domain = .true.
           do idim = 1, ndim
              if (.not. periodic_d(idim)) then
                 if (target_ckey(idim) < box_min(idim))  in_domain = .false.
                 if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
              endif
           end do
           if (.not. in_domain) then
              ok_level = .false.
              cycle
           endif

           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           icell = 1
           do idim = 1, ndim
              icell = icell + ii(idim) * 2**(idim-1)
           end do

           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           nx  = int(ckey_max_d(grid_level), kind=8)
           offset = key_off_d(grid_level)
           key = offset + ix8 + iy8*nx + iz8*nx*nx

           igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

           ! Skip cache/ghost octs (igrid > ngridmax): gpu_gradient_phi does
           ! not update them, so f there is stale. CPU mirrors this by
           ! returning child=0 in get_grid; same convention as gpu_mg.cuf.
           if (igrid == 0 .or. igrid > ngridmax) then
              ok_level = .false.
              cycle
           endif

           do idim = 1, ndim
              ff(idim) = ff(idim) + real(f_d(icell, idim, igrid), kind=8) * weight
           end do

        end do
     end do
  end do

  if (.not. ok_level) then
     ff = 0.0_dp
  endif

end subroutine gather_cic_force_part

attributes(global) subroutine kick_drift_part_kernel(xp_d, vp_d, levelp_d, &
     f_d, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     box_ckey_min_d, box_ckey_max_d, box_size_d, periodic_d, ngridmax, &
     dtnew_d, dtold_d, skip1, skip2, skip3, dx_loc, &
     action_part, ilevel, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: vp_d(*)
  integer(kind=4), device :: levelp_d(*)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  real(kind=8),    device :: box_size_d(1:3)
  logical,         device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: ngridmax
  real(kind=8),    device :: dtnew_d(*)
  real(kind=8),    device :: dtold_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc
  integer(kind=4), intent(in), value :: action_part
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx, ipart, idim, lp
  real(kind=8) :: skip(1:3), x(1:3), x_coarse(1:3), ff(1:3)
  real(kind=8) :: dteff, xnew
  logical :: ok_level

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  ff = 0.0_dp

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  x = 0.0_dp
  do idim = 1, ndim
     x(idim) = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
  end do

  call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, &
       & ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
       & ngridmax, x, ilevel+1, ilevel, ff, ok_level)

  if (.not. ok_level) then

     x_coarse = x / 2.0_dp
     call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, &
          & ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
          & ngridmax, x_coarse, ilevel, ilevel-1, ff, ok_level)

  endif

  if (action_part == 2) then

     do idim = 1, ndim

        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             & + ff(idim) * 0.5_dp * dtnew_d(ilevel)

        xnew = xp_d(ipart + (idim-1)*leading) &
             & + vp_d(ipart + (idim-1)*leading) * dtnew_d(ilevel)

        if (periodic_d(idim)) then
           if (xnew < 0.0_dp)              xnew = xnew + box_size_d(idim)
           if (xnew >= box_size_d(idim)) xnew = xnew - box_size_d(idim)
        endif

        xp_d(ipart + (idim-1)*leading) = xnew

     end do

  else if (action_part == 1) then

     lp = levelp_d(ipart)

     if (lp >= ilevel) then
        dteff = dtnew_d(lp)
     else
        dteff = dtold_d(lp)
     endif

     levelp_d(ipart) = ilevel

     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             & + ff(idim) * 0.5_dp * dteff
     end do

  endif

end subroutine kick_drift_part_kernel

subroutine gpu_kick_drift_part(sim, ilevel, action_part)
  use nvtx
  use amr_parameters, only: MAXLEVEL
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer(kind=4) :: head_coarse, tail_coarse, num_coarse
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3
  real(kind=8) :: gp1, gp2, gp3, gp4, gp5, q1, q2, q3, q4
  integer(kind=4) :: gravity_type
  logical :: any_nonperiodic
  real(kind=8), device, dimension(1:MAXLEVEL) :: dtnew_part_d, dtold_part_d

  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Host to device
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     call nvtxStartRange("gpu_kick_drift_part", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(xp, vp, levelp, &
          & f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, action_part, ilevel, head_idx, num_parts, sim%r%npartmax)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_part

end module part_device
