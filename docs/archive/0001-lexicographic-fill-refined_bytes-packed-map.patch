From: Eric Moseley <ericm628@gmail.com>
Date: Thu, 11 Jun 2026 18:15:03 -0700
Subject: [PATCH] lexicographic fill/refined_bytes packed map

---
 gpu/gpu_hydro.cuf  | 176 +++++++++++++++++++++++++++++----------------
 gpu/gpu_runner.cuf |  26 ++++++-
 gpu/gpu_utils.cuf  |  20 +++---
 3 files changed, 151 insertions(+), 71 deletions(-)

diff --git a/gpu/gpu_hydro.cuf b/gpu/gpu_hydro.cuf
index 61b8d3c1..37cc6a2a 100644
--- a/gpu/gpu_hydro.cuf
+++ b/gpu/gpu_hydro.cuf
@@ -1241,6 +1241,10 @@ contains
   !> cell-centred B, applies the density/internal-energy floors and the magnetic
   !> energy correction (CPU ctoprim), and loads the passive scalars.
   !>
+  !> @param[in] refined_bytes : Byte-packed per-oct refinement map (8, noct),
+  !> re-derived from grid%refined by pack_refined_kernel before every launch.
+  !> Replaces the 4-byte AoS gather grid(source_idx)%refined(cell_idx), which
+  !> NCU billed as the single largest source of excessive global sectors.
   !> @param[in] head_idx : The head index of the octs at the current AMR level
   !> @param[in] block_idx : The CUDA block index of the calling thread
   !> @param[in] thread_idx : The index of calling thread within its block
@@ -1250,7 +1254,7 @@ contains
   !> @param[out] scalar_sub (MHD) : The passive-scalar subgrid (1:nvar-5)
   !> @param[out] bf (MHD) : The face-continuous low-face B buffer
   !>
-  attributes(device) subroutine subgrid_conserved_2_primitive(grid, uold, bold, f, constant_gravity, nbor, &
+  attributes(device) subroutine subgrid_conserved_2_primitive(refined_bytes, uold, bold, f, constant_gravity, nbor, &
 #if NVAR>5+NENER
        & scalar_sub, &
 #endif
@@ -1258,7 +1262,7 @@ contains
        & bf, &
 #endif
        & head_idx, block_idx, thread_idx, gamma, smallr, smallc, dt, local_subgrid)
-    type(oct), device :: grid(*)
+    logical(kind=1), device :: refined_bytes(1:twotondim,*)
     real(kind=8), device :: constant_gravity(3)
     real(kind=dp), device :: f(1:twotondim,1:ndim,*)
     real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
@@ -1282,36 +1286,50 @@ contains
     type(primitive_t) :: primitive ! object to hold the primitive variables
     integer :: work_idx, ind_nbor
     integer :: i, j, k, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx
+    integer :: ib, jb, kb ! cell position bits within its oct (0 or 1 per axis)
     integer :: cell_idx, source_idx, subgrid_idx
     integer :: work_size
     real(kind=dp) :: invD
 #ifdef MHD
-    integer :: ind_nbor_xm, ind_nbor_ym, ind_nbor_zm
+    integer :: source_idx_face
     real(kind=dp) :: b0(1:6)
 #endif
 
     work_size = 2*nsubgrid+4
 
+    ! LEXICOGRAPHIC work decode (i fastest). The shared subgrids are unpadded
+    ! stride-6 rows, so the destination linear offset i + 6j + 36k == work_idx:
+    ! a warp's 32 lanes store to 32 consecutive shared addresses for every
+    ! field below -- coalesced, bank-conflict-free. (The previous oct-major
+    ! Morton decode scattered each warp over 4 octs x 8 Morton cells, which
+    ! NCU billed as the kernel's #1 signal: 99.9M excessive shared wavefronts
+    ! and 1.8-way store conflicts on the bf/local_subgrid fills.) This is a
+    ! pure permutation of the same 216 independent (oct, cell) work items --
+    ! per-item arithmetic is untouched, so the shared contents after the
+    ! syncthreads are bitwise identical to the old decode.
     do work_idx = thread_idx, work_size**3 - 1, blockDim%x
 
-       ! Compute the subgrid_indices index, i.e. determine the oct to load
-       call index_1Dto3D(work_idx/8, work_size/2, work_size/2, i_subgrid_idx, j_subgrid_idx, k_subgrid_idx)
+       ! Destination lattice coordinates within the 6x6x6 subgrid
+       call index_1Dto3D(work_idx, work_size, work_size, i, j, k)
+
+       ! Which oct of the 3x3x3 stencil, and the cell's position bits in it
+       i_subgrid_idx = i/2
+       j_subgrid_idx = j/2
+       k_subgrid_idx = k/2
+       ib = i - 2*i_subgrid_idx
+       jb = j - 2*j_subgrid_idx
+       kb = k - 2*k_subgrid_idx
 
        ! Get subgrid index
        subgrid_idx = head_idx + block_idx
 
-       ! Get neighbour index
-       ind_nbor = work_idx/8 + 1
+       ! Get neighbour index (same formula the old decode produced:
+       ! ind_nbor = 1 + isub + 3*jsub + 9*ksub)
+       ind_nbor = 1 + i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx
        source_idx = nbor(ind_nbor, subgrid_idx)
 
-       ! Now that we have the index to the oct we need to figure out which cell within it to load
-       cell_idx = mod(work_idx, 8) + 1
-
-       ! Lastly, we need to figure out where in the subgrid the cell we will load goes
-       call index_1Dto3D(cell_idx - 1, 2, 2, i, j, k)
-       i = i + 2*i_subgrid_idx
-       j = j + 2*j_subgrid_idx
-       k = k + 2*k_subgrid_idx
+       ! Morton cell index within the source oct
+       cell_idx = 1 + ib + 2*jb + 4*kb
 
 #ifdef MHD
        ! This cell's six raw face-B (bold comps 1-3 = low x/y/z, 4-6 = high x/y/z).
@@ -1324,41 +1342,40 @@ contains
 
        ! Face-continuous low faces (CPU ctoprim:1768/1781/1794): a cell's low-d face
        ! = 0.5*(self_low_d + low-d-neighbour_high_d), keeping B single-valued at each
-       ! face (divB). The low-d neighbour cell index = hhh(cell_idx,dir) and its oct
-       ! offset = iii(cell_idx,dir) (dir 1=-x, 3=-y, 5=-z): offset 0 -> same oct,
-       ! -1 -> the low-d neighbouring oct (fetched via the periodic nbor stencil,
-       ! like load_bfield in 6e6a715b). The OUTERMOST low faces bx(0,*,*)/by(*,0,*)/
-       ! bz(*,*,0) would need an oct outside the 3x3x3 nbor stencil; they are never
-       ! read (edge_e reads bx at i>=1, by at j>=1, bz at k>=1; the trace and the
-       ! cell-B recompute read bx/by/bz at their own-axis index >= 1), so the
-       ! trimmed subgrid_face_b_t no longer stores them and the fill skips both
-       ! the write and the out-of-stencil oct fetch.
+       ! face (divB). The low-d neighbour is the cell with this cell's own-axis
+       ! position bit flipped: cell index hhh(cell_idx,dir) == cell_idx + s*(1-2*bit)
+       ! (s = 1/2/4 for x/y/z), living in the same oct when the bit is 1
+       ! (iii(cell_idx,dir)==0) and in the low-d stencil oct (ind_nbor - 1/3/9)
+       ! when the bit is 0 -- the arithmetic below is exactly the old hhh/iii
+       ! table walk, with the two divergent stores per direction merged into a
+       ! single store + gather behind a predicated source-index select (halves
+       ! the instruction count on NCU's hottest shared lines and the ~20
+       ! predicated-off threads/warp divergence signal). The OUTERMOST low
+       ! faces bx(0,*,*)/by(*,0,*)/bz(*,*,0) would need an oct outside the
+       ! 3x3x3 nbor stencil; they are never read (edge_e reads bx at i>=1, by
+       ! at j>=1, bz at k>=1; the trace and the cell-B recompute read bx/by/bz
+       ! at their own-axis index >= 1), so the trimmed subgrid_face_b_t no
+       ! longer stores them and the fill skips both the write and the
+       ! out-of-stencil oct fetch. Guard soundness for the selects: bit==0
+       ! with own-axis index >= 1 forces an even index >= 2, so the stencil
+       ! slot ind_nbor - 1/3/9 always exists.
        ! Low-x face of this cell:
        if (i >= 1) then
-          if (iii(cell_idx,1) == 0) then
-             bf%bx(i,j,k) = 0.5_dp*(b0(1) + bold(hhh(cell_idx,1), 4, source_idx))
-          else
-             ind_nbor_xm = (i_subgrid_idx-1) + nsubgridp2*j_subgrid_idx + nsubgridp2sq*k_subgrid_idx + 1
-             bf%bx(i,j,k) = 0.5_dp*(b0(1) + bold(hhh(cell_idx,1), 4, nbor(ind_nbor_xm, subgrid_idx)))
-          endif
+          source_idx_face = source_idx
+          if (ib == 0) source_idx_face = nbor(ind_nbor - 1, subgrid_idx)
+          bf%bx(i,j,k) = 0.5_dp*(b0(1) + bold(cell_idx + 1 - 2*ib, 4, source_idx_face))
        endif
        ! Low-y face of this cell:
        if (j >= 1) then
-          if (iii(cell_idx,3) == 0) then
-             bf%by(i,j,k) = 0.5_dp*(b0(2) + bold(hhh(cell_idx,3), 5, source_idx))
-          else
-             ind_nbor_ym = i_subgrid_idx + nsubgridp2*(j_subgrid_idx-1) + nsubgridp2sq*k_subgrid_idx + 1
-             bf%by(i,j,k) = 0.5_dp*(b0(2) + bold(hhh(cell_idx,3), 5, nbor(ind_nbor_ym, subgrid_idx)))
-          endif
+          source_idx_face = source_idx
+          if (jb == 0) source_idx_face = nbor(ind_nbor - nsubgridp2, subgrid_idx)
+          bf%by(i,j,k) = 0.5_dp*(b0(2) + bold(cell_idx + 2*(1 - 2*jb), 5, source_idx_face))
        endif
        ! Low-z face of this cell:
        if (k >= 1) then
-          if (iii(cell_idx,5) == 0) then
-             bf%bz(i,j,k) = 0.5_dp*(b0(3) + bold(hhh(cell_idx,5), 6, source_idx))
-          else
-             ind_nbor_zm = i_subgrid_idx + nsubgridp2*j_subgrid_idx + nsubgridp2sq*(k_subgrid_idx-1) + 1
-             bf%bz(i,j,k) = 0.5_dp*(b0(3) + bold(hhh(cell_idx,5), 6, nbor(ind_nbor_zm, subgrid_idx)))
-          endif
+          source_idx_face = source_idx
+          if (kb == 0) source_idx_face = nbor(ind_nbor - nsubgridp2sq, subgrid_idx)
+          bf%bz(i,j,k) = 0.5_dp*(b0(3) + bold(cell_idx + 4*(1 - 2*kb), 6, source_idx_face))
        endif
 
        conserved%density    = uold(cell_idx, 1, source_idx)
@@ -1416,14 +1433,18 @@ contains
        ! the two stored copies of each face are bitwise identical (the face-B
        ! redundancy invariant the CT update preserves).
 
-       ! Store refinement map (MHD stores only the consumed lattice)
+       ! Store refinement map (MHD stores only the consumed lattice).
+       ! Read from the byte-packed refined_bytes (SoA, 8 B/oct) instead of the
+       ! 4-byte logicals buried in the ~64 B type(oct) AoS -- the old gather
+       ! straddled two 32 B sectors per oct and was NCU's largest single
+       ! source of excessive global sectors (29%).
        if (i >= 1 .and. i <= 2*nsubgrid+2 .and. j >= 1 .and. j <= 2*nsubgrid+2 &
             & .and. k >= 1 .and. k <= 2*nsubgrid+2) then
-          local_subgrid%refined(i, j, k) = grid(source_idx)%refined(cell_idx)
+          local_subgrid%refined(i, j, k) = refined_bytes(cell_idx, source_idx)
        endif
 #else
-       ! Store refinement map
-       local_subgrid%refined   (i, j, k) = grid(source_idx)%refined(cell_idx)
+       ! Store refinement map (byte-packed gather; see the MHD branch note)
+       local_subgrid%refined   (i, j, k) = refined_bytes(cell_idx, source_idx)
 #endif
 
     end do
@@ -3686,8 +3707,10 @@ contains
   !      already exact.
   !
   ! Resident shared per block (nsubgrid=1, nvar=8, FP64; refined = 1 B):
-  !   (A) subgrid_6x6x6cell_primitive  5*252*8 + 64*1          = 10144 B
-  !       (P0 bank-conflict fix: leading dim padded 6->7; +1440 B vs 8704)
+  !   (A) subgrid_6x6x6cell_primitive  5*216*8 + 64*1          =  8704 B
+  !       (P0 pad REVERTED: unpadded stride-6 rows are required by the
+  !       lexicographic fill -- linear shared offset == work_idx -- and the
+  !       pad measured as a no-op on job 2823239)
   !       scalar_subgrid (nvar-5=3)        3*216*8                 =  5184 B
   !   (B) subgrid_face_b_t (bf, trimmed)   3*180*8                 =  4320 B
   !   (D) subgrid_edge_e_t                  REMOVED (P1)            =     0 B
@@ -3697,35 +3720,68 @@ contains
   !       * 7 fields per orientation)      3*4032                  = 12096 B
   !   (G) 6 MHD interface arrays (11-wide) 6*12*11*8               =  6336 B
   !       ------------------------------------------------------------------
-  !       TOTAL resident                                           = 38512 B
-  !                  = 37.6 KB < 48 KB static limit (was 39472 B pre P0/P1).
+  !       TOTAL resident                                           = 37072 B
+  !                  = 36.2 KB < 48 KB static limit.
   !
-  ! At NPRE=4 (the production A100 config) the reals halve. NCU measured the
-  ! pre-P0/P1 static at 16998 B = 16.6 KiB -> 9 blocks/SM. With P0 (+720 B
-  ! local_subgrid pad) and P1 (-1200 B edge_e removed) the net is ~16518 B
-  ! -> still 9 blocks/SM (164 KB carveout, +1 KB/block driver reserve). edge_e
-  ! is now recomputed inline; the next lever for 10 blocks/SM (needs <15770 B)
-  ! is slimming the corner_x/y/z family (-6048 B FP32) -- physics audit first.
+  ! At NPRE=4 (the production A100 config) the reals halve: NCU measured
+  ! 15832 B static with the P0 pad -> 9 blocks/SM (164 KB carveout, +1 KB/block
+  ! driver reserve). Unpadded this is 15112 B -> (15112+1024)*10 = 161360
+  ! <= 167936 -> 10 blocks/SM, theoretical occupancy 28.1% -> 31.25%, PROVIDED
+  ! registers stay <= 102/thread (96 at fc782d7a; if a future change pushes
+  ! past 102, -gpu=maxregcount on gpu_hydro.o restores the cap). The next
+  ! shmem lever (11 blocks needs <14246 B) is slimming the corner_x/y/z
+  ! family (-6048 B FP32) -- physics audit first.
   !
   ! Reference: hydro_integrator_kernel resident shared is 12384 B = 12.1 KB
   ! (subgrid_6x6x6cell_primitive 9504 + 6 interface arrays 2880); the hydro
-  ! build is textually untouched by all of the above (every change is inside
-  ! #ifdef MHD).
+  ! build shares the unpadded type and the lexicographic fill (both are
+  ! solver-agnostic wins); everything else is inside #ifdef MHD.
   ! NOTE: reducing threads/block does NOT shrink per-block shared memory (the
   ! subgrids are sized by nsubgrid, compile-time); raising nsubgrid past 1 will
   ! NOT fit (the corner family alone grows ~5.6x at nsubgrid=2) -- re-derive
   ! this budget before touching nsubgrid.
   ! ##########################################################################
 
+  ! =========================================================================
+  !> @brief
+  !> Byte-pack grid%refined into the SoA refined_bytes(1:8, 1:num_octs) map.
+  !> Launched by gpu_godunov before every hydro_integrator_kernel launch (the
+  !> map is re-derived each time, so it can never go stale against the many
+  !> grid%refined writers: refine, derefine, multigrid, load-balance
+  !> unmarshal). Covers the FULL grid array (main + cache regions) because
+  !> the integrator's nbor stencil may reference remote cached octs. One
+  !> thread per (cell, oct): reads are the unavoidable AoS gather, done ONCE
+  !> per oct per launch instead of once per referencing subgrid inside the
+  !> integrator; writes are fully coalesced bytes.
+  !>
+  !> @param[in] grid : The oct array (main + cache)
+  !> @param[out] refined_bytes : Byte-packed refinement map (8, num_octs)
+  !> @param[in] num_octs : Size of the grid array (NOT just the level range)
+  ! =========================================================================
+  attributes(global) subroutine pack_refined_kernel(grid, refined_bytes, num_octs)
+    type(oct), device :: grid(*)
+    logical(kind=1), device :: refined_bytes(1:twotondim,*)
+    integer(kind=4), intent(in), value :: num_octs
+    integer :: idx, oct_idx, cell_idx
+
+    idx = (blockIdx%x - 1)*blockDim%x + threadIdx%x
+    if (idx > twotondim*num_octs) return
+    oct_idx  = (idx - 1)/twotondim + 1
+    cell_idx = idx - (oct_idx - 1)*twotondim
+    refined_bytes(cell_idx, oct_idx) = grid(oct_idx)%refined(cell_idx)
+  end subroutine pack_refined_kernel
+  ! =========================================================================
+
 #ifndef PAPER
   attributes(global) subroutine hydro_integrator_kernel(grid, uold, unew, bold, bnew, &
-       & f, father, nbor, &
+       & f, father, nbor, refined_bytes, &
        & head_idx, num_subgrids, ngridmax, ilevel, levelmin, levelmax, &
        & gamma, smallr, smallc, dt, dx, slope, slope_mag, riemann, riemann2d, &
        & switch_llf_dmin, switch_llf_pmin, induction, constant_gravity)
     type(oct), device :: grid(*)
     integer, device :: father(*)
     integer, device :: nbor(1:subgridsize,*)
+    logical(kind=1), device :: refined_bytes(1:twotondim,*)
     real(kind=8), device :: constant_gravity(1:3)
     real(kind=dp), device :: f(1:twotondim,1:ndim,*)
     real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
@@ -3786,7 +3842,7 @@ contains
     ! =======================================================================
     ! Convert from conserved to primitive variables
     ! =======================================================================
-    call subgrid_conserved_2_primitive(grid, uold, bold, f, constant_gravity, nbor, &
+    call subgrid_conserved_2_primitive(refined_bytes, uold, bold, f, constant_gravity, nbor, &
 #if NVAR>5+NENER
          & scalar_subgrid, &
 #endif
diff --git a/gpu/gpu_runner.cuf b/gpu/gpu_runner.cuf
index 1af2e62e..5db0333e 100644
--- a/gpu/gpu_runner.cuf
+++ b/gpu/gpu_runner.cuf
@@ -22,6 +22,13 @@ module gpu_runner
   integer(kind=4), device, allocatable, dimension(:) :: father
   integer(kind=4), device, allocatable, dimension(:,:) :: nbor
   integer(kind=4), device, allocatable, dimension(:,:) :: flag1, flag2
+  !> Byte-packed SoA mirror of grid%refined (8 B/oct, <1% of the per-oct
+  !> device footprint), consumed by the hydro/MHD integrator instead of the
+  !> 4-byte logicals inside the type(oct) AoS (NCU: that gather was the
+  !> largest single source of excessive global sectors). Allocated lazily and
+  !> RE-PACKED by pack_refined_kernel at every gpu_godunov call, so it never
+  !> goes stale against the grid%refined writers (refine/mg/load balance).
+  logical(kind=1), device, allocatable, dimension(:,:) :: refined_bytes
 
   !> Arrays to hold the hydro variables on the device
   real(kind=dp), device, allocatable, dimension(:,:,:) :: uold, unew
@@ -322,7 +329,7 @@ contains
 #ifdef PAPER
     use hydro_device, only: hydro_integrator_paper_kernel
 #else
-    use hydro_device, only: hydro_integrator_kernel
+    use hydro_device, only: hydro_integrator_kernel, pack_refined_kernel
 #endif
     use ramses_commons, only: ramses_t
     type(ramses_t), intent(inout)::sim
@@ -330,6 +337,7 @@ contains
     !
     integer(kind=4) :: head_idx, num_subgrids
     integer :: threads_per_block, num_blocks
+    integer :: size_grid, num_pack_threads, num_pack_blocks
     real(dp) :: dt, dx, gamma, smallr, smallc, switch_llf_dmin, switch_llf_pmin
     integer :: slope, riemann, slope_mag, riemann2d
     logical :: induction
@@ -371,13 +379,27 @@ contains
 #else
     if(nsubgrid == 1)threads_per_block = 64
     if(nsubgrid == 2)threads_per_block = 256
+       ! Re-derive the byte-packed refinement map consumed by the integrator
+       ! (see refined_bytes at module scope). Full grid array (main + cache
+       ! regions) every call: nbor may reference remote cached octs, and
+       ! re-packing is what keeps the map trivially in sync. The sweep is
+       ! bandwidth-trivial next to the integrator itself.
+       size_grid = size(grid)
+       if (allocated(refined_bytes)) then
+          if (size(refined_bytes, 2) /= size_grid) deallocate(refined_bytes)
+       endif
+       if (.not. allocated(refined_bytes)) allocate(refined_bytes(twotondim, size_grid))
+       num_pack_threads = 256
+       num_pack_blocks = (twotondim*size_grid + num_pack_threads - 1) / num_pack_threads
+       call pack_refined_kernel<<<num_pack_blocks, num_pack_threads>>>(grid, refined_bytes, size_grid)
+       call GPU_Error_Check(__FILE__, __LINE__)
        ! One launch for hydro and MHD: bold/bnew and the MHD runtime parameters
        ! are passed unconditionally (unallocated/unused without MHD). Under MHD
        ! the integrator's whole working set (corner states included) lives in
        ! kernel shared memory -- no per-level scratch to allocate (B1 budget
        ! block in gpu_hydro.cuf).
        call hydro_integrator_kernel<<<num_blocks, threads_per_block>>>(grid, uold, unew, bold, bnew, &
-            & f, father, nbor, &
+            & f, father, nbor, refined_bytes, &
             & head_idx, num_subgrids, sim%m%ngridmax, ilevel, sim%r%levelmin, sim%r%nlevelmax, &
             & gamma, smallr, smallc, dt, dx, slope, slope_mag, riemann, riemann2d, &
             & switch_llf_dmin, switch_llf_pmin, induction, constant_gravity)
diff --git a/gpu/gpu_utils.cuf b/gpu/gpu_utils.cuf
index a9d857ae..9502eee8 100644
--- a/gpu/gpu_utils.cuf
+++ b/gpu/gpu_utils.cuf
@@ -29,15 +29,17 @@ module gpu_utils
   !> zero_fine_emf read nothing outside it) -- both are shared-memory
   !> occupancy savings for the MHD integrator kernel.
   type, public :: subgrid_6x6x6cell_primitive
-     ! P0 bank-conflict fix: leading (stride-1) dimension padded +1 (6->7 at
-     ! nsubgrid=1). gcd(7,32)=1 makes the j/k strides span all 32 shared banks,
-     ! and the 252-real per-field slab stride no longer aliases density..pressure
-     ! (was 216 == 0 mod 32). Index slot i=2*nsubgrid+4 is padding, never read.
-     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: density
-     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_x
-     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_y
-     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_z
-     real(kind=dp), dimension(0:2*nsubgrid+4, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: pressure
+     ! UNPADDED on purpose (P0 leading-dim 6->7 pad reverted: measured as a
+     ! no-op on job 2823239). The fill loop in subgrid_conserved_2_primitive
+     ! walks the lattice lexicographically (i fastest), so with a stride-6 row
+     ! the linear shared offset i + 6j + 36k equals the loop's work_idx and a
+     ! warp's stores land on 32 consecutive addresses: coalesced and bank-
+     ! conflict-free. Re-padding the leading dimension would break that.
+     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: density
+     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_x
+     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_y
+     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: velocity_z
+     real(kind=dp), dimension(0:2*nsubgrid+3, 0:2*nsubgrid+3, 0:2*nsubgrid+3) :: pressure
 #ifdef MHD
      logical(kind=1), dimension(1:2*nsubgrid+2, 1:2*nsubgrid+2, 1:2*nsubgrid+2) :: refined
 #else
-- 
2.50.1 (Apple Git-155)

