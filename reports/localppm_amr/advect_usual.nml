&RUN_PARAMS
hydro=.true.
pic=.false.
poisson=.false.
static_mesh=.true.
ncontrol=10000
nstepmax=100
verbose=.false.
/
&AMR_PARAMS
levelmin=5
levelmax=6
ngridmax=12000
nexpand=1
boxlen=1.0
/
&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=0.5,0.38
length_x=1.0,0.22
d_region=1.0,2.0
u_region=0.55,0.55
p_region=1.0,1.0
/
&OUTPUT_PARAMS
foutput=0
tout=10.0
/
&HYDRO_PARAMS
gamma=1.4
courant_factor=0.65
slope_type=2
riemann='hllc'
/
&REFINE_PARAMS
err_grad_d=0.04
interpol_type=1
/
