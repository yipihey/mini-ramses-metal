&RUN_PARAMS
hydro=.true.
pic=.false.
poisson=.false.
static_mesh=.true.
ncontrol=10000
nstepmax=40
verbose=.false.
/
&AMR_PARAMS
levelmin=4
levelmax=6
ngridmax=80000
nexpand=1
boxlen=1.0
/
&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='point'
x_center=0.5,0.5
y_center=0.5,0.5
length_x=10.0,1.0
length_y=10.0,1.0
exp_region=10.0,10.0
d_region=1.0,0.0
u_region=0.0,0.0
v_region=0.0,0.0
p_region=1e-5,0.20
/
&OUTPUT_PARAMS
foutput=0
tout=10.0
/
&HYDRO_PARAMS
gamma=1.4
courant_factor=0.60
slope_type=10
riemann='twoshock'
/
&REFINE_PARAMS
err_grad_p=0.08
interpol_var=0
interpol_type=1
/
