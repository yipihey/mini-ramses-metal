&RUN_PARAMS
hydro=.true.
pic=.false.
poisson=.false.
static_mesh=.true.
ncontrol=10000
nstepmax=3000
nsubcycle(6)=2
verbose=.false.
/
&AMR_PARAMS
levelmin=6
levelmax=7
ngridmax=2000
nexpand=1
boxlen=1.0
/
&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center(1)=0.5
length_x(1)=1.0
d_region(1)=1.0
u_region(1)=1.0
p_region(1)=0.7142857142857143
/
&OUTPUT_PARAMS
foutput=0
tout=10.0
/
&HYDRO_PARAMS
gamma=1.4
courant_factor=0.3
slope_type=2
riemann='hllc'
/
&REFINE_PARAMS
err_grad_d=0.04
interpol_type=1
/
