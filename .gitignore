# ignore everything in bin except "official" Makefiles
bin/*
!bin/Makefile

# ignore utils executables
utils/f90/*
!utils/f90/*.f90
*.mod

# ignore python cache files
utils/py/*
!utils/py/*.py
*__pycache__*

# ignore editor settings
.vscode

# Mac stuff
.DS_Store

# Ignore outputs for now
output_[0-9][0-9][0-9][0-9][0-9]/
*.log
*.out
CLAUDE.md

# Metal/extra build dirs (parallel to bin/, build outputs only)
bin1d*/
bin_mpi*/
bin32*/
bin64*/
bin_cpu*/
bin_ppm*/
bin_verify*/

# run directories (ICs + large simulation outputs/data)
runs/

# local agent/session files + python env lock
.claude/
uv.lock
bin2*/
